{"version":1,"track_id":155,"audio_sha256":"2a1f5d745dfb1f382b6accea84c6a0534b4ddcd4761af42964603bbf9bc63867","duration":13.7,"language":"russian","status":"ready","lines":[{"start":0,"end":4.1,"text":"Ребята, Новый Гаур, а я на аттракционах в"},{"start":4.44,"end":5.44,"text":"Санкт-Петербурге. А я с поди-шка."},{"start":7.48,"end":8.6,"text":"У него, походу, все трогает."},{"start":8.88,"end":10.88,"text":"Ну все, ребят, пожелайте мне удачи."},{"start":11.12,"end":11.64,"text":"Я вам сниму..."},{"start":11.64,"end":12.5,"text":"По билету доставай, дура."}],"verification":{"independent_review":false,"word_agreement":0.935,"needs_chunk_review":false}}
