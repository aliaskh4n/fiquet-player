{"version":2,"track_id":1012,"audio_sha256":"57545b6230d1ac8e05545fd86979fde0a4ee27d9b887a1d20c42845037b13df5","duration":51.08,"origin":"original_lyrics","status":"ready","lines":[{"start":7.92,"end":11.12,"text":"Может погуляем ночью? Хочешь, сделай мне конспект","source_line":1},{"start":11.54,"end":14.28,"text":"Утром в университет, поступила на бюджет","source_line":2},{"start":30.0,"end":32.76,"text":"Милый, если бы ты знал, какой у меня факультет","source_line":7},{"start":34.86,"end":38.74,"text":"В голове лишь карьерный план, план, план","source_line":32},{"start":38.94,"end":42.32,"text":"Не гуляю, хожу только в зал, в зал, в зал","source_line":33},{"start":42.62,"end":45.98,"text":"Не знакомлюсь, прости, реферат не сдам","source_line":34},{"start":46.08,"end":50.28,"text":"Мой экзамен на чувствах - ты","source_line":35}],"verification":{"source_text_checked":true,"word_agreement":0.921,"matched_words":35,"timing":"cached_word_anchors"},"song":"Конспект","artist":"SCIRENA","source_url":"https://lrclib.net/api/get/10977661","source_sha256":"32268c0b053c12950ff559a3bcd0222d5ed0b250d80d48b2d6a8e17316da0fee"}
