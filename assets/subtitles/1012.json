{"version":3,"track_id":1012,"audio_sha256":"57545b6230d1ac8e05545fd86979fde0a4ee27d9b887a1d20c42845037b13df5","duration":51.08,"origin":"original_lyrics","status":"ready","lines":[{"start":0.02,"end":7.56,"text":"Написал вчера в директ, огонёк, типа респект","source_line":0},{"start":7.56,"end":11.21,"text":"Может погуляем ночью? Хочешь, сделай мне конспект","source_line":1},{"start":11.24,"end":29.63,"text":"Утром в университет, поступила на бюджет","source_line":2},{"start":29.92,"end":33.89,"text":"Милый, если бы ты знал, какой у меня факультет","source_line":7},{"start":33.89,"end":38.54,"text":"В голове лишь карьерный план, план, план","source_line":8},{"start":38.54,"end":42.24,"text":"Не гуляю, хожу только в зал, в зал, в зал","source_line":9},{"start":42.24,"end":46.03,"text":"Не знакомлюсь, прости, реферат не сдам","source_line":10},{"start":46.03,"end":50.28000020980835,"text":"Мой экзамен на чувствах - ты","source_line":11}],"verification":{"source_text_checked":true,"word_agreement":0.921,"matched_words":35,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.581},"song":"Конспект","artist":"SCIRENA","source_url":"https://lrclib.net/api/get/10977661","source_sha256":"32268c0b053c12950ff559a3bcd0222d5ed0b250d80d48b2d6a8e17316da0fee"}
