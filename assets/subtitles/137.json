{"version":1,"track_id":137,"audio_sha256":"b279151776a24780b6223b5cbbd0ffc47dcb93db2d4e0c08e301737182481cf0","duration":47.02,"language":"russian","status":"ready","lines":[{"start":0,"end":0.48,"text":"Ребята,"},{"start":1.66,"end":1.86,"text":"в общем,"},{"start":2.54,"end":5.12,"text":"вот две девочки сзади, может быть вы не"},{"start":5.12,"end":6.64,"text":"видели, и две такая грустная."},{"start":6.86,"end":8.0,"text":"Сейчас я покажу, как я выгляжу."},{"start":19.96,"end":22.46,"text":"Типа вот так выгляжу, иду, думаю, вообще смысл"},{"start":22.46,"end":26.0,"text":"этого всего, слушаю пошлую молли, собираюсь там..."},{"start":26.0,"end":28.78,"text":"Да вообще ничего не собираюсь, по паническому настроению,"},{"start":28.82,"end":32.1,"text":"в общем, иду домой, и тут они подходят,"},{"start":32.92,"end":34.14,"text":"она мне что-то говорит."},{"start":34.18,"end":35.18,"text":"Я думаю, что она?"},{"start":35.64,"end":36.3,"text":"Что она говорит?"},{"start":36.94,"end":40.2,"text":"Снимаю наушник, и они вдвоем такие, типа, Пауп,"},{"start":40.24,"end":41.34,"text":"ты такая gorgeous!"},{"start":41.42,"end":44.12,"text":"Я говорю, спасибо, спасибо, ты так мила!"},{"start":44.24,"end":45.8,"text":"Мне сказали, что я вообще шикарна."}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
