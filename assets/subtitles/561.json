{"version":1,"track_id":561,"audio_sha256":"a8f823f0ada44df49c6f636f15f6eb82fd5ba889ab6521212dad666d43d26bab","duration":20.35,"language":"russian","status":"ready","lines":[{"start":0,"end":1.72,"text":"Чтоб вы знали, мы потом..."},{"start":1.72,"end":3.08,"text":"Мы не досняли..."},{"start":3.08,"end":4.22,"text":"Что ты хочешь показать?"},{"start":5.14,"end":7.12,"text":"Ой, пока... Вот так вот получается."},{"start":7.2,"end":8.38,"text":"Дай мне, дай мне, дай мне."},{"start":8.8,"end":8.96,"text":"Дай мне сутку."},{"start":9.5,"end":10.98,"text":"И мы упали в куст."},{"start":11.38,"end":13.08,"text":"И там вмятины теперь от нас."},{"start":14.77,"end":16.52,"text":"Но мы не успели это снять, но мы"},{"start":16.52,"end":17.3,"text":"прям смачно упали."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
