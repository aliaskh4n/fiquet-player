{"version":1,"track_id":1021,"audio_sha256":"7a52cef7eb7247f60b8243b7050ad0746d7a1635a5a5783f148e001719531d37","duration":39.43,"language":"russian","status":"ready","lines":[{"start":3.36,"end":8.2,"text":"Отбилой глаз, спящая красавица, поцелуй меня, ведь мама"},{"start":10.2,"end":14.26,"text":"там далится. В памяти моей эта ночь останется"},{"start":15.02,"end":15.26,"text":"очень жестокий полсон."},{"start":18.7,"end":22.24,"text":"Ты буди, буди, буди, пока крутишь бегуди."},{"start":23.4,"end":26.92,"text":"На учебу к тебе идти, зачем себя я"},{"start":26.92,"end":31.58,"text":"заводил? Ты буди, буди, буди, пока крутишь бегуди."},{"start":32.56,"end":35.8,"text":"На учебу к тебе"},{"start":36.58,"end":37.32,"text":"идти, идти и тебя подойти."}],"verification":{"independent_review":true,"word_agreement":0.63,"review_model":"gpt-4o-transcribe","unanchored_words":20,"needs_chunk_review":false}}
