{"version":2,"track_id":1082,"audio_sha256":"07a90ad3a724789e67930ae54731a196c6304d7a9feb86fb34989650c7e139e8","duration":172.078,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.44,"text":"На стене в твоем подъезде","source_line":0},{"start":3.44,"end":6.12,"text":"Я пишу тебе письмо","source_line":1},{"start":11.72,"end":14.54,"text":"Ты обычная девчонка,","source_line":4},{"start":14.66,"end":17.36,"text":"Я не принц и не герой,","source_line":5},{"start":17.36,"end":20.5,"text":"Но я обещаю только,","source_line":6},{"start":20.64,"end":22.48,"text":"Что всегда буду с тобой.","source_line":7},{"start":30.44,"end":32.6,"text":"Она улыбается. Глупая ситуация.","source_line":11},{"start":32.72,"end":35.06,"text":"Откуда ты свалилась мне на голову?","source_line":12},{"start":35.06,"end":38.06,"text":"Она была, по ходу, явно не готова.","source_line":13},{"start":43.06,"end":46.16,"text":"На замерзших окнах","source_line":16},{"start":46.16,"end":48.56,"text":"Я рисую твой портрет,","source_line":17},{"start":49.98,"end":50.86,"text":"Засыпая без тебя","source_line":18},{"start":50.9,"end":53.72,"text":"Я на ночь оставляю свет","source_line":19},{"start":53.72,"end":56.56,"text":"Карандашами в дневнике","source_line":20},{"start":56.56,"end":61.02,"text":"Прячу мысли о тебе...","source_line":21},{"start":64.72,"end":67.6,"text":"На стене в твоем подъезде","source_line":26},{"start":67.6,"end":70.22,"text":"Я пишу тебе письмо","source_line":27},{"start":75.98,"end":78.58,"text":"Ты обычная девчонка,","source_line":30},{"start":78.84,"end":81.34,"text":"Я не принц и не герой,","source_line":31},{"start":81.34,"end":84.48,"text":"Но я обещаю только,","source_line":32},{"start":84.7,"end":86.9,"text":"Что всегда буду с тобой.","source_line":33},{"start":105.14,"end":107.6,"text":"Я всегда буду с тобой!","source_line":34},{"start":107.6,"end":109.94,"text":"Она верит новостям на Первом канале","source_line":35},{"start":117.5,"end":120.14,"text":