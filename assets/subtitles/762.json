{"version":1,"track_id":762,"audio_sha256":"0ebbf46283b88921b3dc3d8c6f86ec1911117ce9c048348536079eb9e18a4575","duration":58.94,"language":"russian","status":"ready","lines":[{"start":0,"end":0.94,"text":"Так, всем привет!"},{"start":1.1,"end":2.52,"text":"Я думаю, немножко разбавить контент."},{"start":2.66,"end":4.12,"text":"Ну хотя, блин, по сути, он и так"},{"start":4.12,"end":6.26,"text":"максимально разбавлен, то есть изначально этот канал был"},{"start":6.26,"end":6.88,"text":"для разборов."},{"start":8.0,"end":11.1,"text":"Но по-моему, так интереснее немножко вам, наверное, то,"},{"start":11.1,"end":12.18,"text":"что я своей жизнью делюсь."},{"start":12.96,"end":15.1,"text":"В общем, сегодня был особенный день — день"},{"start":15.1,"end":15.5,"text":"рождения."},{"start":16.28,"end":17.14,"text":"Мой. Мне 16."},{"start":17.34,"end":18.16,"text":"Мне теперь 16."},{"start":19.22,"end":22.1,"text":"Вот. И он начался хорошо, а закончился тем,"},{"start":22.28,"end":24.66,"text":"что мы сидели в кафе, пока там была"},{"start":24.66,"end":25.14,"text":"полиция."},{"start":26.16,"end":27.94,"text":"В общем, расскажу так, без спойлеров."},{"start":27.94,"end":29.96,"text":"День начался хорошо, очень сильно."},{"start":31.3,"end":32.94,"text":"Я пришла в школу, меня поздравили."},{"start":33.02,"end":34.98,"text":"Меня поздравили также подписчики, которых я вообще не"},{"start":34.98,"end":37.64,"text":"ожидала. Люди, которых я вообще не знаю толком"},{"start":37.64,"end":38.44,"text":"из моей школы."},{"start":38.78,"end":41.24,"text":"И мне подарили подарки, тортики."},{"start":41.26,"end":42.2,"text":"Я вообще этого не ожидала."},{"start":43.22,"end":46.04,"text":"Второе то, что было — это я пришла"},{"start":46.04,"end":48.1,"text":"на ланч сегодня, ну на обед."},{"start":48.76,"end":50.76,"text":"И девочки, оказывается, там были с хлопушками."},{"start":50.96,"end":52.16,"text":"Я сажусь, и они такие «пру-ру»."},{"start":52.86,"end":54.3,"text":"Я пугаюсь этих звуков хлопушек."},{"start":54.36,"end":57.2,"text":"Они начинают петь, и вся столовая тоже начинает"},{"start":57.2,"end":58.5,"text":"петь. Все абсолютно."}],"verification":{"independent_review":false,"word_agreement":0.975,"needs_chunk_review":false}}
