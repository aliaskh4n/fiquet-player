{"version":1,"track_id":589,"audio_sha256":"e43dc4a6e86d2d16026b8cf0ebb98e92a353b886ba1894c2822e8e1987c9f5b1","duration":23.0,"language":"russian","status":"ready","lines":[{"start":0,"end":1.88,"text":"Всем привет. Все уже видели мою туту?"},{"start":2.26,"end":3.18,"text":"Если нет, то вот."},{"start":3.72,"end":6.42,"text":"Я бантуюсь. Кстати, подожди, подожди."},{"start":6.42,"end":6.98,"text":"Покажи мой отвит."},{"start":8.36,"end":9.24,"text":"Дайте все глазчаточки."},{"start":13.68,"end":14.08,"text":"Подождите."},{"start":15.76,"end":17.08,"text":"Сфоткай меня. Ну не, ну не вот так,"},{"start":17.38,"end":18.66,"text":"ладно. Вот, короче, мой отвит."},{"start":21.46,"end":21.86,"text":"Всё."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
