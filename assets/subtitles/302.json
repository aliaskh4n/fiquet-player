{"version":1,"track_id":302,"audio_sha256":"7d0d166c4527ac17d740d389450a3ef5cb77055f275fbb776f3b398aa7241b5f","duration":17.55,"language":"russian","status":"ready","lines":[{"start":0,"end":2.02,"text":"Ребята, короче, я не могу уехать домой, хэппи-бёзды."},{"start":4.38,"end":7.2,"text":"Станция, на которую я хотела приехать, она загорелась."},{"start":7.7,"end":8.52,"text":"Сейчас мы вообще где-то..."},{"start":9.9,"end":10.16,"text":"какой-то терминал."},{"start":11.1,"end":13.72,"text":"Все летят куда-то тут во Францию, а у"},{"start":13.72,"end":15.24,"text":"меня билет домой."},{"start":16.12,"end":17.4,"text":"Вот, и закручалась."}],"verification":{"independent_review":false,"word_agreement":0.889,"needs_chunk_review":false}}
