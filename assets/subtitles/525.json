{"version":3,"track_id":525,"audio_sha256":"d6b1f1752d9da90b39b7094eec63062c937d8d7360849d4b47f8acab5e05a4e5","duration":84.3,"origin":"original_lyrics","status":"ready","lines":[{"start":8.08,"end":12.26,"text":"А ты вернула все подарки, отписалась в Inst'е","source_line":17},{"start":12.26,"end":15.93,"text":"В общем, сделала всю ту хуйню, что делают все","source_line":18},{"start":16.32,"end":19.74,"text":"И я оставлю тебе травмы, когда брошу тебя","source_line":19},{"start":19.74,"end":24.03,"text":"Ведь ты же так искала парня, что похож на отца","source_line":20},{"start":24.38,"end":27.93,"text":"И когда будешь ныть подругам то, что я уебан","source_line":21},{"start":28.4,"end":32.18,"text":"Попроси, чтоб они все мне перестали писать","source_line":22},{"start":32.18,"end":36.07,"text":"Я с детства знал, что все девчонки любят плохих парней","source_line":23},{"start":36.34,"end":40.15,"text":"Но, детка, я не плохой парень, я плохой человек","source_line":24},{"start":47.72,"end":51.78,"text":"Последняя любовь, пепел на простынях","source_line":28},{"start":51.78,"end":55.73,"text":"Бери все мои вещи, выкидывай из окна","source_line":29},{"start":55.84,"end":59.68,"text":"Последняя любовь, плачешь, а мне плевать","source_line":30},{"start":59.68,"end":64.01,"text":"Ты больше не поверишь никому и никогда","source_line":31},{"start":64.14,"end":68.28,"text":"Последняя любовь, пепел на простынях","source_line":28},{"start":68.28,"end":72.27,"text":"Бери все мои вещи, выкидывай из окна","source_line":29},{"start":72.38,"end":76.17,"text":"Последняя любовь, плачешь, а мне плевать","source_line":30},{"start":76.17,"end":80.49,"text":"Ты больше не поверишь никому и никогда","source_line":31}],"verification":{"source_text_checked":true,"word_agreement":0.895,"matched_words":68,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.296},"song":"Последняя Любовь","artist":"MORGENSHTERN, Robin Schulz","source_url":"https://lrclib.net/api/get/36474247","source_sha256":"0a4af40a5db77bf696aaf22de21db5d326af67c83724c72ddb438e20326296de"}
