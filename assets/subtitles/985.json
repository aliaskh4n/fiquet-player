{"version":1,"track_id":985,"audio_sha256":"3003a92ae1e114553956b9589b06557b37fa068e643ce019e710f981ba6f30ef","duration":48.82,"language":"russian","status":"ready","lines":[{"start":1.82,"end":4.04,"text":"Есть такая. Мне она тоже нравится."},{"start":5.18,"end":6.64,"text":"Есть дракона вот такая."},{"start":6.84,"end":8.14,"text":"Это моя прошлая."},{"start":8.62,"end":10.32,"text":"Ошалеть. Я забыла, что я новую заказала."},{"start":10.44,"end":11.52,"text":"Новый завоз, новый завоз."},{"start":11.74,"end":13.12,"text":"Мне очень нравится, как они выглядят."},{"start":13.36,"end":14.64,"text":"Вот такая есть ещё."},{"start":17.24,"end":18.22,"text":"Потом вот такая вот."},{"start":18.22,"end":19.06,"text":"Это как самурай."},{"start":19.42,"end":20.1,"text":"Типа, уф."},{"start":21.46,"end":22.42,"text":"И вот эти две."},{"start":25.5,"end":29.16,"text":"В общем, вот поэтому ожидайте, как только я"},{"start":29.16,"end":31.36,"text":"это отодру. Скорее всего, у нас сейчас каникулы,"},{"start":31.5,"end":35.36,"text":"и в конце этой недели я решусь приукраситься"},{"start":35.36,"end":38.18,"text":"в школу. И поэтому набью себе..."},{"start":38.18,"end":43.02,"text":"Я набью себе дату, тебе набью лицо."},{"start":43.94,"end":45.16,"text":"Окей, ладно, вот."},{"start":45.84,"end":47.12,"text":"У меня будет, скорее всего, где-то здесь, либо"},{"start":47.12,"end":47.38,"text":"здесь."}],"verification":{"independent_review":false,"word_agreement":0.99,"needs_chunk_review":false}}
