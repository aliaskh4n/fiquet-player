{"version":3,"track_id":1035,"audio_sha256":"6dbf266f5a7a178c264345f4ea17a8ecebe9f44dabba9dfcdc56154bf962e94d","duration":46.26,"origin":"original_lyrics","status":"ready","lines":[{"start":3.1,"end":6.11,"text":"А я тихонечко курю","source_line":1},{"start":6.18,"end":7.58,"text":"На остановке","source_line":2},{"start":7.58,"end":10.49,"text":"Поджидая автобус","source_line":3},{"start":10.72,"end":13.1,"text":"Ты шутишь что-то про ментов","source_line":4},{"start":13.1,"end":15.43,"text":"Про безответную любовь","source_line":5},{"start":15.48,"end":19.77,"text":"Боюсь, тебе твой юмор не поможет","source_line":6},{"start":20.0,"end":22.32,"text":"Ну, предложи аперитив","source_line":7},{"start":22.32,"end":24.63,"text":"Давай подольше посидим","source_line":8},{"start":24.66,"end":28.73,"text":"Расскажешь мне про худшие свидания","source_line":9},{"start":29.34,"end":30.67,"text":"А время близиться к нулю","source_line":10},{"start":30.67,"end":33.89,"text":"И почему я так смеюсь?","source_line":11},{"start":33.92,"end":38.07,"text":"Как ты сумел привлечь моё внимание?","source_line":12},{"start":38.26,"end":41.67,"text":"Мальчик, грёбаный обманщик","source_line":13},{"start":41.72,"end":45.08000183105469,"text":"Вечно что-то прячет от меня","source_line":14}],"verification":{"source_text_checked":true,"word_agreement":0.8,"matched_words":16,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.526},"song":"мальчик","artist":"кис-кис","source_url":"https://lrclib.net/api/get/33453209","source_sha256":"0ac3c99f9746e9e211ed649aa82c326af573693ab6a827d62448404d45141c8a"}
