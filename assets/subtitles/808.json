{"version":1,"track_id":808,"audio_sha256":"e6a8f234e56dc289de503147b4a22f21c5d27e14e9460497a49adfc78b53836f","duration":57.96,"language":"russian","status":"ready","lines":[{"start":0,"end":1.62,"text":"Ребята, я сейчас расплачусь."},{"start":1.62,"end":3.34,"text":"В общем, я писала песню."},{"start":3.92,"end":5.46,"text":"Давайте сразу, вы ее прослушаете."},{"start":6.52,"end":6.84,"text":"Да?"},{"start":10.44,"end":12.12,"text":"Окей, это начальная версия."},{"start":12.98,"end":14.68,"text":"Я просто так брынька на гитаре."},{"start":15.52,"end":19.78,"text":"Ты проколешь перстень, коль я сделаю себе тату."},{"start":20.18,"end":21.26,"text":"Ты студент, а я ученица, ты в школе,"},{"start":23.2,"end":23.36,"text":"я в аглу."},{"start":24.22,"end":28.0,"text":"И пока ты считаешь обманную историю, ночью зубришь,"},{"start":28.52,"end":30.72,"text":"я играю на спущенных струнах."},{"start":31.3,"end":32.58,"text":"Кричи со ночи, а ты уже спишь."},{"start":33.1,"end":36.52,"text":"Как же мама меня держит, думая, что ты"},{"start":36.52,"end":40.36,"text":"обидишь. Не путевый на бокал стук, я кричу,"},{"start":40.8,"end":41.68,"text":"ты все тише."},{"start":41.82,"end":45.96,"text":"Руки холоднее взгляда, я боюсь тебя бросать."},{"start":46.44,"end":49.42,"text":"Мне 15, тебе 20, нам будет 35."},{"start":54.96,"end":57.32,"text":"Короче, сейчас запишу, почему я хочу плакать."}],"verification":{"independent_review":true,"word_agreement":0.788,"review_model":"gpt-4o-transcribe","unanchored_words":22,"needs_chunk_review":false}}
