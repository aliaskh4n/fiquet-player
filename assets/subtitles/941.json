{"version":2,"track_id":941,"audio_sha256":"df9f9b72a1383bee8af3165e7c42f6d7ab197e1add936c8631ef78dfb46ec6d8","duration":27.52,"origin":"original_lyrics","status":"ready","lines":[{"start":6.04,"end":8.12,"text":"И губы сладкие, нежные.","source_line":1},{"start":8.68,"end":10.88,"text":"Не обращаешь на меня ты внимания,","source_line":2},{"start":11.4,"end":13.58,"text":"Твоё сердце другим уже занято.","source_line":24},{"start":13.94,"end":16.52,"text":"Ты с другим, но не унываю я,","source_line":25},{"start":16.76,"end":19.22,"text":"Всё равно скоро будешь ты моя.","source_line":26},{"start":19.22,"end":22.04,"text":"Я тебя украду, я тебя увезу,","source_line":27},{"start":22.04,"end":24.76,"text":"Я тебя у другого отниму.","source_line":28}],"verification":{"source_text_checked":true,"word_agreement":0.886,"matched_words":39,"timing":"cached_word_anchors"},"song":"Карие Глаза","artist":"Ника","source_url":"https://lrclib.net/api/get/35567234","source_sha256":"75b5565205474c22c18360d51e3a36645fc51dffc1fbb4069c3fe5b4701d9573"}
