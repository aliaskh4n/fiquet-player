{"version":1,"track_id":547,"audio_sha256":"884bce99329b6f3cd370a1646bb216f8836ccbf0bc4ef48fb796bf00ecc201dd","duration":37.5,"language":"russian","status":"ready","lines":[{"start":0,"end":1.56,"text":"Да, я снимаю моё лицо."},{"start":2.18,"end":4.16,"text":"Сейчас я вам покажу крутой перебор с самбурской."},{"start":7.74,"end":9.78,"text":"Что ж ты, фраер, встал назад?"},{"start":10.82,"end":13.14,"text":"Встал назад. Не помочь тебе."},{"start":13.92,"end":15.58,"text":"Ты смотри в мои глаза."},{"start":18.02,"end":19.58,"text":"Брось трепаться в судьбе."},{"start":20.6,"end":23.58,"text":"Теперь будешь. Ты с тобой мой мусорок."},{"start":24.54,"end":27.7,"text":"Мусорок. Я попутала усы."},{"start":27.7,"end":30.02,"text":"Ты взорвала узелок."},{"start":31.12,"end":33.54,"text":"Как тугие твои коса."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
