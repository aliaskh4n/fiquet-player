{"version":1,"track_id":447,"audio_sha256":"bb4d55cf6487320b4cc7890b57a4a25ffb73cdfd885a8d8cbd173ab51170e7f7","duration":39.91,"language":"russian","status":"ready","lines":[{"start":0,"end":2.92,"text":"Вот, вы посмотрите, два знаковых цвета."},{"start":3.06,"end":4.6,"text":"Сейчас я покажу кисточку здесь."},{"start":6.96,"end":8.32,"text":"Тебя ненавидим."},{"start":9.68,"end":10.36,"text":"Вот."},{"start":11.12,"end":12.48,"text":"Она не совсем удобная."},{"start":13.8,"end":15.3,"text":"Сейчас покажу другую кисточку от KIKO."},{"start":16.48,"end":17.86,"text":"Это не реклама, мне не платили."},{"start":25.16,"end":27.02,"text":"Вот такая должна быть кисточка."},{"start":27.02,"end":30.78,"text":"Вот эта вот более круглая, если видите."},{"start":30.78,"end":32.38,"text":"Вот ей прям удобно."},{"start":32.38,"end":36.52,"text":"Всех целую, побежала на репетицию, камеру выставлю вечерком."},{"start":37.92,"end":39.42,"text":"На акустике или на электро?"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
