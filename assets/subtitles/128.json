{"version":1,"track_id":128,"audio_sha256":"7078443b3b6e0278bbfe8bb3fa83075b3b33fcb163017fd79a64ec031e51ccba","duration":18.16,"language":"russian","status":"ready","lines":[{"start":0,"end":1.4,"text":"Что за бред?"},{"start":1.88,"end":5.1,"text":"Почему у меня на официальном айке в Пинтересте"},{"start":5.56,"end":6.94,"text":"какое-то говно? У меня там даже одного лайка"},{"start":6.94,"end":10.02,"text":"нет, а здесь кто-то взял мой видос, выставил"},{"start":10.02,"end":11.64,"text":"и у него 2к лайков."},{"start":11.86,"end":14.1,"text":"Что? Я не знала, что у меня в"},{"start":14.1,"end":15.08,"text":"Пинтересте вообще есть."},{"start":15.12,"end":16.74,"text":"Я думала, я там ноунейм, а там, оказывается,"},{"start":16.82,"end":17.98,"text":"у меня есть пару лайкусиков."}],"verification":{"independent_review":false,"word_agreement":0.964,"needs_chunk_review":false}}
