{"version":1,"track_id":361,"audio_sha256":"02eb3df4d7e5990972afba4f0b7c26d9a59a5b5d49ef4a2a00a09b94f2c6dd8d","duration":14.38,"language":"russian","status":"ready","lines":[{"start":0,"end":3.06,"text":"Котята мои, кто не спит, я прошу вас"},{"start":3.06,"end":5.14,"text":"глянуть, меня не было два дня."},{"start":5.78,"end":6.82,"text":"Блядь, у меня новый кавер."},{"start":7.66,"end":9.56,"text":"Очень много кто просил на эту песню кавер,"},{"start":9.7,"end":11.48,"text":"и я наконец-то записала, как вы просили."},{"start":11.74,"end":12.36,"text":"Всё для вас."}],"verification":{"independent_review":false,"word_agreement":0.973,"needs_chunk_review":false}}
