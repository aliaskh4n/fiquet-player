{"version":1,"track_id":929,"audio_sha256":"1e6258cbd9bdb38067f309fb0d28fdaaaf22b23b7f8e4e85c16760f649da4ed2","duration":21.76,"language":"russian","status":"ready","lines":[{"start":0,"end":3.2,"text":"А ещё баррэ намного удобнее и легче играть,"},{"start":3.4,"end":4.44,"text":"если кабы дастер стоит."},{"start":5.1,"end":7.5,"text":"Даже на, допустим, первом ладу это всё равно"},{"start":7.5,"end":9.3,"text":"сделает большой дифференс,"},{"start":10.14,"end":11.08,"text":"большую разницу даст."},{"start":11.74,"end":13.7,"text":"Вот поэтому, если вы только начинаете играть баррэ,"},{"start":13.78,"end":15.84,"text":"то ставьте капу на первый лад, второй лад,"},{"start":16.34,"end":19.56,"text":"лучше на высоких ладах, вот допустим на восьмой,"},{"start":20.06,"end":21.18,"text":"и будет вам счастье."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
