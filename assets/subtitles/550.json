{"version":1,"track_id":550,"audio_sha256":"dd9eef21902d06f8b3cc55fff4afe25407283610e9726420a3cd7b237cba0445","duration":18.6,"language":"russian","status":"ready","lines":[{"start":1.5,"end":3.3,"text":"Кто-нибудь мне объяснит, как..."},{"start":3.3,"end":5.76,"text":"Ну, вроде... Окей, у меня волнистые."},{"start":6.7,"end":6.94,"text":"Да?"},{"start":7.82,"end":9.42,"text":"Я не умею кудрявый метод."},{"start":9.84,"end":11.16,"text":"Я не умею, я пыталась сделать."},{"start":11.34,"end":12.66,"text":"Ну, передние прядки хорошо."},{"start":13.28,"end":15.44,"text":"Смотрите, что за..."},{"start":15.72,"end":17.58,"text":"У меня вечно дилеммы с волосами."}],"verification":{"independent_review":false,"word_agreement":0.971,"needs_chunk_review":false}}
