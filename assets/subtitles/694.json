{"version":1,"track_id":694,"audio_sha256":"51c52b739cfdaf54339a9318db110532d4de2da6ea4aeddbb5fbf9b8571c36ba","duration":50.4,"language":"russian","status":"ready","lines":[{"start":1.02,"end":3.92,"text":"Сегодня впервые за всю историю будет разборку ручки."},{"start":4.68,"end":7.16,"text":"Я не лохмата, и если что, так и"},{"start":7.16,"end":8.74,"text":"должно быть, это просто для объёма волос."},{"start":9.08,"end":12.0,"text":"Ну, в общем, это будет разбор на песню..."},{"start":16.58,"end":22.2,"text":"Это из, по-моему, приключения..."},{"start":22.2,"end":24.24,"text":"Adventure Time, Adventure Time."},{"start":24.92,"end":26.64,"text":"В общем, в общем, в общем."},{"start":27.74,"end":28.3,"text":"Зажимаем С."},{"start":31.74,"end":32.66,"text":"Затем Ф."},{"start":33.46,"end":34.5,"text":"Вот так вот, да."},{"start":36.1,"end":37.3,"text":"Затем убираем этот пальчик."},{"start":41.9,"end":43.6,"text":"Затем Ф опять."},{"start":48.7,"end":49.82,"text":"Вот весь разбор."}],"verification":{"independent_review":false,"word_agreement":0.984,"needs_chunk_review":false}}
