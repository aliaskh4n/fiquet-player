{"version":2,"track_id":497,"audio_sha256":"538e40b42e2bc0507fb8901f5c21a8d6af946f485a1d0c0ab66a62992fd6faf7","duration":51.47,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":5.92,"text":"Проснувшись утром, как бомж помятый","source_line":41},{"start":6.24,"end":11.44,"text":"А в телефоне: Привет, ну как ты?","source_line":42},{"start":16.84,"end":19.54,"text":"Звоню ребятам из группы - женюсь","source_line":44},{"start":19.54,"end":24.04,"text":"На официантке в моём любимом баре","source_line":45},{"start":24.04,"end":30.48,"text":"Наполовину полный стакан летит, я падаю за ним","source_line":46},{"start":30.56,"end":35.96,"text":"Ты держишь меня, спасибо. Снизу ты так красива","source_line":47},{"start":36.62,"end":42.02,"text":"Жалко немного даже, что ты на семь лет старше","source_line":48}],"verification":{"source_text_checked":true,"word_agreement":0.885,"matched_words":46,"timing":"cached_word_anchors"},"song":"Официантка","artist":"Папин Олимпос","source_url":"https://lrclib.net/api/get/31350836","source_sha256":"8263affa36fbef86018712c1adf39a9ad09948ea0c5fc5e7856db4f20ba2ca68"}
