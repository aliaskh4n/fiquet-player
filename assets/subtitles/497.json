{"version":1,"track_id":497,"audio_sha256":"538e40b42e2bc0507fb8901f5c21a8d6af946f485a1d0c0ab66a62992fd6faf7","duration":51.47,"language":"russian","status":"ready","lines":[{"start":0,"end":8.16,"text":"Проснувшись утром, как помню шпагаты, а в телефоне"},{"start":8.16,"end":11.44,"text":"привет, ну как ты?"},{"start":11.98,"end":14.32,"text":"Заволновался и участился бой."},{"start":16.84,"end":21.42,"text":"Звоню ребятам из группы, Женя на официантке."},{"start":21.42,"end":26.62,"text":"В моем любимом баре на полу обернул полный"},{"start":26.62,"end":31.84,"text":"стакан лица. Я падаю, за ним ты держишь"},{"start":31.84,"end":37.72,"text":"меня, спасибо. Снизу ты так красиво жалкая немного"},{"start":37.72,"end":42.02,"text":"даже, что ты на семь не старше."}],"verification":{"independent_review":true,"word_agreement":0.759,"review_model":"gpt-4o-transcribe","unanchored_words":13,"needs_chunk_review":false}}
