{"version":2,"track_id":1074,"audio_sha256":"ade85d5b19546b6d40ce430dae94bb567c2e7ac451eb1330c4abbc2998d8261d","duration":116.725,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":4.54,"text":"Тёмно-оранжевый закат на фоне потресканных домов","source_line":0},{"start":6.92,"end":13.62,"text":"Ты так хотела рассказать ему насколько тяжело","source_line":1},{"start":13.62,"end":20.7,"text":"Ты так хотела показать ему прокуренный балкон","source_line":2},{"start":24.78,"end":33.64,"text":"Не плачь, прошу, я тоже не вывожу","source_line":4},{"start":56.28,"end":63.22,"text":"Светло-голубой рассвет снова укладывает спать","source_line":6},{"start":64.24,"end":70.2,"text":"Ложиться смысла уже нет, он вынуждает закрывать","source_line":7},{"start":70.2,"end":77.42,"text":"Глаза, чтобы не видеть всё, что ты успела потерять","source_line":8},{"start":77.42,"end":84.62,"text":"Когда проснёшься, тебя ждёт темно-оранжевый закат","source_line":9},{"start":84.62,"end":91.08,"text":"Не плачь, прошу, я тоже не вывожу","source_line":10}],"verification":{"source_text_checked":true,"word_agreement":0.87,"matched_words":67,"timing":"cached_word_anchors"},"song":"Темно-оранжевый закат(Remix)","artist":"Папин Олимпос","source_url":"https://lrclib.net/api/get/34268405","source_sha256":"685cced37f5bebb1cefaafa36b73ad7ccc4f5998bf0b008ebbfb98eeb9f67f83"}
