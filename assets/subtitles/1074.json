{"version":3,"track_id":1074,"audio_sha256":"ade85d5b19546b6d40ce430dae94bb567c2e7ac451eb1330c4abbc2998d8261d","duration":116.725,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":6.87,"text":"Тёмно-оранжевый закат на фоне потресканных домов","source_line":0},{"start":6.87,"end":13.57,"text":"Ты так хотела рассказать ему насколько тяжело","source_line":1},{"start":13.57,"end":20.65,"text":"Ты так хотела показать ему прокуренный балкон","source_line":2},{"start":20.65,"end":28.03,"text":"У тебя слёзы на глазах, у него – целый горизонт","source_line":3},{"start":28.14,"end":35.119998931884766,"text":"Не плачь, прошу, я тоже не вывожу","source_line":4},{"start":35.34,"end":44.07,"text":"Держись, держу, у-у-у","source_line":5},{"start":44.82,"end":63.17,"text":"Светло-голубой рассвет снова укладывает спать","source_line":6},{"start":63.17,"end":70.14,"text":"Ложиться смысла уже нет, он вынуждает закрывать","source_line":7},{"start":70.14,"end":77.37,"text":"Глаза, чтобы не видеть всё, что ты успела потерять","source_line":8},{"start":77.37,"end":84.57,"text":"Когда проснёшься, тебя ждёт темно-оранжевый закат","source_line":9},{"start":84.57,"end":92.5999984741211,"text":"Не плачь, прошу, я тоже не вывожу","source_line":10},{"start":92.8,"end":108.37,"text":"Держись, держу, у-у-у","source_line":11}],"verification":{"source_text_checked":true,"word_agreement":0.87,"matched_words":67,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.346},"song":"Темно-оранжевый закат(Remix)","artist":"Папин Олимпос","source_url":"https://lrclib.net/api/get/34268405","source_sha256":"685cced37f5bebb1cefaafa36b73ad7ccc4f5998bf0b008ebbfb98eeb9f67f83"}
