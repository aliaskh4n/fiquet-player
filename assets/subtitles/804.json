{"version":2,"track_id":804,"audio_sha256":"2dfd73a4f5bbc651faf345406a0dad354128202db553e809d86ff2224b9f8257","duration":47.9,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":4.86,"text":"Ты слишком молод, чтобы звать меня гулять","source_line":0},{"start":4.86,"end":8.74,"text":"Тебе семнадцать, а ему все двадцать пять","source_line":1},{"start":8.74,"end":13.22,"text":"Он подарил магнитофон мне и цветы","source_line":2},{"start":13.48,"end":15.68,"text":"А ты?","source_line":3},{"start":19.66,"end":23.82,"text":"Ты едешь в свою школу на автобусе","source_line":5},{"start":23.82,"end":27.92,"text":"Все знают, что он криминальный элемент","source_line":6},{"start":27.92,"end":29.68,"text":"О нет","source_line":7},{"start":30.82,"end":34.62,"text":"А мой мальчик едет на девятке","source_line":8},{"start":34.62,"end":38.14,"text":"По автостраде вдоль ночных дорог","source_line":9},{"start":38.48,"end":42.54,"text":"Я кружилась с ним на танцплощадке","source_line":10},{"start":42.54,"end":45.08,"text":"А ты и дальше будешь одинок","source_line":11}],"verification":{"source_text_checked":true,"word_agreement":0.919,"matched_words":57,"timing":"cached_word_anchors"},"song":"Мальчик на девятке","artist":"DEAD BLONDE","source_url":"https://lrclib.net/api/get/32278621","source_sha256":"20f2db93960f36bfcc8fb100e286f20c835eb095336cfb86c31d87404540d7cb"}
