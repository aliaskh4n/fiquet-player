{"version":1,"track_id":804,"audio_sha256":"2dfd73a4f5bbc651faf345406a0dad354128202db553e809d86ff2224b9f8257","duration":47.9,"language":"russian","status":"ready","lines":[{"start":0,"end":2.46,"text":"Ты с дежку мола, чтобы с восьми не"},{"start":3.84,"end":8.74,"text":"гулять, тебе семнадцать, а ему все двадцать пять."},{"start":8.74,"end":15.68,"text":"Он подарил магнитофон мне и цветы, а ты."},{"start":19.66,"end":20.72,"text":"Пока у нас сборка в лесополосе, ты едешь"},{"start":20.72,"end":23.82,"text":"в школу на своем автобусе."},{"start":23.82,"end":29.68,"text":"Все знают, что ты минарный элемент, о нет."},{"start":30.82,"end":36.72,"text":"А мой мальчик едет на девятке по автостраде"},{"start":36.72,"end":38.14,"text":"вдоль ночных дорог."},{"start":38.48,"end":43.44,"text":"Я кружилась с ним на танцплощадке, а ты"},{"start":43.44,"end":46.14,"text":"дальше будешь одинок."}],"verification":{"independent_review":true,"word_agreement":0.761,"review_model":"gpt-4o-transcribe","unanchored_words":16,"needs_chunk_review":false}}
