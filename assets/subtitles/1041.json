{"version":1,"track_id":1041,"audio_sha256":"cd24cbe56c568e5bd1762ed4984a5db38cec64ffe3c20552f79eee61b7443734","duration":56.01,"language":"russian","status":"ready","lines":[{"start":0,"end":2.48,"text":"Друзья, которые просили овзор на мою комнату, в"},{"start":2.48,"end":3.6,"text":"общем, это мои тапки,"},{"start":4.7,"end":7.74,"text":"тут у меня гантельки и так далее,"},{"start":8.8,"end":15.44,"text":"вот такая у меня комната, здесь красивые, как"},{"start":15.44,"end":18.42,"text":"слово называлось на русском, ну, в общем, вы"},{"start":18.42,"end":21.94,"text":"поняли, церкви, по-моему, вот они красивые тени делают,"},{"start":22.14,"end":22.94,"text":"тут моя кровать,"},{"start":24.36,"end":26.58,"text":"тут я арт-арт занимаюсь,"},{"start":27.44,"end":29.64,"text":"вот моя красивая электрогитара,"},{"start":31.42,"end":35.7,"text":"потом тут куча ненужных вещей, здесь тоже,"},{"start":37.12,"end":38.58,"text":"заходим сюда,"},{"start":40.04,"end":41.86,"text":"здесь у меня гардероб,"},{"start":42.96,"end":43.1,"text":"ну,"},{"start":43.94,"end":45.56,"text":"маленький гардероб,"},{"start":46.64,"end":48.02,"text":"потом выходим,"},{"start":50.36,"end":51.06,"text":"вот моя ванна,"},{"start":52.08,"end":53.04,"text":"тут душ еще,"},{"start":55.12,"end":55.7,"text":"вот так вот."}],"verification":{"independent_review":false,"word_agreement":0.975,"needs_chunk_review":false}}
