{"version":1,"track_id":443,"audio_sha256":"f53d5aa7faccadee438d0df888d2fa0106bfdc4f9034c4d5ad8800aa5cb8c33c","duration":48.46,"language":"russian","status":"ready","lines":[{"start":0,"end":1.32,"text":"Если что, это шуточная форма."},{"start":1.36,"end":2.34,"text":"Еще я аккорды не знаю."},{"start":5.24,"end":9.58,"text":"Моя девушка сказала, что я полное говно."},{"start":9.58,"end":13.14,"text":"И что если бы не жалость, то она"},{"start":13.14,"end":14.36,"text":"бы ушла давно."},{"start":14.36,"end":16.22,"text":"Я разбит, я расстроена."},{"start":17.46,"end":19.8,"text":"Но конечно же я отдам ей"},{"start":21.44,"end":23.32,"text":"за такие вот слова."},{"start":23.78,"end":26.64,"text":"Я кругу женщины детей."},{"start":26.92,"end":31.16,"text":"Потому что я красавчик, потому что я сильней."},{"start":31.38,"end":34.28,"text":"И они не могут знать, что дать мне"},{"start":35.36,"end":38.28,"text":"женщины детей. Где-то правильно я знаю, но без"},{"start":40.0,"end":42.16,"text":"женщины детей. И я сама утверждаюсь."},{"start":43.74,"end":45.18,"text":"Окей, все аккорды поплыли уже."},{"start":46.06,"end":47.96,"text":"Осуждаю такое, осуждаю такое, очень осуждаю."}],"verification":{"independent_review":true,"word_agreement":0.828,"review_model":"gpt-4o-transcribe","unanchored_words":15,"needs_chunk_review":false}}
