{"version":1,"track_id":805,"audio_sha256":"628b9f0f2679b570131587d83843781bb4a942b8925e7c204e93c42f2ddab3b4","duration":21.47,"language":"russian","status":"ready","lines":[{"start":0,"end":2.26,"text":"Вы хотели знать больше про мою жизнь, я"},{"start":2.26,"end":2.92,"text":"сейчас буду плакать."},{"start":2.98,"end":4.92,"text":"В общем, играла я на этой штуке, да?"},{"start":4.92,"end":7.18,"text":"Я отращиваю ногти, чтобы было красиво."},{"start":9.52,"end":10.54,"text":"Я сейчас буду плакать."},{"start":10.62,"end":12.78,"text":"В общем, он оторвался, поэтому долой ногти все"},{"start":12.78,"end":13.24,"text":"просто."},{"start":14.3,"end":15.08,"text":"Я сейчас буду плакать."},{"start":15.18,"end":17.44,"text":"Я их так долго отращиваю, они еще долго"},{"start":17.44,"end":20.46,"text":"растут. Я пыталась их аккуратно сделать."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
