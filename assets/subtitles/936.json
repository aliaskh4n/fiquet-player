{"version":1,"track_id":936,"audio_sha256":"9ef36c40d47bcbf0640b0b276f4cc37ac19a69bd017d92009a41e9e715de76a6","duration":58.6,"language":"russian","status":"ready","lines":[{"start":0,"end":1.66,"text":"Я украсила комнату."},{"start":3.42,"end":6.24,"text":"Вот такая вот атмосферка, появился уже Happy New"},{"start":6.24,"end":8.42,"text":"Year, поэтому я не знаю, зачем я у"},{"start":8.42,"end":10.3,"text":"вас пою дэнсинг, просто захотела."},{"start":10.82,"end":11.48,"text":"Просто могу."},{"start":16.16,"end":17.34,"text":"А, нет, не подпустила."},{"start":17.72,"end":18.46,"text":"Пока с вами поговорю."},{"start":18.58,"end":20.64,"text":"Я сделала вот такую атмосферу, поэтому все дальнейшие"},{"start":20.64,"end":22.3,"text":"каверы будут с такой атмосферой Нового года."},{"start":23.3,"end":23.9,"text":"Друзья, я с вами."},{"start":23.94,"end":24.72,"text":"Can't you see?"},{"start":25.0,"end":26.74,"text":"The only you are for me."},{"start":27.08,"end":31.24,"text":"Only one man to be."},{"start":31.52,"end":34.64,"text":"Dancing in the moonlight."},{"start":36.16,"end":38.46,"text":"Gazing at the stars so bright."},{"start":40.06,"end":43.32,"text":"I'm holding you until the sun rises."},{"start":43.8,"end":46.78,"text":"Sleeping until the midnight."},{"start":47.52,"end":49.46,"text":"Get up on the floor."},{"start":49.94,"end":51.5,"text":"We're dancing all night long."},{"start":52.28,"end":52.48,"text":"I'm not alone."}],"verification":{"independent_review":false,"word_agreement":0.96,"needs_chunk_review":false}}
