{"version":1,"track_id":384,"audio_sha256":"ec1fce16f232bccb29e0a15f5221d9c053626c2a040f8f726bbb1ef62d6407ec","duration":29.53,"language":"russian","status":"ready","lines":[{"start":0,"end":1.54,"text":"Ребята, у меня хорошая новость."},{"start":1.64,"end":2.62,"text":"У меня есть плохая хорошая новость."},{"start":4.24,"end":4.74,"text":"Во-первых, я дома."},{"start":8.82,"end":10.7,"text":"Ну, было не совсем приятно, наверное, слышать."},{"start":11.74,"end":13.74,"text":"Во-вторых, прикиньте, я забыла свою оригинальную зарядку от"},{"start":13.74,"end":13.84,"text":"Эппу."},{"start":17.88,"end":19.48,"text":"Ещё выставила кавер на песню."},{"start":20.12,"end":21.68,"text":"Никто ещё не делал на эту песню кавер,"},{"start":21.72,"end":23.5,"text":"и она ещё не вышла, но это прекрасная"},{"start":23.5,"end":25.14,"text":"песня, и мне безумно нравится."},{"start":25.24,"end":27.2,"text":"Я считаю, что это Белялиш только в русском"},{"start":27.2,"end":27.7,"text":"воплощении."},{"start":28.52,"end":28.96,"text":"Вот."}],"verification":{"independent_review":false,"word_agreement":0.97,"needs_chunk_review":false}}
