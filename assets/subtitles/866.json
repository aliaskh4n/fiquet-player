{"version":1,"track_id":866,"audio_sha256":"d80539178cbaec74e49a32e2a455dd5167108dc9191c9ba6aebcb39c240a4713","duration":16.94,"language":"russian","status":"ready","lines":[{"start":0,"end":1.98,"text":"А ещё вы просто не представляете, сколько раз"},{"start":1.98,"end":4.38,"text":"мне приходилось перезаписывать этот кавер, потому что я"},{"start":4.38,"end":5.6,"text":"помыла свои волосы, да."},{"start":7.32,"end":9.58,"text":"Уф. Но прикол в том, что они постоянно"},{"start":9.58,"end":11.42,"text":"вот прям мне в лицо улезут вот так"},{"start":11.42,"end":12.28,"text":"вот, поэтому да."},{"start":12.6,"end":14.66,"text":"С сотой попытки я надеюсь окупиться, и кавер"},{"start":14.66,"end":15.26,"text":"залетит."},{"start":16.02,"end":16.44,"text":"Надеемся."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
