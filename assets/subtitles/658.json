{"version":1,"track_id":658,"audio_sha256":"e158662184227a955c65e847f398b0d2d7468bda48cdb77391e155dbbd0ab4a6","duration":58.67,"language":"russian","status":"ready","lines":[{"start":1.86,"end":4.34,"text":"Кто сразу знает по аккордам?"},{"start":18.9,"end":25.76,"text":"А третий сын на колени упал, прости, отец,"},{"start":26.06,"end":28.08,"text":"я великим не стал."},{"start":28.24,"end":30.74,"text":"Людей любил,"},{"start":31.88,"end":40.2,"text":"врагов прощал, отец, ты подуй, а душа твоя"},{"start":40.2,"end":45.44,"text":"и добра и чиста, и пусть, пока ты"},{"start":46.12,"end":49.92,"text":"знать он ты не стал, но ты хранил"},{"start":49.92,"end":52.46,"text":"любовь мою, я тебе свой крест отдам."}],"verification":{"independent_review":true,"word_agreement":0.82,"review_model":"gpt-4o-transcribe","unanchored_words":9,"needs_chunk_review":false}}
