{"version":1,"track_id":134,"audio_sha256":"9cfd85341348a69ac8ad959f0997bca966e85677786fef98ff2c34c48228ecb9","duration":38.34,"language":"russian","status":"ready","lines":[{"start":0,"end":1.42,"text":"Как я записываю каверы."},{"start":2.44,"end":4.24,"text":"Вот тут моя электрогитара, я подключаю ее к"},{"start":4.24,"end":5.82,"text":"компаку. Ой, у меня очень грязно, но ничего"},{"start":5.82,"end":6.8,"text":"страшного, думаю, да?"},{"start":7.64,"end":8.72,"text":"Смотрите, вот мой стол."},{"start":9.22,"end":11.16,"text":"Здесь находится мой компьютер, здесь я открываю аккорды."},{"start":11.7,"end":13.62,"text":"На это зеркало я ставлю телефон."},{"start":14.0,"end":16.38,"text":"Вот оно, от пупырюшек моих, прилипучек, вот на"},{"start":16.38,"end":18.94,"text":"эти, леплю. Уже все грязное."},{"start":19.28,"end":22.86,"text":"Вот дальше вот так вот просто играю."},{"start":23.26,"end":24.06,"text":"Свет у меня сзади стоит."},{"start":24.18,"end":25.78,"text":"Кто у меня спрашивал, как такой свет сделать?"},{"start":25.78,"end":28.66,"text":"Просто сзади вот такой вот получается."},{"start":30.68,"end":32.2,"text":"Ну и, собственно, все."},{"start":32.78,"end":33.74,"text":"Бой с гитарой."},{"start":34.1,"end":35.18,"text":"Так записываются мои каверы."},{"start":35.9,"end":36.48,"text":"Может, кому-то интересно."}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
