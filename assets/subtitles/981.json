{"version":1,"track_id":981,"audio_sha256":"20d59b432860e7e53252ba3314e828a669dc77d413ee9f198258a9029fe5db26","duration":59.63,"language":"russian","status":"ready","lines":[{"start":0,"end":3.5,"text":"Захотелось мне вам спеть любовницу."},{"start":7.9,"end":12.9,"text":"Манеточка. Красим губы красным блеском, Дядя с бабушкой"},{"start":12.9,"end":16.86,"text":"неизвестно что, Сколько лет ей,"},{"start":17.88,"end":21.86,"text":"если честно, Даже папа не знает и пусть"},{"start":21.86,"end":26.14,"text":"и хорошо, А ты темный фильм разрешит покой."},{"start":30.94,"end":35.84,"text":"Включен на весь мир наш магнитофон,"},{"start":37.98,"end":43.9,"text":"В танце кружится без конца, Папина любовь, танцай,"},{"start":45.88,"end":49.58,"text":"Может быть, с мамой подружиться,"},{"start":50.62,"end":52.02,"text":"Папина"},{"start":57.46,"end":58.86,"text":"любовь, танцай. Папина любовь, танцай."}],"verification":{"independent_review":true,"word_agreement":0.78,"review_model":"gpt-4o-transcribe","unanchored_words":13,"needs_chunk_review":false}}
