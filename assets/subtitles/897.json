{"version":1,"track_id":897,"audio_sha256":"6a856266b6381adc3fa6f6660853ca29c9ce9c32db4dc8afd588d6e98b99aa78","duration":23.27,"language":"russian","status":"ready","lines":[{"start":0,"end":2.86,"text":"А ещё, вот помните посылку, которую я распаковывала,"},{"start":3.32,"end":5.1,"text":"да? Я... Там были тюльпанчики."},{"start":5.16,"end":7.0,"text":"Я вам рассказала о тюльпанчиках, которые были в"},{"start":7.0,"end":8.86,"text":"моих репостах. Так вот, я сделала."},{"start":9.0,"end":9.6,"text":"Сейчас я покажу."},{"start":9.74,"end":10.68,"text":"Сейчас я покажу этот чудо-светильник."},{"start":13.9,"end":15.04,"text":"Мы все готовы."},{"start":15.94,"end":16.0,"text":"Ой."},{"start":17.98,"end":20.02,"text":"Смотрите. Я это сделала сама."},{"start":21.68,"end":22.22,"text":"Мне он так нравится."}],"verification":{"independent_review":false,"word_agreement":0.979,"needs_chunk_review":false}}
