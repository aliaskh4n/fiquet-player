{"version":1,"track_id":616,"audio_sha256":"2bab2cea9a18d108504dc5a0fd5583e54a0a2ca192aaa637fba896875c3078e2","duration":39.47,"language":"russian","status":"ready","lines":[{"start":0,"end":4.82,"text":"Я спрашиваю, кто я и зачем я спрашиваю?"},{"start":5.02,"end":8.28,"text":"Даже сарказм человека не оскорблю."},{"start":8.4,"end":11.13,"text":"Даже мнение чужое уже предположим."},{"start":11.96,"end":14.3,"text":"Только я никого не люблю,"},{"start":15.08,"end":16.28,"text":"а люди любят."},{"start":16.98,"end":19.06,"text":"Они стоят с пакетами бутербродов."},{"start":19.76,"end":22.3,"text":"Покупали свеканье целый год, люди любят."},{"start":22.7,"end":26.76,"text":"Пускали в столовой серебро, достают на юбилей, Поступает"},{"start":26.76,"end":28.54,"text":"коньяк, и тут люди любят."},{"start":28.78,"end":31.54,"text":"Вот так артели крутить не дали, По утрам"},{"start":31.54,"end":34.04,"text":"цепеливо выгуливают собак."},{"start":34.26,"end":35.92,"text":"Вы думали, люди не любят?"},{"start":36.1,"end":38.86,"text":"Не угадали, люди любят, да и щекам."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
