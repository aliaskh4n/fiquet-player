{"version":3,"track_id":1069,"audio_sha256":"78e22d88600297ff6caf9ea0cb986c9186115884bd360db89b4419e57386948c","duration":92.112,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":6.53,"text":"Меня спасала только мысль о любви","source_line":0},{"start":6.84,"end":11.95,"text":"Забью на сон, ты только говори, говори","source_line":1},{"start":11.95,"end":17.19,"text":"Я прогуляю школу, маме не скажу.","source_line":2},{"start":17.19,"end":22.799999237060547,"text":"Открыт мой телеграмм и я тебе шепчу","source_line":3},{"start":23.67,"end":29.19,"text":"Я просыпалась, чтоб услышать голос твой,","source_line":4},{"start":29.19,"end":34.55,"text":"Чтоб по щеке провёл невидимой рукой","source_line":5},{"start":34.55,"end":40.97,"text":"От твоих слов по телу побежала дрожь","source_line":6},{"start":40.97,"end":44.06,"text":"Проблема в том, что мне пятнадцать,","source_line":7},{"start":44.06,"end":46.37,"text":"ты меня не трожь.","source_line":8},{"start":46.37,"end":52.21,"text":"С телефоном под рукой, засыпала по ночам,","source_line":9},{"start":52.21,"end":57.79,"text":"Знаешь, Святик Свидригайлов, очень зря полез ты к нам","source_line":10},{"start":57.79,"end":63.55,"text":"И однажды о любви хриплым голосом спросил","source_line":11},{"start":63.55,"end":66.48,"text":"Вот такой вот Свидри \"мальчик\"-","source_line":12},{"start":66.48,"end":69.43,"text":"Тридцатилетний педофил.","source_line":13},{"start":78.41,"end":81.85,"text":"Хотел трогать мои мокрые волосы,","source_line":14},{"start":81.85,"end":83.97,"text":"Связь плохая, дальше я не пойму...","source_line":15},{"start":83.97,"end":86.91,"text":"Хотел попасть в сердце к сотне девочек,","source_line":16},{"start":86.95,"end":88.65,"text":"А попадёшь в тюрьму.","source_line":17}],"verification":{"source_text_checked":true,"word_agreement":0.8,"matched_words":76,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.44},"song":"Свидригайлов, как пахнет твоё запястье?","artist":"Алёна Швец","source_url":"https://akkordov.net/akkordi/alena-shvets/394992-svidrigaylov-kak-pahnet-tvoe-zapyaste","source_sha256":"16f687895896f07b34473de054e4daceb8293216799cdc73908f5d0d910de66e"}
