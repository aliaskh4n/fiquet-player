{"version":2,"track_id":1069,"audio_sha256":"78e22d88600297ff6caf9ea0cb986c9186115884bd360db89b4419e57386948c","duration":92.112,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":4.72,"text":"Меня спасала только мысль о любви","source_line":0},{"start":5.06,"end":12.0,"text":"Забью на сон, ты только говори, говори","source_line":1},{"start":12.0,"end":17.24,"text":"Я прогуляю школу, маме не скажу.","source_line":2},{"start":17.84,"end":22.8,"text":"Открыт мой телеграмм и я тебе шепчу","source_line":3},{"start":23.72,"end":29.26,"text":"Я просыпалась, чтоб услышать голос твой,","source_line":4},{"start":30.04,"end":34.6,"text":"Чтоб по щеке провёл невидимой рукой","source_line":5},{"start":34.6,"end":40.0,"text":"От твоих слов по телу побежала дрожь","source_line":6},{"start":41.02,"end":44.1,"text":"Проблема в том, что мне пятнадцать,","source_line":7},{"start":44.22,"end":46.24,"text":"ты меня не трожь.","source_line":8},{"start":46.42,"end":52.26,"text":"С телефоном под рукой, засыпала по ночам,","source_line":9},{"start":52.58,"end":57.84,"text":"Знаешь, Святик Свидригайлов, очень зря полез ты к нам","source_line":10},{"start":57.84,"end":63.6,"text":"И однажды о любви хриплым голосом спросил","source_line":11},{"start":63.6,"end":66.48,"text":"Вот такой вот Свидри \"мальчик\"-","source_line":12},{"start":78.46,"end":81.9,"text":"Хотел трогать мои мокрые волосы,","source_line":14},{"start":81.9,"end":84.02,"text":"Связь плохая, дальше я не пойму...","source_line":15}],"verification":{"source_text_checked":true,"word_agreement":0.8,"matched_words":76,"timing":"cached_word_anchors"},"song":"Свидригайлов, как пахнет твоё запястье?","artist":"Алёна Швец","source_url":"https://akkordov.net/akkordi/alena-shvets/394992-svidrigaylov-kak-pahnet-tvoe-zapyaste","source_sha256":"16f687895896f07b34473de054e4daceb8293216799cdc73908f5d0d910de66e"}
