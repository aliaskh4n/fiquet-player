{"version":1,"track_id":606,"audio_sha256":"0782766cddd984ba44f9ecfb65173aa2c6354932256b37bcaaeaef0f89670bc8","duration":45.85,"language":"russian","status":"ready","lines":[{"start":0,"end":2.4,"text":"В середине песни обрабатый эфир."},{"start":3.26,"end":4.42,"text":"Я не знаю, что делать."},{"start":4.62,"end":8.1,"text":"Сейчас мы попробуем это заново начать."},{"start":8.48,"end":10.0,"text":"Ну давайте я, подожди, я доиграю."},{"start":10.34,"end":10.7,"text":"Дай мне аккорд."},{"start":13.98,"end":17.98,"text":"Ты говоришь, что у тебя по географии трояка."},{"start":18.26,"end":20.78,"text":"Мне на это просто наплевать."},{"start":21.14,"end":23.98,"text":"Ты говоришь, и за тебя там кто-то получил"},{"start":23.98,"end":27.4,"text":"синяк. Многозначительно молчу, и дальше мы идём гулять."},{"start":31.8,"end":33.64,"text":"Ой, свекласница."},{"start":42.94,"end":45.24,"text":"Всё, сейчас будем там учинить."}],"verification":{"independent_review":false,"word_agreement":0.984,"needs_chunk_review":false}}
