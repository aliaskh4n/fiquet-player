{"version":1,"track_id":816,"audio_sha256":"041ee5333e594c46d7dbf324582e16e975e38d394a7f8d3a65ad2b64714456d4","duration":56.14,"language":"russian","status":"ready","lines":[{"start":0,"end":1.18,"text":"Ребята, всем привет!"},{"start":1.38,"end":2.36,"text":"Сейчас буду объяснять бой."},{"start":2.96,"end":5.08,"text":"Вообще перестала делать разборы, нужно возглавить всё-таки"},{"start":5.6,"end":8.54,"text":"канал. Изначально был для разборов, но что-то меня"},{"start":8.54,"end":9.66,"text":"потянули туда. Короче,"},{"start":10.56,"end":12.86,"text":"вот у нас кап на перрон, вызажимаем F,"},{"start":13.52,"end":16.54,"text":"и бой у нас такой вниз-вниз-вниз, четыре раза"},{"start":16.54,"end":18.94,"text":"играем, но он играется с акцентом, типа на"},{"start":18.94,"end":19.16,"text":"первый. Раз-два-три, раз-два-три, раз-два-три, раз-два-три."},{"start":49.14,"end":50.34,"text":"Ещё раз объясняю."},{"start":52.18,"end":53.4,"text":"Вот, чтобы всем уже было понятно."},{"start":54.46,"end":55.68,"text":"Вот, сейчас ещё разборок накидаю."}],"verification":{"independent_review":false,"word_agreement":0.897,"needs_chunk_review":false}}
