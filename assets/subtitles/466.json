{"version":1,"track_id":466,"audio_sha256":"150b8faa8a628d787f015c6366d96985eaa419128813c36d74f52c9d51e76f2c","duration":22.67,"language":"russian","status":"ready","lines":[{"start":0,"end":2.76,"text":"И, в общем, если вы берёте лак, берите"},{"start":2.76,"end":4.54,"text":"от Кико, потому что он хороший."},{"start":4.72,"end":6.7,"text":"Но его обычно два слоя нужно носить, потому"},{"start":6.7,"end":7.82,"text":"что они полупрозрачные."},{"start":8.42,"end":10.06,"text":"И второе, смотрите на кисточку."},{"start":10.24,"end":13.14,"text":"Кисточка должна быть полуокруглая, потому что если она"},{"start":13.14,"end":15.6,"text":"квадратная, это всегда дико неудобно."},{"start":16.06,"end":17.4,"text":"Сейчас, может быть, я даже покажу."},{"start":18.3,"end":20.72,"text":"Я нашла свою тушь!"},{"start":20.8,"end":22.24,"text":"Вот, у меня есть такая баночка с лаком."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
