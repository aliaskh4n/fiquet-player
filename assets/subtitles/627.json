{"version":1,"track_id":627,"audio_sha256":"a8b0f387d3152fa7d456dd24c9937286bea733da5273aca8aad8f458e1e72098","duration":25.24,"language":"russian","status":"ready","lines":[{"start":0,"end":3.08,"text":"Это буквально моя Римская империя, это фотка."},{"start":3.6,"end":5.44,"text":"Я хочу, чтоб, если со мной кто-то будет"},{"start":5.44,"end":7.46,"text":"знакомиться, первое, что он видел, это вот эта"},{"start":7.46,"end":7.76,"text":"фотка."},{"start":9.04,"end":10.6,"text":"Это лучшая фотка за всю мою историю жизни."},{"start":10.64,"end":12.02,"text":"И второе. Второе."},{"start":12.74,"end":14.0,"text":"Смотрите, какую одежду я купила."},{"start":14.1,"end":15.34,"text":"Я немножко спойлер сделаю."},{"start":19.64,"end":21.06,"text":"Вот такая маечка."},{"start":22.46,"end":22.64,"text":"Ух."}],"verification":{"independent_review":false,"word_agreement":0.979,"needs_chunk_review":false}}
