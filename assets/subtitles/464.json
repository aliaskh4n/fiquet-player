{"version":1,"track_id":464,"audio_sha256":"899d33f42f8b40ffc8c91c264890009c7354b728d696de260e6374e82b7b685a","duration":28.27,"language":"russian","status":"ready","lines":[{"start":0,"end":5.44,"text":"Тёрли свинки друг другу спинки, Мыли хвостики, крючки,"},{"start":5.9,"end":7.36,"text":"отмывали пятачки."},{"start":8.3,"end":9.76,"text":"Парились венечком,"},{"start":10.78,"end":18.86,"text":"парились берёзовым, Вылетали с парной облачком розовым."},{"start":20.9,"end":24.74,"text":"Уж такие душечки, после баньки хрюшечки!"},{"start":25.08,"end":28.22,"text":"Уж такие душечки, после баньки хрюшечки!"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
