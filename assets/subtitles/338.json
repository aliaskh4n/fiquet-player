{"version":1,"track_id":338,"audio_sha256":"843b40296866b5579976524a2c6aaea3a51821efe9a9a9e4ceb718989d7b4917","duration":31.5,"language":"russian","status":"ready","lines":[{"start":0,"end":1.16,"text":"Котята, всем привет."},{"start":1.36,"end":2.08,"text":"Видите, какая красивая?"},{"start":2.24,"end":2.62,"text":"Как идёт, да?"},{"start":3.16,"end":5.0,"text":"Потому что я вам записывала новый кавер, который"},{"start":5.0,"end":6.72,"text":"уже в сети, в ТикТоке."},{"start":7.5,"end":8.12,"text":"У меня есть для вас игра."},{"start":8.46,"end":10.46,"text":"Я сейчас сыграю аккорды этой песни."},{"start":10.92,"end":12.26,"text":"Вы угадайте, напишите."},{"start":12.32,"end":13.1,"text":"А не угадайте тоже."},{"start":13.14,"end":16.78,"text":"Напишите в комментариях под видео в ТикТоке."},{"start":18.22,"end":18.5,"text":"Ой."},{"start":29.92,"end":30.9,"text":"Всё, больше не пойду."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
