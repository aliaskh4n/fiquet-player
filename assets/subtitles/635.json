{"version":1,"track_id":635,"audio_sha256":"30e6404910cee963a658df2c2bf2e4e51b9a7a94cc71f7bba0aa20ab4f88eb04","duration":16.5,"language":"russian","status":"ready","lines":[{"start":0,"end":2.76,"text":"Особенно, вот я сегодня играла в Майнкрафт, потому"},{"start":2.76,"end":4.6,"text":"что новое число обновлений, нужно протестить."},{"start":5.66,"end":7.9,"text":"И мне безумно нравится эта деталь с характерами"},{"start":7.9,"end":10.16,"text":"у собачек. Мне кажется, это безумно мило."},{"start":10.82,"end":11.02,"text":"Вот."},{"start":12.1,"end":14.36,"text":"Я сделала собачку, и у неё был характер"},{"start":14.36,"end":14.74,"text":"мопса."},{"start":15.58,"end":16.36,"text":"Кто знает, кто шарит."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
