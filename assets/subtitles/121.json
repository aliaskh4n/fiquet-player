{"version":1,"track_id":121,"audio_sha256":"1e6535a34f60e12f40c10fc14bbc5ad1fa24acc4ec4af1ec852ad227e7a8178f","duration":33.76,"language":"russian","status":"ready","lines":[{"start":0,"end":2.34,"text":"Хотела заниматься, и в итоге просидела весь вечер"},{"start":2.34,"end":3.12,"text":"и записывала вам кавры."},{"start":3.38,"end":4.28,"text":"Поэтому да, слушайте."},{"start":6.58,"end":11.42,"text":"Это романтика по раскваленной стенце, сетка плачет, что"},{"start":11.42,"end":13.62,"text":"ты не достался."},{"start":14.64,"end":16.56,"text":"Я хожу в твоей рубашке,"},{"start":17.44,"end":22.44,"text":"свой универ, ненавижу его, уж лучше б он"},{"start":24.02,"end":26.32,"text":"скорел. Где-то в три ночи в парадной босиком,"},{"start":28.1,"end":31.18,"text":"два ненормальных человека танцевали рок-н-ролл."}],"verification":{"independent_review":true,"word_agreement":0.731,"review_model":"gpt-4o-transcribe","unanchored_words":14,"needs_chunk_review":false}}
