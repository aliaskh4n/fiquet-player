{"version":1,"track_id":991,"audio_sha256":"6fa1ad7652f98b63009f08b08378ea9ee5653301ad4f4e067540627cb07fbced","duration":39.79,"language":"russian","status":"ready","lines":[{"start":0,"end":2.3,"text":"Я сейчас сыграю."},{"start":3.62,"end":4.28,"text":"Как бы здесь..."},{"start":9.86,"end":11.7,"text":"Ну, пофигу. Я выложу фал тебя в сюжет,"},{"start":12.24,"end":17.84,"text":"перед незнакомыми чужими людьми, королёвой ночи."},{"start":18.94,"end":21.74,"text":"Ты бы отвлекалась так и сам, что ты"},{"start":21.74,"end":26.82,"text":"говоришь, такой дурак, что люди поймут не так,"},{"start":26.82,"end":28.62,"text":"как ты."},{"start":32.7,"end":33.98,"text":"Смешные воски тела фарфор."},{"start":36.4,"end":37.12,"text":"Смешные зонки тела фарфор."}],"verification":{"independent_review":true,"word_agreement":0.696,"review_model":"gpt-4o-transcribe","unanchored_words":14,"needs_chunk_review":false}}
