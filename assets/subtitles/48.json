{"version":1,"track_id":48,"audio_sha256":"c871b1585e076119f2a3ab1611b67e6bd9b189c38f82834244c7cc494fbc29f9","duration":27.95,"language":"russian","status":"ready","lines":[{"start":0,"end":1.76,"text":"Окей, в общем, что делаем дальше?"},{"start":2.34,"end":4.48,"text":"Я думала, меня забанили сейчас, потому что у"},{"start":4.48,"end":7.14,"text":"меня висел огромный замок почему-то и написано, типа,"},{"start":7.26,"end":8.88,"text":"ограничение по возрасту, ограничение по возрасту, и я"},{"start":8.88,"end":9.52,"text":"такая, окей, ладно."},{"start":10.48,"end":13.02,"text":"В эфир? Я больше не могу выходить до"},{"start":13.02,"end":14.2,"text":"18 лет."},{"start":15.22,"end":16.18,"text":"Кто это сделал?"},{"start":16.52,"end":17.74,"text":"Я... Окей."},{"start":18.84,"end":19.9,"text":"Ну и всё."},{"start":20.22,"end":21.54,"text":"Видосы будут выходить."},{"start":22.9,"end":25.0,"text":"Может, перекочую на Twitch или..."},{"start":25.66,"end":26.44,"text":"И стану стримершей."},{"start":26.7,"end":27.6,"text":"Ну, это вряд ли."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
