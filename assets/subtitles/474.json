{"version":3,"track_id":474,"audio_sha256":"3c9a56fa983868b38c788e1acb5080d3839f45efe82b5108fef580ebda1a2e83","duration":70.18,"origin":"original_lyrics","status":"ready","lines":[{"start":5.66,"end":9.71,"text":"Halley's Comet","source_line":4},{"start":11.34,"end":16.360000014305115,"text":"Comes around more than I do","source_line":5},{"start":17.6,"end":24.97,"text":"But you're all it takes for me to break a promise","source_line":6},{"start":25.2,"end":29.95,"text":"Silly me to fall in love with you","source_line":7},{"start":29.95,"end":34.37,"text":"I haven't slept since Sunday","source_line":8},{"start":34.5,"end":43.61,"text":"Midnight for me is 3:00 a.m. for you","source_line":9},{"start":43.61,"end":47.19,"text":"But my sleepless nights are better","source_line":10},{"start":47.19,"end":57.26,"text":"With you than nights could ever be alone, ooh-ooh-ooh","source_line":11},{"start":57.26,"end":63.92,"text":"I was good at feeling nothing, now I'm hopeless","source_line":12},{"start":63.92,"end":70.18,"text":"What a drag to love you like I do, ooh-ooh, ooh, ooh","source_line":13}],"verification":{"source_text_checked":true,"word_agreement":0.872,"matched_words":41,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.269},"song":"Halley's Comet","artist":"Billie Eilish","source_url":"https://lrclib.net/api/get/37487281","source_sha256":"14af60d3d38828d270448f8b08ec03d2c32552d64cb2d875a703d9c1c6000892"}
