{"version":1,"track_id":404,"audio_sha256":"71894913fb1029dacb6717a7d33c92b7ce4e95343d50d665f98b1cbc7fc002d5","duration":12.93,"language":"russian","status":"ready","lines":[{"start":0,"end":1.04,"text":"Йоу, ребята,"},{"start":2.38,"end":4.08,"text":"всем спасибо за такой шикарный стрим."},{"start":4.26,"end":5.84,"text":"Я пойду делать себе бутерброды."},{"start":5.88,"end":7.24,"text":"Нет, я даже не пойду, я побегу это"},{"start":7.24,"end":9.4,"text":"делать. Всех люблю, всех целую."},{"start":10.02,"end":11.34,"text":"Было очень круто, очень вайбово."},{"start":11.64,"end":12.74,"text":"Я буду делать их чаще теперь."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
