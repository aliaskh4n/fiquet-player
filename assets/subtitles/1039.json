{"version":2,"track_id":1039,"audio_sha256":"422472c43945ac16fb0f9a35db697535c1d316799a41f34e12fb4f0701fa4ebe","duration":85.86,"origin":"original_lyrics","status":"ready","lines":[{"start":32.28,"end":34.28,"text":"Плохо, что наше с тобой время истекло","source_line":6},{"start":34.42,"end":36.98,"text":"И я иду домой, уже совсем светло","source_line":7},{"start":37.16,"end":41.94,"text":"Это не первое и не последнее утро, что я тебе подарю","source_line":8},{"start":42.32,"end":45.32,"text":"Мы слишком молоды, чтобы вести себя мудро","source_line":9},{"start":45.74,"end":47.18,"text":"Я знаю, что говорю","source_line":10},{"start":47.58,"end":50.5,"text":"Это не первое и не последнее утро","source_line":11},{"start":51.1,"end":52.52,"text":"Никто не отнимет их","source_line":12},{"start":52.7,"end":56.0,"text":"Мы подозрительно мудрые для молодых","source_line":13},{"start":57.22,"end":60.24,"text":"И шире некуда улыбка на лице","source_line":14},{"start":60.46,"end":62.76,"text":"Ни одного человека на улице","source_line":15},{"start":63.02,"end":65.3,"text":"И горизонт возбуждённо порозовел","source_line":16},{"start":65.46,"end":66.92,"text":"А я замёрз — судя по всему, протрезвел","source_line":17},{"start":68.24,"end":70.26,"text":"И тишина, лишь деревья одни шумят","source_line":18},{"start":70.64,"end":72.42,"text":"Иду по городу, я доволен и помят","source_line":19},{"start":73.12,"end":75.38,"text":"Мимо аллей и гаражей, вот и мой дом","source_line":20},{"start":75.6,"end":77.92,"text":"Извините, я спать. Побеседуем потом","source_line":21},{"start":78.34,"end":84.0,"text":"Это не первое и не последнее утро, что я тебе подарю","source_line":22}],"verification":{"source_text_checked":true,"word_agreement":0.92,"matched_words":104,"timing":"cached_word_anchors"},"song":"Утро","artist":"Дайте танк (!)","source_url":"https://lrclib.net/api/get/26239787","source_sha256":"8f36b58a8ab26278e8610f67a681c89bf22eec1518f17bd6eecbc21dd554853e"}
