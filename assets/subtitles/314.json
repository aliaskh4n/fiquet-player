{"version":1,"track_id":314,"audio_sha256":"98836b29e36da1213b650bab2791c64746486527299715f6d761b9f105d178a2","duration":19.49,"language":"russian","status":"ready","lines":[{"start":1.74,"end":4.28,"text":"У меня сегодня вечером для вас будет кое-какой"},{"start":4.7,"end":6.82,"text":"сюрприз, я не знаю, он вам понравится или"},{"start":6.82,"end":7.16,"text":"нет."},{"start":8.3,"end":8.84,"text":"Это первое."},{"start":10.86,"end":12.24,"text":"Ну, у вас уже будет ночь, потому что"},{"start":12.24,"end":13.28,"text":"я всё же в Лондоне."},{"start":13.82,"end":16.16,"text":"И плюс второе — то, что вы хотите"},{"start":16.16,"end":17.96,"text":"завтра стримчик провести."}],"verification":{"independent_review":false,"word_agreement":0.953,"needs_chunk_review":false}}
