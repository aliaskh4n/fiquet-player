{"version":1,"track_id":826,"audio_sha256":"f21a785e9361d5c611fc8890ff754bb58cb18971cf3cc00171c7885bd163f406","duration":50.13,"language":"russian","status":"ready","lines":[{"start":1.92,"end":5.02,"text":"Мне давно уже за двадцать, мои кота другие"},{"start":5.02,"end":8.36,"text":"замужем, фольга встань со мной, петля мне пора"},{"start":8.36,"end":11.64,"text":"остепениться, я почти нашла супруга, но уже в"},{"start":11.64,"end":14.64,"text":"пятый раз его подруга."},{"start":14.64,"end":16.44,"text":"Я останусь одна,"},{"start":18.18,"end":21.38,"text":"заведу здесь не скучно, буду вечно пьяна."},{"start":21.56,"end":22.76,"text":"Я останусь одна,"},{"start":24.82,"end":27.78,"text":"до свидания хорошему, не надо стонать."},{"start":27.78,"end":29.34,"text":"Я останусь одна,"},{"start":30.92,"end":34.22,"text":"заведу здесь не скучно, буду вечно пьяна."},{"start":34.74,"end":35.6,"text":"Я останусь одна,"},{"start":38.54,"end":39.66,"text":"тишина,"},{"start":40.6,"end":40.8,"text":"тишина,"},{"start":41.54,"end":41.74,"text":"тишина."}],"verification":{"independent_review":true,"word_agreement":0.825,"review_model":"gpt-4o-transcribe","unanchored_words":11,"needs_chunk_review":false}}
