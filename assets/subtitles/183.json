{"version":1,"track_id":183,"audio_sha256":"2b209391f68be8441ef0a55fdac787843bac0077145b13e506bffe2f591d403a","duration":20.9,"language":"russian","status":"ready","lines":[{"start":0,"end":3.54,"text":"Мне показалось, что сейчас такой очень домашний вайб,"},{"start":3.94,"end":6.36,"text":"очень приятный. Я хотела, чтобы вы на меня"},{"start":6.36,"end":8.64,"text":"посмотрели. Ну, мне кажется, просто..."},{"start":8.64,"end":10.04,"text":"Не знаю, почему в этот момент, когда мне"},{"start":10.04,"end":10.94,"text":"нравится, как я выгляжу."},{"start":11.94,"end":13.8,"text":"Хотя... Ну, не прямо эффектно, я бы сказала."},{"start":15.12,"end":15.84,"text":"Ну, в общем, вот."},{"start":15.84,"end":18.82,"text":"Поэтому всем спокойной ночи и сладких снов с"},{"start":18.82,"end":19.02,"text":"тобой."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
