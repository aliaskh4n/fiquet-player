{"version":1,"track_id":776,"audio_sha256":"a7eaa5c1dde253ab0215319367635cdddcf2202713857a92eb454cd9d15210f7","duration":27.38,"language":"russian","status":"ready","lines":[{"start":0,"end":4.44,"text":"И, короче, я тоже готовлю посылку сейчас."},{"start":5.26,"end":5.74,"text":"Смотрите."},{"start":12.24,"end":13.8,"text":"Оно ещё крутится, да?"},{"start":13.9,"end":17.18,"text":"То есть я туда положу тоже бумажки, и"},{"start":17.18,"end":18.2,"text":"будет круто. И второе."},{"start":19.98,"end":21.02,"text":"Казалось бы, обычный чехол."},{"start":21.12,"end":23.0,"text":"Ну хотя нет, он в целом необычный, но..."},{"start":26.48,"end":26.96,"text":"Вот."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
