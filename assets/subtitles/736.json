{"version":3,"track_id":736,"audio_sha256":"0ff05fee0a006ddd699256e0be8e6fa721aca415e951bebdf2ff940bdb4258b4","duration":51.37,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":3.21,"text":"Ничего не снится, мне не спится","source_line":0},{"start":3.21,"end":6.51,"text":"Чтобы не спиться, я возьму спицы","source_line":1},{"start":6.51,"end":10.01,"text":"Свяжу любовь из порванных нервов","source_line":2},{"start":10.01,"end":12.180000305175781,"text":"Она всё-таки стерва","source_line":3},{"start":12.3,"end":15.2,"text":"Искусала тело, душу целовала","source_line":4},{"start":15.2,"end":18.15,"text":"Кровь кипела, но ей, видимо, было мало","source_line":5},{"start":18.26,"end":21.95,"text":"Убежала, вернись","source_line":6},{"start":21.95,"end":24.53,"text":"Я не хочу без тебя спать!","source_line":7},{"start":24.53,"end":27.13,"text":"Я не хочу умереть в кровати","source_line":8},{"start":27.13,"end":30.31999969482422,"text":"Я не хочу без твоих объятий","source_line":9},{"start":30.39,"end":33.03,"text":"Невыносимо тебя желать","source_line":10},{"start":33.03,"end":35.99,"text":"Я не хочу без тебя дышать!","source_line":11},{"start":35.99,"end":38.91,"text":"Лишь одеяло согреет плечи","source_line":12},{"start":38.91,"end":41.39,"text":"Ты знаешь, это меня не лечит","source_line":13},{"start":41.39,"end":44.2400016784668,"text":"Я не хочу без тебя спать","source_line":14}],"verification":{"source_text_checked":true,"word_agreement":0.948,"matched_words":73,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.479},"song":"Спать","artist":"MILKOVSKYI - Topic","source_url":"https://lrclib.net/api/get/37447203","source_sha256":"201578b50adbad46e119069fc02cd486b1e5e26194389f077ae21bd393c2ce9b"}
