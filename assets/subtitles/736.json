{"version":2,"track_id":736,"audio_sha256":"0ff05fee0a006ddd699256e0be8e6fa721aca415e951bebdf2ff940bdb4258b4","duration":51.37,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.26,"text":"Ничего не снится, мне не спится","source_line":0},{"start":3.26,"end":6.5,"text":"Чтобы не спиться, я возьму спицы","source_line":1},{"start":6.56,"end":9.22,"text":"Свяжу любовь из порванных нервов","source_line":2},{"start":10.06,"end":12.18,"text":"Она всё-таки стерва","source_line":3},{"start":13.46,"end":15.26,"text":"Искусала тело, душу целовала","source_line":4},{"start":15.26,"end":18.04,"text":"Кровь кипела, но ей, видимо, было мало","source_line":5},{"start":18.54,"end":22.0,"text":"Убежала, вернись","source_line":6},{"start":22.0,"end":24.0,"text":"Я не хочу без тебя спать!","source_line":7},{"start":24.58,"end":27.18,"text":"Я не хочу умереть в кровати","source_line":8},{"start":27.18,"end":30.32,"text":"Я не хочу без твоих объятий","source_line":9},{"start":30.44,"end":33.08,"text":"Невыносимо тебя желать","source_line":10},{"start":33.08,"end":36.04,"text":"Я не хочу без тебя дышать!","source_line":11},{"start":36.04,"end":38.96,"text":"Лишь одеяло согреет плечи","source_line":12},{"start":38.96,"end":41.44,"text":"Ты знаешь, это меня не лечит","source_line":13},{"start":41.44,"end":44.24,"text":"Я не хочу без тебя спать","source_line":14}],"verification":{"source_text_checked":true,"word_agreement":0.948,"matched_words":73,"timing":"cached_word_anchors"},"song":"Спать","artist":"MILKOVSKYI - Topic","source_url":"https://lrclib.net/api/get/37447203","source_sha256":"201578b50adbad46e119069fc02cd486b1e5e26194389f077ae21bd393c2ce9b"}
