{"version":1,"track_id":793,"audio_sha256":"ba4e4eff16cbd6de3e0a766274947f227dcc0ce6aeab974cf1c400c27b831c72","duration":57.7,"language":"russian","status":"ready","lines":[{"start":0,"end":2.96,"text":"Ты прикольная, да, ты прикольная."},{"start":2.96,"end":3.72,"text":"Как я так, Саша, всё страстно целовал."},{"start":6.3,"end":9.68,"text":"И одна, и сегодня буду пьяный, сегодня набу."},{"start":10.66,"end":13.16,"text":"Это значит, что ты пас, это значит, что"},{"start":13.16,"end":15.12,"text":"я прав. Но мне снова пофиг."},{"start":26.16,"end":29.96,"text":"Ты красива, как зима, и тебя поцеловал, и"},{"start":30.3,"end":31.58,"text":"тебя поцеловал."},{"start":33.06,"end":36.7,"text":"Ты ничего не поняла, ничего не поняла, ничего"},{"start":36.7,"end":37.84,"text":"не поняла."},{"start":38.94,"end":42.58,"text":"Почему в тебя влюбился, почему в тебя влюбился,"},{"start":42.82,"end":44.28,"text":"ты меня не поняла."},{"start":45.98,"end":47.76,"text":"Ты ничего не поняла,"},{"start":49.28,"end":51.16,"text":"ничего не поняла."}],"verification":{"independent_review":true,"word_agreement":0.863,"review_model":"gpt-4o-transcribe","unanchored_words":10,"needs_chunk_review":false}}
