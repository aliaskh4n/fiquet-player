{"version":2,"track_id":793,"audio_sha256":"ba4e4eff16cbd6de3e0a766274947f227dcc0ce6aeab974cf1c400c27b831c72","duration":57.7,"origin":"original_lyrics","status":"ready","lines":[{"start":0.52,"end":3.72,"text":"Ты прикольная, о, да, ты прикольная, как я","source_line":25},{"start":3.76,"end":7.08,"text":"Ты, как старшая сестра — сексуальна и умна","source_line":26},{"start":10.66,"end":13.76,"text":"Это значит, что ты пас, это значит, что я прав","source_line":28},{"start":13.82,"end":14.52,"text":"Но мне снова похуй","source_line":29},{"start":26.98,"end":29.96,"text":"Ты красива, как зима, я тебя поцеловал","source_line":32},{"start":33.06,"end":36.1,"text":"Ты ничего не поняла, ничего не поняла","source_line":34},{"start":38.94,"end":42.58,"text":"Почему в тебя влюбился? Почему в тебя влюбился?","source_line":36},{"start":45.98,"end":47.76,"text":"Ты ничего не поняла","source_line":38},{"start":49.28,"end":51.16,"text":"Ничего не поняла","source_line":39}],"verification":{"source_text_checked":true,"word_agreement":0.932,"matched_words":68,"timing":"cached_word_anchors"},"song":"ТЫ НИЧЕГО НЕ ПОНЯЛА","artist":"Джизус","source_url":"https://lrclib.net/api/get/10700238","source_sha256":"6c9f650f27cb973502948e329c4a53c5c7415b1b2201d4ca45b2a24ac0d0cb82"}
