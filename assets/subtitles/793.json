{"version":3,"track_id":793,"audio_sha256":"ba4e4eff16cbd6de3e0a766274947f227dcc0ce6aeab974cf1c400c27b831c72","duration":57.7,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":3.62,"text":"Ты прикольная, о, да, ты прикольная, как я","source_line":25},{"start":3.62,"end":7.02,"text":"Ты, как старшая сестра — сексуальна и умна","source_line":26},{"start":7.02,"end":10.52,"text":"Я сегодня буду пьян, я сегодня набухан","source_line":27},{"start":10.52,"end":13.7,"text":"Это значит, что ты пас, это значит, что я прав","source_line":28},{"start":13.7,"end":14.62,"text":"Но мне снова похуй","source_line":29},{"start":14.62,"end":15.17,"text":"У-у-у (у-а-у)","source_line":30},{"start":26.11,"end":29.91,"text":"Ты красива, как зима, я тебя поцеловал","source_line":32},{"start":29.91,"end":32.57,"text":"Я тебя поцеловал (у-а-у)","source_line":33},{"start":32.78,"end":36.19,"text":"Ты ничего не поняла, ничего не поняла","source_line":34},{"start":36.2,"end":38.05,"text":"Ничего не поняла (а-а-а)","source_line":35},{"start":38.89,"end":42.56,"text":"Почему в тебя влюбился? Почему в тебя влюбился?","source_line":36},{"start":42.56,"end":45.6,"text":"Ты меня не поняла (а-а-а)","source_line":37},{"start":45.6,"end":47.7599983215332,"text":"Ты ничего не поняла","source_line":38},{"start":48.98,"end":51.37,"text":"Ничего не поняла","source_line":39}],"verification":{"source_text_checked":true,"word_agreement":0.932,"matched_words":68,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.533},"song":"ТЫ НИЧЕГО НЕ ПОНЯЛА","artist":"Джизус","source_url":"https://lrclib.net/api/get/10700238","source_sha256":"6c9f650f27cb973502948e329c4a53c5c7415b1b2201d4ca45b2a24ac0d0cb82"}
