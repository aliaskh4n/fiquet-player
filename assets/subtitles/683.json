{"version":3,"track_id":683,"audio_sha256":"2b213eb3ae2892da52c7a82ac13b669500e5bf142a9f9c11f7a50684093a5561","duration":96.16,"origin":"original_lyrics","status":"ready","lines":[{"start":3.62,"end":7.98,"text":"Вспомни тот вид, который","source_line":0},{"start":7.98,"end":11.31,"text":"Нам открывался с мыса","source_line":1},{"start":12.26,"end":17.77,"text":"Ярким пятном над морем восход","source_line":2},{"start":20.34,"end":24.53,"text":"И всё, что я должен видеть","source_line":3},{"start":24.72,"end":28.01,"text":"Маленький глупый смысл","source_line":4},{"start":28.66,"end":33.73,"text":"Когда-нибудь я продолжу полёт","source_line":5},{"start":36.92,"end":40.51,"text":"Прости мне мои расспросы","source_line":6},{"start":41.16,"end":44.900001525878906,"text":"Но это невыносимо","source_line":7},{"start":45.38,"end":49.11,"text":"Так быстро проходит осень","source_line":8},{"start":49.45,"end":53.19,"text":"Так тянутся долго зимы","source_line":9},{"start":53.96,"end":60.1,"text":"Съедают мои детали ветер и снег","source_line":10},{"start":60.1,"end":60.87,"text":"Давай!","source_line":11},{"start":62.54,"end":66.42,"text":"Куда бы мы не летали","source_line":12},{"start":68.3,"end":73.1,"text":"Вспоминай, вспоминай, вспоминай, вспоминай","source_line":13},{"start":76,"end":81.6,"text":"Вспоминай, вспоминай, вспоминай, вспоминай","source_line":13}],"verification":{"source_text_checked":true,"word_agreement":0.75,"matched_words":27,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.346},"song":"Кладбище самолетов","artist":"Валентин Стрыкало","source_url":"https://lrclib.net/api/get/4752945","source_sha256":"dcef991add2609dbdc3b94eb1b10bac336b87514472c1f2a68c2db9803d540a7"}
