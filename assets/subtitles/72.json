{"version":1,"track_id":72,"audio_sha256":"db141a1babe2c2876a21ba80d0b5c86c7529dbe56320125d20f7850c96480089","duration":33.79,"language":"russian","status":"ready","lines":[{"start":0,"end":0.92,"text":"Ну, кстати,"},{"start":2.08,"end":2.76,"text":"сейчас вот так вот поставлю."},{"start":2.82,"end":3.88,"text":"I don't know."},{"start":4.6,"end":7.0,"text":"Я не знаю, это не совсем..."},{"start":9.82,"end":12.12,"text":"Короче, вот это вот, это не совсем то,"},{"start":12.18,"end":12.82,"text":"что я хотела."},{"start":13.46,"end":14.72,"text":"Сейчас поближе поставлю."},{"start":15.38,"end":18.02,"text":"Но, в принципе, я хочу вот здесь ещё"},{"start":18.02,"end":20.34,"text":"больше ткани, типа, чтобы её можно было натягивать"},{"start":20.34,"end":20.82,"text":"на штаны."},{"start":22.74,"end":24.86,"text":"Ну, в общем, вот такая вот у меня"},{"start":24.86,"end":26.56,"text":"бэйба на сегодня."},{"start":29.16,"end":30.8,"text":"Первый раз дизайнер."},{"start":31.16,"end":33.46,"text":"Первый раз, хэштег, первый раз."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
