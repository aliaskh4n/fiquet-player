{"version":2,"track_id":697,"audio_sha256":"c4588129becdc9067fff47ca4c5761c7f39626356f4a0049590758635521d7f7","duration":50.23,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.0,"text":"Твои волосы цвета первого снега","source_line":15},{"start":3.4,"end":4.88,"text":"Слепят встречных водителей","source_line":16},{"start":4.88,"end":7.64,"text":"Ты — лучшая жопа на факультете","source_line":17},{"start":7.64,"end":9.98,"text":"Ты — гордость своих родителей","source_line":18},{"start":10.78,"end":13.08,"text":"Да, я сверкаю как бриллиант 25 карат","source_line":19},{"start":13.08,"end":14.84,"text":"Я вылетаю на одну из местных автострад","source_line":20},{"start":16.02,"end":17.52,"text":"Плотный ряд машин, двадцатка на бензин","source_line":21},{"start":17.52,"end":23.3,"text":"И я давлю на газ!","source_line":22},{"start":32.52,"end":37.86,"text":"Все подруги по общаге наливают и рыдают, ведь знают, шо я","source_line":29},{"start":37.86,"end":42.14,"text":"На Кайене вся в Габбане по Житомиру гоняю, я гоняю, о!","source_line":30}],"verification":{"source_text_checked":true,"word_agreement":0.722,"matched_words":52,"timing":"cached_word_anchors"},"song":"Кайен","artist":"Валентин Стрыкало","source_url":"https://lrclib.net/api/get/36523040","source_sha256":"85ade21370585046b3a3c7ecac19ff0049499ce23a8ad90b297b05f053d4410b"}
