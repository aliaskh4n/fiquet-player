{"version":3,"track_id":1075,"audio_sha256":"8db84627b64fac3c581b0520c5bf1bceb16bf2f2b681683a4f43a971c645f114","duration":120.324,"origin":"original_lyrics","status":"ready","lines":[{"start":0.72,"end":3.99,"text":"Волею-неволей бегаем по морю","source_line":0},{"start":3.99,"end":6.97,"text":"Голыми пятками по небу","source_line":1},{"start":6.97,"end":10.99,"text":"Стены, семафоры, серые заборы","source_line":2},{"start":10.99,"end":14.23,"text":"Всё это — мелочь и по фигу","source_line":3},{"start":14.23,"end":18.35,"text":"Мокрым поцелуем молнии рисуем","source_line":4},{"start":18.35,"end":21.33,"text":"И задыхаемся, как в бреду","source_line":5},{"start":21.79,"end":25.87,"text":"Грозы, хулиганы, люди, тараканы","source_line":6},{"start":25.87,"end":28.77,"text":"Нам это по фигу, по фигу","source_line":7},{"start":28.77,"end":34.09,"text":"Сегодня, и ты после фильма Кустурицы","source_line":8},{"start":34.09,"end":37.69,"text":"Шагаешь босиком по улице","source_line":9},{"start":37.69,"end":41.13,"text":"И если никто не простудится","source_line":10},{"start":41.13,"end":44.49,"text":"То всё пренепременно сбудется","source_line":11},{"start":44.49,"end":47.87,"text":"И ты, словно мокрая курица","source_line":12},{"start":47.87,"end":51.47,"text":"Шагаешь босиком по улице","source_line":13},{"start":51.47,"end":54.87,"text":"И если никто не простудится","source_line":14},{"start":54.87,"end":57.25,"text":"То всё пренепременно","source_line":15},{"start":57.25,"end":60.65,"text":"Целую неделю капают капели","source_line":16},{"start":60.65,"end":63.77,"text":"Прямо по темени, по фигу","source_line":17},{"start":63.77,"end":67.94000244140625,"text":"Льёт и тишина, мы сошли с ума","source_line":18},{"start":68.16,"end":70.57,"text":"Может быть, мы","source_line":19},{"start":71.17,"end":75.29,"text":"Курим сигареты только этим летом","source_line":20},{"start":75.29,"end":78.43,"text":"Без остановки и на бегу","source_line":21},{"start":78.43,"end":82.45,"text":"