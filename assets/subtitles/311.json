{"version":1,"track_id":311,"audio_sha256":"cd89b3eb90b19ac3ff99b4aff6b17f5a0cb27ee28af3df2e3648387893700cd5","duration":32.62,"language":"russian","status":"ready","lines":[{"start":0,"end":1.92,"text":"Сейчас пока буду включать спикеры."},{"start":1.88,"end":2.44,"text":"А,"},{"start":3.48,"end":6.54,"text":"зацените, что мне не нравится, я очень хочу,"},{"start":6.7,"end":7.42,"text":"чтобы он был питательный."},{"start":8.8,"end":9.42,"text":"Ай-яй-яй! Спортзал работает."},{"start":9.7,"end":10.8,"text":"В общем, да, это первое."},{"start":10.96,"end":11.28,"text":"Второе."},{"start":12.68,"end":14.14,"text":"Я не знаю, как включать."},{"start":14.46,"end":17.46,"text":"И ко мне вчера приставал китаец в поезде,"},{"start":17.58,"end":18.92,"text":"а ещё я выставила новую камеру, у меня"},{"start":18.92,"end":19.92,"text":"очень много новостей."},{"start":21.72,"end":24.44,"text":"Сейчас буду записывать песню, диджейть."},{"start":25.1,"end":26.22,"text":"Йоу, диджейт. Ла-ла-ла-ла-ла-ла."},{"start":28.02,"end":29.36,"text":"Ну нет, а нет."},{"start":29.36,"end":32.48,"text":"Школьник, на-на-на-на, школьник."}],"verification":{"independent_review":false,"word_agreement":0.955,"needs_chunk_review":false}}
