{"version":1,"track_id":449,"audio_sha256":"0e50997dc581531f10871c14b7987cf862b4bb6812fc50b0237bb42824a64762","duration":36.41,"language":"russian","status":"ready","lines":[{"start":0.52,"end":3.04,"text":"Бум! Ребята, всем привет, всем спокойной ночи сразу."},{"start":3.86,"end":5.2,"text":"Сегодня я не особо мелькала, так как я"},{"start":5.2,"end":9.28,"text":"гуляла, но… Господи, какое колечко мне подарили."},{"start":10.98,"end":11.8,"text":"Ну красивое, да?"},{"start":11.8,"end":11.92,"text":"Лайк."},{"start":12.8,"end":14.18,"text":"Лайк. И второе."},{"start":14.38,"end":15.98,"text":"Я люблю аниме."},{"start":16.52,"end":19.98,"text":"Вот. И мне подарили вот такую тяночку."},{"start":23.06,"end":25.28,"text":"А ещё завтра я буду делать фоточки, но"},{"start":25.28,"end":26.22,"text":"я не знаю, как."},{"start":26.24,"end":29.0,"text":"Учитывая то, что у меня вылезли прыщи…"},{"start":29.0,"end":29.8,"text":"Что это такое?"},{"start":29.8,"end":33.6,"text":"Вот завтра делаю фотки и подаюсь в модельное"},{"start":33.6,"end":34.06,"text":"агентство."},{"start":35.04,"end":35.42,"text":"Посмотрим."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
