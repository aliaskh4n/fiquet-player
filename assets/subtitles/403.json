{"version":1,"track_id":403,"audio_sha256":"512a18a49d7e6d9461e5df022c8ddd5f07fcefaadcec309dbb11024bc140edf2","duration":19.28,"language":"russian","status":"ready","lines":[{"start":0.64,"end":1.98,"text":"Ребята, всем привет!"},{"start":2.58,"end":3.5,"text":"Немножко вас посмотрю."},{"start":4.48,"end":6.38,"text":"Как думаете насчёт эфира в ТикТоке?"},{"start":7.18,"end":8.12,"text":"Стоит? Не стоит?"},{"start":9.6,"end":11.08,"text":"Мне страшно. Просто тогда оно не выходило."},{"start":11.24,"end":12.66,"text":"Но с другой стороны, я сегодня весь день"},{"start":12.66,"end":14.14,"text":"просто лежу и играю в Майнкрафт."},{"start":14.48,"end":15.38,"text":"Абсолютно ничего не делаю."},{"start":15.5,"end":16.5,"text":"И мне нечем заняться."},{"start":18.16,"end":19.14,"text":"Может быть, эфир?"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
