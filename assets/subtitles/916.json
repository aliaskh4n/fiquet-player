{"version":1,"track_id":916,"audio_sha256":"e91f448ccafef97f32feb7f9d12dba3e9e7896fd18136209538bc9ae3555a593","duration":39.67,"language":"russian","status":"ready","lines":[{"start":0,"end":2.36,"text":"Я люблю эту мудрую землю и всю нашу,"},{"start":4.12,"end":5.36,"text":"так что она разрослась во мне дерево."},{"start":7.86,"end":13.62,"text":"Чтобы кончики пальцев стали ею окрашены, чтобы ее"},{"start":13.62,"end":15.2,"text":"во мне не было."},{"start":19.08,"end":22.86,"text":"Ее храни, храни глубоко в себе, там ей"},{"start":22.86,"end":26.68,"text":"теплее и мягче, там она в своем белоснежном"},{"start":26.68,"end":31.3,"text":"белье тихо о счастье плачет, ее укрыть, ее"},{"start":31.52,"end":32.32,"text":"обнять, ее расстать."},{"start":37.92,"end":39.14,"text":"Дай бог я хватит."}],"verification":{"independent_review":true,"word_agreement":0.672,"review_model":"gpt-4o-transcribe","unanchored_words":19,"needs_chunk_review":false}}
