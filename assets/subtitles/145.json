{"version":1,"track_id":145,"audio_sha256":"bbc4541b0847013540a4a112b566732f6320a3da29cc22c781a3b7ba8ea8c98d","duration":18.89,"language":"russian","status":"ready","lines":[{"start":0,"end":2.88,"text":"Я не делала сигны только один раз в"},{"start":2.88,"end":4.38,"text":"жизни. Мне нужно сделать ник..."},{"start":4.38,"end":5.06,"text":"Вот, допустим,"},{"start":5.92,"end":8.3,"text":"есть ник Кошечка, условно говоря."},{"start":8.82,"end":10.56,"text":"Вот тут он высвечивается, когда пишет человечек."},{"start":10.68,"end":12.24,"text":"Ты заходишь к нему на профиль, и у"},{"start":12.24,"end":13.8,"text":"него собачка и другой ник."},{"start":14.12,"end":17.58,"text":"Какой из них нужно делать на сигну?"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
