{"version":1,"track_id":176,"audio_sha256":"9ba2cadccc83c26c1c29286047dddc667d2cb3bae98de84596bcda5b0aaeea26","duration":55.07,"language":"russian","status":"ready","lines":[{"start":17.82,"end":19.22,"text":"Шампанское"},{"start":30.0,"end":33.38,"text":"Мэйби в этом профи Я тут одна тренировалась,"},{"start":33.54,"end":37.27,"text":"не на помидорах Кручу, выпала на девочку напротив"},{"start":37.66,"end":39.26,"text":"Ну кому я не стесняюсь?"},{"start":39.6,"end":43.16,"text":"Детка, это очень просто, запомни Почему колотишь что-то"},{"start":43.68,"end":44.58,"text":"так под маечкой?"},{"start":44.72,"end":47.3,"text":"Я целовалась то раз, но так не умеют"},{"start":47.3,"end":51.04,"text":"мачать Мы все засмеялись и сразу же забыли"},{"start":51.04,"end":53.12,"text":"Но на-на-на-на-на-на-на я,"},{"start":54.06,"end":54.68,"text":"кажется, влюбилась"}],"verification":{"independent_review":false,"word_agreement":0.963,"needs_chunk_review":false}}
