{"version":1,"track_id":49,"audio_sha256":"bbb2c21a5459c958075b3a9ca2200014c83c9cc4c7db463fbf4a69352ef0067b","duration":19.94,"language":"russian","status":"ready","lines":[{"start":0,"end":2.0,"text":"Ну, или как вариант..."},{"start":5.36,"end":6.46,"text":"А, нет, блин."},{"start":6.58,"end":8.16,"text":"Я могу сделать новый аккаунт, и если туда"},{"start":8.16,"end":10.94,"text":"подпишутся, типа, 10 тысяч людей вроде, или тысячи,"},{"start":11.04,"end":12.5,"text":"то я могу выходить на эфире, но это"},{"start":12.5,"end":16.0,"text":"слишком запарно, и мне до 18 чуть-чуть совсем"},{"start":16.0,"end":16.18,"text":"ждать,"},{"start":18.04,"end":19.68,"text":"так что... Полгода без эфиров."}],"verification":{"independent_review":false,"word_agreement":0.978,"needs_chunk_review":false}}
