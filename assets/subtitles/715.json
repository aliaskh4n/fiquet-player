{"version":1,"track_id":715,"audio_sha256":"bed06518aff318c0e74d7c57b63b8d4706f041e21491a2212a222727003a8afd","duration":70.1,"language":"russian","status":"ready","lines":[{"start":0,"end":2.5,"text":"Смотрите, смотрите, что я придумала."},{"start":14.56,"end":19.84,"text":"Ой. Да. Ты смешна, кошечка, я разменяю картинки."},{"start":21.7,"end":26.12,"text":"Из твоих смешные стихи, рифты такие милые."},{"start":26.12,"end":28.4,"text":"Куришь сигарету, запиваешь энергетиком."},{"start":37.12,"end":41.34,"text":"Девочка, которая всегда будет подростком."},{"start":41.78,"end":46.56,"text":"Твои крашеные волосы, ты невысокая роста."},{"start":48.0,"end":52.2,"text":"Попробуешь любую дрянь, что запретила мама."},{"start":52.2,"end":57.12,"text":"Ты ссоришься с семьей, из которой ушел твой"},{"start":57.12,"end":57.78,"text":"папа."}],"verification":{"independent_review":true,"word_agreement":0.648,"review_model":"gpt-4o-transcribe","unanchored_words":19,"needs_chunk_review":false}}
