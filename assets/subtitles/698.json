{"version":1,"track_id":698,"audio_sha256":"dc47d2695e4d7b18d436fb212aca6d29ef484ec658706c26c2c968e5f31d9ec3","duration":58.95,"language":"russian","status":"ready","lines":[{"start":0,"end":2.32,"text":"Давайте так, момент истории."},{"start":2.44,"end":4.3,"text":"Я сейчас скажу поэтапно."},{"start":4.58,"end":5.16,"text":"Буду умываться."},{"start":5.92,"end":8.84,"text":"В общем, я же сделала себе новую татушку."},{"start":9.62,"end":10.08,"text":"Сейчас покажу."},{"start":11.72,"end":11.92,"text":"Сейчас."},{"start":12.9,"end":14.56,"text":"Ну ладно. Ухи так, пусть будет."},{"start":15.26,"end":16.74,"text":"Вот. Сделала себе новую."},{"start":17.84,"end":19.3,"text":"И я стою в магазине."},{"start":19.68,"end":20.56,"text":"Мы побежали с моей подругой."},{"start":20.68,"end":22.0,"text":"Нам нельзя, правда, из школы выходить."},{"start":22.7,"end":24.42,"text":"Ну, побежали в магазин за вкусняшками."},{"start":24.42,"end":28.18,"text":"И, ну, я стою на кассе, не падая."},{"start":28.96,"end":30.22,"text":"И Томушка стоит на кассе."},{"start":30.54,"end":31.34,"text":"Он на меня смотрит такой."},{"start":32.92,"end":35.24,"text":"Крутая тату. Я говорю, спасибо."},{"start":36.28,"end":38.14,"text":"Приятно. Ну, я же не буду сразу говорить,"},{"start":38.56,"end":39.82,"text":"ну, я её не делала."},{"start":40.16,"end":42.28,"text":"Я, на самом деле, просто приклеила."},{"start":42.54,"end":43.58,"text":"То есть это не настоящая тату."},{"start":43.9,"end":44.04,"text":"Зачем?"},{"start":45.06,"end":46.94,"text":"А потом он спрашивает, ну что, больно было"},{"start":46.94,"end":48.9,"text":"накалывать, да? Наверное, больно."},{"start":48.9,"end":51.94,"text":"Я такая, нет, нет, он не настоящий такой."},{"start":52.58,"end":56.02,"text":"Приспросил, он не поверил, насколько хорошо сделана."},{"start":56.34,"end":56.86,"text":"Ну вот, в общем, мини-история."}],"verification":{"independent_review":false,"word_agreement":0.993,"needs_chunk_review":false}}
