{"version":3,"track_id":807,"audio_sha256":"bc7eafe61cbdfc16a8afab94aab5af62d86a647ea2dad29381a89c0b3c85ea7b","duration":34.73,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":3.37,"text":"И я бросила школу: сожгла тетрадки и портфели","source_line":4},{"start":3.37,"end":6.6,"text":"Закурила сигарету, залила её портвейном","source_line":5},{"start":6.6,"end":9.0,"text":"Пьяная, полечу через забор","source_line":6},{"start":9.0,"end":11.87,"text":"Теперь достаточно крутая, чтобы быть с тобой?","source_line":7},{"start":11.87,"end":14.73,"text":"Я не слушаю взрослых, мне прощают всю юность","source_line":8},{"start":14.73,"end":17.48,"text":"Волосы — в розовый! Красота? Глупость","source_line":9},{"start":17.48,"end":20.3,"text":"Мы же дети уродливых серых многоэтажек","source_line":10},{"start":20.3,"end":22.95,"text":"Приглашаю на вписку, ничего не стесняюсь","source_line":11},{"start":22.95,"end":25.8,"text":"Ты меня ощущал ещё за километр","source_line":12},{"start":25.8,"end":28.74,"text":"И у тебя зима, у меня — запах сирени","source_line":13},{"start":28.74,"end":31.68,"text":"Помнишь, что ты сказал той самой звездной ночью?","source_line":14},{"start":31.68,"end":34.67,"text":"\"Тебе нужно стать плохой, если со мной быть хочешь\"","source_line":15}],"verification":{"source_text_checked":true,"word_agreement":0.658,"matched_words":50,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.609},"song":"Портвейн","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/9841798","source_sha256":"3e4bfed9db6c8799ddf35e6f44989062d2f39ddc359faa94cce072681785cf9c"}
