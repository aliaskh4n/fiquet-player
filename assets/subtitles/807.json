{"version":2,"track_id":807,"audio_sha256":"bc7eafe61cbdfc16a8afab94aab5af62d86a647ea2dad29381a89c0b3c85ea7b","duration":34.73,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.42,"text":"И я бросила школу: сожгла тетрадки и портфели","source_line":0},{"start":3.42,"end":5.88,"text":"Закурила сигарету, залила её портвейном","source_line":1},{"start":7.88,"end":9.1,"text":"Пьяная, полечу через забор","source_line":6},{"start":9.1,"end":11.92,"text":"Теперь достаточно крутая, чтобы быть с тобой?","source_line":7},{"start":11.92,"end":14.78,"text":"Я не слушаю взрослых, мне прощают всю юность","source_line":8},{"start":23.0,"end":25.24,"text":"Ты меня ощущал ещё за километр","source_line":12},{"start":25.9,"end":28.04,"text":"И у тебя зима, у меня — запах сирени","source_line":13},{"start":29.3,"end":31.42,"text":"Помнишь, что ты сказал той самой звездной ночью?","source_line":14}],"verification":{"source_text_checked":true,"word_agreement":0.658,"matched_words":50,"timing":"cached_word_anchors"},"song":"Портвейн","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/9841798","source_sha256":"3e4bfed9db6c8799ddf35e6f44989062d2f39ddc359faa94cce072681785cf9c"}
