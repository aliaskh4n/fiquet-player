{"version":1,"track_id":807,"audio_sha256":"bc7eafe61cbdfc16a8afab94aab5af62d86a647ea2dad29381a89c0b3c85ea7b","duration":34.73,"language":"russian","status":"ready","lines":[{"start":0,"end":3.42,"text":"Я бросила школу, сожгла все тетрадки, портфели."},{"start":3.42,"end":4.84,"text":"Закурила сигареты, зарила и портвейн."},{"start":7.24,"end":9.1,"text":"Я пьяная, полечу через забор."},{"start":10.86,"end":11.22,"text":"Я недостаточно крутая, чтобы быть старой акулой."},{"start":11.92,"end":13.54,"text":"Я не спущусь с роз, не прощаюсь с"},{"start":14.78,"end":15.66,"text":"юностью. Волосы в розовый, простота."},{"start":17.94,"end":18.22,"text":"Клупость, мы же дети уродливых, серых многоэтажек."},{"start":21.14,"end":22.4,"text":"Проглощенный в песку, ничего не стесняюсь."},{"start":23.0,"end":26.48,"text":"Ты меня ощущал еще за километрами у тебя"},{"start":26.48,"end":28.04,"text":"зима, у меня запах сирени."},{"start":29.3,"end":31.8,"text":"Помни, что ты сказал на самой звездной ночи."},{"start":31.8,"end":33.68,"text":"Тебе нужно стать плохой, если со мной плыть"},{"start":34.14,"end":34.48,"text":"хочешь."}],"verification":{"independent_review":true,"word_agreement":0.6,"review_model":"gpt-4o-transcribe","unanchored_words":32,"needs_chunk_review":false}}
