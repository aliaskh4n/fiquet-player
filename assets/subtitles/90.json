{"version":3,"track_id":90,"audio_sha256":"3d0a09118cb6d6386f944e7e9cd4245a286051244d41a5faf50e9c9a9dbe3e9f","duration":68.38,"origin":"original_lyrics","status":"ready","lines":[{"start":4.0,"end":7.75,"text":"Кис-кис, кис-кис, я котик, ты котик","source_line":0},{"start":7.86,"end":12.28,"text":"А твои поцелуи почти, как легкий наркотик","source_line":1},{"start":12.28,"end":16.11,"text":"Кис-кис, кис-кис, сегодня не приеду","source_line":2},{"start":16.54,"end":20.31,"text":"Я сильно обижусь, но остыну к обеду","source_line":3},{"start":21.86,"end":26.16,"text":"Ты хейтер котиков, но зовешь меня кошкой","source_line":4},{"start":26.16,"end":30.56,"text":"Ты сильно против наркотиков, я с подвернутой ножкой","source_line":5},{"start":30.56,"end":34.55,"text":"Вечер понедельника и сладкое вино","source_line":6},{"start":34.6,"end":39.939998626708984,"text":"Мы с тобой два бездельника, в твоих объятиях очень тепло","source_line":7},{"start":40.38,"end":44.05,"text":"Кис-кис, кис-кис, я котик, ты котик","source_line":8},{"start":44.18,"end":48.46,"text":"А твои поцелуи почти, как легкий наркотик","source_line":9},{"start":48.46,"end":52.2599983215332,"text":"Кис-кис, кис-кис, сегодня не приеду","source_line":10},{"start":52.68,"end":56.37,"text":"Я сильно обижусь, но остыну к обеду","source_line":11}],"verification":{"source_text_checked":true,"word_agreement":0.897,"matched_words":35,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.522},"song":"кискис","artist":"zhanulka","source_url":"https://lrclib.net/api/get/5084386","source_sha256":"37fad369783ce0204feccf3434e9bc1a466f985a7ced4f185ea7641297254fca"}
