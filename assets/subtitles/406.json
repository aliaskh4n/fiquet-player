{"version":1,"track_id":406,"audio_sha256":"f8c2f363092e7783945b55d46462963e78f9699c55d0aa48d54e13762ca0ce97","duration":57.15,"language":"russian","status":"ready","lines":[{"start":0,"end":1.2,"text":"Ребята, всем привет!"},{"start":1.62,"end":2.68,"text":"Будем снимать распаковку."},{"start":2.72,"end":7.02,"text":"Я заказала недавно очень крутые очки с eBay"},{"start":7.02,"end":9.58,"text":"и ждала их два месяца, и сейчас мы"},{"start":9.58,"end":11.22,"text":"будем их распаковывать, но я не могу найти"},{"start":11.22,"end":11.8,"text":"ножницы."},{"start":14.76,"end":15.94,"text":"Вот так они выглядят."},{"start":15.98,"end":17.8,"text":"Я очень надеюсь, что они не будут мне"},{"start":17.8,"end":20.02,"text":"большие или маленькие, что будут просто как раз."},{"start":20.12,"end":23.12,"text":"Потому что в eBay, что сложно, когда заказываешь,"},{"start":23.3,"end":25.36,"text":"никогда не знаешь, какого качества это будет и"},{"start":25.36,"end":27.96,"text":"так далее. Но вроде по размеру нормально."},{"start":28.2,"end":29.0,"text":"Размер тоже не указать."},{"start":29.0,"end":32.46,"text":"Я надеюсь, тут нет силы."},{"start":32.46,"end":34.82,"text":"Ну вот знаете, когда плохое зрение, допустим, плюс"},{"start":34.82,"end":35.66,"text":"два, плюс три."},{"start":42.14,"end":44.06,"text":"Так они выглядят."},{"start":55.08,"end":56.8,"text":"Я ждала, что они лучше сядут."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
