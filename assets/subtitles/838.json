{"version":2,"track_id":838,"audio_sha256":"2fe622f24c1e43a218c0be8c5db250ebd88c310041fdf0ca798fc0bda2e2b1a2","duration":34.97,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.32,"text":"Тебе тоже противно от себя самого","source_line":6},{"start":3.32,"end":5.62,"text":"Поцелуй на прощанье","source_line":7},{"start":5.98,"end":8.1,"text":"И дай обещанье","source_line":8},{"start":8.1,"end":10.16,"text":"Мы встретимся дома","source_line":9},{"start":10.16,"end":12.28,"text":"В Киеве, в мае","source_line":10},{"start":12.28,"end":17.72,"text":"Я бы могла писать портреты, жить ради кого-то","source_line":11},{"start":17.72,"end":20.52,"text":"Знать где я проснусь завтра и не бежать от чего-то","source_line":12},{"start":23.0,"end":27.44,"text":"Делить сигареты, честно любить идиота","source_line":36},{"start":27.44,"end":32.68,"text":"Спать и не бояться, не ждать конца эпизода","source_line":37}],"verification":{"source_text_checked":true,"word_agreement":0.98,"matched_words":50,"timing":"cached_word_anchors"},"song":"портреты (Acoustic)","artist":"zhanulka","source_url":"https://lrclib.net/api/get/10715069","source_sha256":"2d4979bf4fc585105e6fdf3ae518964f5f73a3d0617fb4cd61e97823aa19d940"}
