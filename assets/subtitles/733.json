{"version":2,"track_id":733,"audio_sha256":"723e71fa816ed6358b735859c5cd3426b2ce6d6e699915f1bf612e0fae8a0620","duration":61.6,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":5.38,"text":"Бесконечные слёзы (хм), незакрытые травмы (хм)","source_line":1},{"start":5.38,"end":10.4,"text":"Всё оставлю тебе, ведь я мужчина","source_line":2},{"start":10.4,"end":15.32,"text":"Мне звонил твой психолог (хм), чуть от счастья не плакал (м)","source_line":3},{"start":15.32,"end":19.0,"text":"Он купил себе дом, жене — машину","source_line":4},{"start":19.58,"end":24.54,"text":"Я, ты — две судьбы, что одной стать не смогли","source_line":5},{"start":24.88,"end":26.96,"text":"Ты, я — больше не семья","source_line":6},{"start":29.4,"end":37.64,"text":"Пустой вокзал нам шепчет, что я стану завтра никем для тебя","source_line":7},{"start":38.32,"end":47.28,"text":"Но где-то через вечность напишу внезапно: \"Привет, как дела?\"","source_line":8},{"start":48.24,"end":49.58,"text":"Эй, детка, как дела?","source_line":9}],"verification":{"source_text_checked":true,"word_agreement":0.806,"matched_words":54,"timing":"cached_word_anchors"},"song":"ПУСТОЙ ВОКЗАЛ","artist":"MORGENSHTERN","source_url":"https://lrclib.net/api/get/35509491","source_sha256":"bddb3b0bdc9c8dd9360e15c651145e0b3e69e2b5edeef61389d415c412237533"}
