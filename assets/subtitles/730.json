{"version":1,"track_id":730,"audio_sha256":"9ddd612882759ca8c313e399a2449a765c2d05d1f156751a80f9d1d913bf3bfd","duration":23.26,"language":"russian","status":"ready","lines":[{"start":0,"end":2.46,"text":"Записывал вам сейчас кавер, потом зашла на аккаунт"},{"start":2.46,"end":2.96,"text":"Goldar"},{"start":4.22,"end":6.68,"text":"Если кто не знает, тоже кавер-мейкер, она очень"},{"start":6.68,"end":8.66,"text":"крутая. В общем, зашла к ней в канал,"},{"start":8.88,"end":10.72,"text":"и там была вкладка подарки."},{"start":10.78,"end":12.22,"text":"Я не поняла, я зашла, там у неё"},{"start":12.22,"end":14.32,"text":"подарки были. Я зашла к себе, открыла, у"},{"start":14.32,"end":15.76,"text":"меня тоже подарки, оказывается, есть!"},{"start":16.24,"end":18.44,"text":"Я не благодарила этого, но сейчас поблагодарю всех!"},{"start":18.54,"end":19.7,"text":"Спасибо! Четыре подарка, по-моему."},{"start":20.5,"end":21.14,"text":"Спасибо вам всем!"},{"start":21.26,"end":22.72,"text":"Очень приятно! Я очень рада!"}],"verification":{"independent_review":false,"word_agreement":0.972,"needs_chunk_review":false}}
