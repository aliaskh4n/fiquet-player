{"version":1,"track_id":994,"audio_sha256":"7c3a4b9d29daaf75949dd422f0b93c7c424778418a154a273a613d430b3e817c","duration":36.11,"language":"russian","status":"ready","lines":[{"start":0,"end":1.46,"text":"Так, чтобы наглядно было."},{"start":1.96,"end":3.36,"text":"В общем, у нас есть две части боя."},{"start":6.02,"end":7.42,"text":"Вниз-вниз, это первая часть, а потом"},{"start":10.04,"end":10.58,"text":"вверх-вверх-вверх-вниз-вверх-вниз-вверх. Умничьего, конечно."},{"start":11.18,"end":14.58,"text":"Как мы apply этот бой на аккорды?"},{"start":14.94,"end":16.04,"text":"Зажимаем F, как я показала."},{"start":17.36,"end":19.38,"text":"Раз, два."},{"start":20.82,"end":21.4,"text":"Зажимаем G. Вверх-вверх-вверх-вверх-вниз-вверх-вниз-вверх."},{"start":24.06,"end":24.74,"text":"Так и будет."},{"start":34.32,"end":35.32,"text":"Здесь понятно."}],"verification":{"independent_review":false,"word_agreement":0.87,"needs_chunk_review":false}}
