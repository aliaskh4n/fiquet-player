{"version":1,"track_id":765,"audio_sha256":"e1d96621f29d65179c2d279783f9ba1249d1f2d555aa54ef95921e407adad528","duration":57.31,"language":"russian","status":"ready","lines":[{"start":0,"end":1.82,"text":"И пришло... Ну, сейчас к самому интересному."},{"start":2.48,"end":3.02,"text":"Бежала я домой,"},{"start":3.9,"end":5.68,"text":"мне много кто написал, я всем ответила, всё"},{"start":5.68,"end":9.22,"text":"было good. Потом пришло время к ресторану."},{"start":10.1,"end":11.06,"text":"Мы пришли в ресторан,"},{"start":11.86,"end":12.06,"text":"сели,"},{"start":12.76,"end":13.02,"text":"кушали,"},{"start":14.5,"end":17.56,"text":"и в какой-то момент мы уже начали собираться,"},{"start":18.52,"end":20.0,"text":"и просто со всей силы"},{"start":21.08,"end":22.44,"text":"запах гария,"},{"start":23.34,"end":25.2,"text":"мотоцикл врезался в машину,"},{"start":26.2,"end":29.1,"text":"и человек в шлеме протаранил нашу дверь."},{"start":30.44,"end":31.8,"text":"Прямо перед моим входом."},{"start":32.76,"end":35.68,"text":"Это вот сразу после того, как..."},{"start":35.68,"end":38.06,"text":"Здесь ресторанчики очень милые, и мама, оказывается, заранее"},{"start":38.06,"end":39.28,"text":"сказала им, что это мой день рождения."},{"start":39.42,"end":40.8,"text":"Они принесли мне тортик со свечей."},{"start":41.98,"end":44.0,"text":"Там они пели, официантки,"},{"start":44.82,"end":45.56,"text":"то есть полкафе."},{"start":46.0,"end":48.1,"text":"И после этого где-то 10 минут"},{"start":49.28,"end":52.54,"text":"вот это происходит, и человек просто протаранил головой"},{"start":52.54,"end":52.9,"text":"дверь."},{"start":53.98,"end":56.88,"text":"Дверь распахнулась, и это был шок для меня."}],"verification":{"independent_review":false,"word_agreement":0.983,"needs_chunk_review":false}}
