{"version":1,"track_id":836,"audio_sha256":"b6e8825ea99c4b78a0986007a71ad6f8a8ff308b7cda78ea2ad6bc7fcda6a684","duration":25.57,"language":"russian","status":"ready","lines":[{"start":0,"end":0.78,"text":"Так что, ребята,"},{"start":1.64,"end":2.84,"text":"попью чаёк и с вами поболтаю."},{"start":2.96,"end":7.52,"text":"А пока что, пока я не допилю вот"},{"start":7.52,"end":10.52,"text":"это видео, я не могу делать разборы одновременно,"},{"start":10.58,"end":13.18,"text":"поэтому я допилю это видео, скорее всего, сегодня."},{"start":13.34,"end":14.2,"text":"И сегодня ночью выложу."},{"start":14.38,"end":15.5,"text":"Но у вас это будет уже утром."},{"start":16.08,"end":20.0,"text":"Вот. Допилю, а потом разом выложу все разборы."},{"start":20.32,"end":20.96,"text":"Получается так."},{"start":24.28,"end":25.2,"text":"Что это было?"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
