{"version":1,"track_id":828,"audio_sha256":"f2b3b81647ab44c7fd400ba19b6a9ad0c674e3d7d26e79f0ea0e28c24690d691","duration":28.14,"language":"russian","status":"ready","lines":[{"start":0.84,"end":2.28,"text":"Окей, я казашка."},{"start":2.86,"end":6.36,"text":"Сейчас расскажу полностью историю, чтобы никто ничего не"},{"start":6.36,"end":9.32,"text":"путал больше. Я казашка, родилась в Казахстане, в"},{"start":9.76,"end":11.28,"text":"Алма-Ате, жила в Казахстане очень много лет."},{"start":12.0,"end":14.1,"text":"Вот. И на этом году переехала в Англию"},{"start":14.1,"end":14.74,"text":"на обучение."},{"start":16.54,"end":17.16,"text":"Жила в Кыргынде,"},{"start":17.92,"end":19.48,"text":"в Тимиртау, в Астане."},{"start":19.82,"end":21.52,"text":"Последний год, кстати, в Астане."},{"start":23.1,"end":23.24,"text":"Всё."},{"start":24.94,"end":25.76,"text":"Нет, где-то я ещё жила."},{"start":26.0,"end":27.3,"text":"Ну короче, я очень много где жила в"},{"start":27.3,"end":27.52,"text":"Казахстане."}],"verification":{"independent_review":false,"word_agreement":0.968,"needs_chunk_review":false}}
