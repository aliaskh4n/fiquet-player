source_text_checked":true,"word_agreement":0.635,"matched_words":47,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.514},"song":"Ночной ларёк","artist":"Монеточка","source_url":"https://lrclib.net/api/get/23977588","source_sha256":"2d4900fa71d42a46e86c7be447fd61da91d73395f9873016a08b1e55fdc5abdc"}
