{"version":1,"track_id":984,"audio_sha256":"82aefa961fdcdbf7024ff2951e56c8335297cf54a869c387346295eabf97daab","duration":53.28,"language":"russian","status":"ready","lines":[{"start":0,"end":1.7,"text":"Окей, сейчас в общем."},{"start":1.84,"end":3.0,"text":"Рассказываю план действия."},{"start":3.32,"end":4.44,"text":"Я выучила биологию."},{"start":7.6,"end":9.22,"text":"Окей, я выучила биологию."},{"start":9.56,"end":12.64,"text":"Сейчас я буду снимать, по-моему, просили разбор на"},{"start":12.64,"end":15.04,"text":"Новакейн и Тайна Кокоа."},{"start":15.68,"end":17.78,"text":"Не забывай. А сейчас я ещё вам покажу"},{"start":17.78,"end":19.26,"text":"тату, которую я хочу сделать."},{"start":20.16,"end":21.04,"text":"Вы скажете, какая лучше."},{"start":22.3,"end":22.96,"text":"Есть вот эта."},{"start":23.58,"end":25.94,"text":"Но я не принадлежу к христианству, поэтому я"},{"start":25.94,"end":27.08,"text":"не знаю, стоит набивать или нет."},{"start":27.18,"end":28.68,"text":"Но на этой тату мне ничего не остановило,"},{"start":28.68,"end":30.08,"text":"то тоже крест был."},{"start":30.32,"end":31.76,"text":"Поэтому вот. Есть вот эта."},{"start":32.08,"end":34.02,"text":"Но минус этих змей в том, что они"},{"start":34.02,"end":35.46,"text":"дико липкие, и они стираются."},{"start":35.56,"end":37.06,"text":"Вот у меня уже это стерлось полностью."},{"start":37.36,"end":39.5,"text":"Сейчас я вам покажу татушки, которые могу сделать"},{"start":39.5,"end":40.48,"text":"на шею крупную."},{"start":41.0,"end":41.8,"text":"Вот такая есть."},{"start":42.0,"end":43.28,"text":"Но мне кажется, она слишком мужская."},{"start":43.46,"end":44.74,"text":"Ну, какая-то броска."},{"start":47.88,"end":49.68,"text":"Окей, я нашла ту, которую я буду делать."},{"start":50.08,"end":52.74,"text":"Вот спойлер. Ну ладно, я все покажу сейчас."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
