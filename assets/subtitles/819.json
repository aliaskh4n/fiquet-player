{"version":2,"track_id":819,"audio_sha256":"0f74bf9880c367237b0da28afd55feecef00e9dc85f6ec91e962ee3d4f0f0a44","duration":40.47,"origin":"original_lyrics","status":"ready","lines":[{"start":0.78,"end":3.38,"text":"Я спасу тебя от одиночества","source_line":33},{"start":3.68,"end":6.88,"text":"Но я не знаю как мне сохранить себя","source_line":35},{"start":7.84,"end":10.56,"text":"Быть может это всё когда-нибудь закончится","source_line":37},{"start":10.84,"end":13.38,"text":"И ты не кончишь со мной больше никогда","source_line":39},{"start":14.4,"end":17.72,"text":"Но я отдам тебе отдельный угол памяти","source_line":41},{"start":17.92,"end":20.16,"text":"В моей травмированной детской голове","source_line":43},{"start":21.78,"end":24.08,"text":"Нас окружают монстры бесконечной зависти","source_line":45},{"start":25.28,"end":28.06,"text":"Но я привык к тебе уже даже во сне","source_line":47}],"verification":{"source_text_checked":true,"word_agreement":0.821,"matched_words":46,"timing":"cached_word_anchors"},"song":"Я уёбываю в джаз","artist":"Кишлак","source_url":"https://mychords.net/ru/kishlak/228287-kishlak-ya-uyebyvayu-v-dzhaz.html","source_sha256":"669d916f31babbe1a12a140292de41a9ff1b8f2454f2b7bceed49f3d98fa6360"}
