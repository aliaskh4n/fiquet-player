{"version":3,"track_id":819,"audio_sha256":"0f74bf9880c367237b0da28afd55feecef00e9dc85f6ec91e962ee3d4f0f0a44","duration":40.47,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":3.41,"text":"Я спасу тебя от одиночества","source_line":16},{"start":3.5,"end":6.880000114440918,"text":"Но я не знаю как мне сохранить себя","source_line":17},{"start":7.12,"end":10.69,"text":"Быть может это всё когда-нибудь закончится","source_line":18},{"start":10.79,"end":13.53,"text":"И ты не кончишь со мной больше никогда","source_line":19},{"start":14.3,"end":17.78,"text":"Но я отдам тебе отдельный угол памяти","source_line":20},{"start":17.78,"end":21.05,"text":"В моей травмированной детской голове","source_line":21},{"start":21.54,"end":25.09,"text":"Нас окружают монстры бесконечной зависти","source_line":22},{"start":25.16,"end":28.17,"text":"Но я привык к тебе уже даже во сне","source_line":23}],"verification":{"source_text_checked":true,"word_agreement":0.821,"matched_words":46,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.691},"song":"Я уёбываю в джаз","artist":"Кишлак","source_url":"https://mychords.net/ru/kishlak/228287-kishlak-ya-uyebyvayu-v-dzhaz.html","source_sha256":"be76e9c6645ca068f04cc0f2dc9b1e921ccd74be9ec9fa2911d113fe26f1e199"}
