{"version":1,"track_id":819,"audio_sha256":"0f74bf9880c367237b0da28afd55feecef00e9dc85f6ec91e962ee3d4f0f0a44","duration":40.47,"language":"russian","status":"ready","lines":[{"start":0,"end":4.32,"text":"Я спасу себя от одиночества, но я не"},{"start":4.32,"end":6.88,"text":"знаю, как мне сохранить себя."},{"start":7.36,"end":11.3,"text":"Ведь может все это когда-нибудь закончится, и ты"},{"start":11.3,"end":13.38,"text":"не кончишься мной больше никогда."},{"start":14.4,"end":18.16,"text":"Но я отдам себе отдельный угол памяти в"},{"start":18.16,"end":20.16,"text":"моей драме, рано в детской коллабе."},{"start":21.78,"end":26.04,"text":"Нас окружают монстры бесконечных зависти, но я привык"},{"start":26.04,"end":28.06,"text":"к тебе уже даже во сне."}],"verification":{"independent_review":true,"word_agreement":0.833,"review_model":"gpt-4o-transcribe","unanchored_words":9,"needs_chunk_review":false}}
