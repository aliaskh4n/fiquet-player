{"version":3,"track_id":220,"audio_sha256":"997b402d306b99590226ca7775ffb26f1be0200cdb377f6965d09413e5df59b0","duration":94.25999999999999,"origin":"original_lyrics","status":"ready","lines":[{"start":15.89,"end":18.86,"text":"Делай вопреки, делай от руки","source_line":0},{"start":18.86,"end":22.91,"text":"Мир переверни, небо опрокинь","source_line":1},{"start":29.95,"end":33.17,"text":"В каждом наброске, в каждом черновике","source_line":2},{"start":33.17,"end":37.0,"text":"Учитель продолжается в своём ученике","source_line":3},{"start":42.82,"end":45.13,"text":"Всю мою жизнь я иду ко дну","source_line":4},{"start":45.13,"end":50.19,"text":"Всю мою жизнь я искал любовь, чтобы любить одну (одну)","source_line":5},{"start":55.57,"end":59.24,"text":"Они сказали, нас поздно спасать и поздно лечить","source_line":6},{"start":59.24,"end":61.09,"text":"Плевать, ведь наши дети будут лучше, чем мы","source_line":7},{"start":61.09,"end":66.4800033569336,"text":"Лучше, чем мы, лучше, чем мы","source_line":8},{"start":66.85,"end":74.69999694824219,"text":"Когда меня не станет, я буду петь голосами","source_line":9},{"start":75.9,"end":81.03,"text":"Моих детей и голосами их детей","source_line":10},{"start":81.03,"end":84.15,"text":"Нас просто меняют местами","source_line":11},{"start":84.72,"end":92.32,"text":"Таков закон Сансары — круговорот людей","source_line":12},{"start":92.32,"end":93.59,"text":"Ой, мама","source_line":13}],"verification":{"source_text_checked":true,"word_agreement":0.883,"matched_words":68,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.484},"song":"Сансара","artist":"Merab Amzoevi","source_url":"https://lrclib.net/api/get/16516518","source_sha256":"9f9529760bd702a4101369447797090c5f7e8fe7a6f9c4ca1867a92ee11c682f"}
