{"version":2,"track_id":220,"audio_sha256":"997b402d306b99590226ca7775ffb26f1be0200cdb377f6965d09413e5df59b0","duration":94.25999999999999,"origin":"original_lyrics","status":"ready","lines":[{"start":15.94,"end":18.96,"text":"Делай вопреки, делай от руки","source_line":0},{"start":19.2,"end":21.64,"text":"Мир переверни, небо опрокинь","source_line":1},{"start":30.0,"end":32.16,"text":"В каждом наброске, в каждом черновике","source_line":2},{"start":33.22,"end":37.0,"text":"Учитель продолжается в своём ученике","source_line":3},{"start":42.87,"end":45.18,"text":"Всю мою жизнь я иду ко дну","source_line":4},{"start":45.18,"end":49.56,"text":"Всю мою жизнь я искал любовь, чтобы любить одну (одну)","source_line":5},{"start":59.42,"end":63.12,"text":"Плевать, ведь наши дети будут лучше, чем мы","source_line":7},{"start":66.9,"end":74.7,"text":"Когда меня не станет, я буду петь голосами","source_line":9},{"start":76.1,"end":81.08,"text":"Моих детей и голосами их детей","source_line":10},{"start":84.78,"end":91.36,"text":"Таков закон Сансары — круговорот людей","source_line":17}],"verification":{"source_text_checked":true,"word_agreement":0.883,"matched_words":68,"timing":"cached_word_anchors"},"song":"Сансара","artist":"Merab Amzoevi","source_url":"https://lrclib.net/api/get/16516518","source_sha256":"9f9529760bd702a4101369447797090c5f7e8fe7a6f9c4ca1867a92ee11c682f"}
