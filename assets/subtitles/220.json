{"version":1,"track_id":220,"audio_sha256":"997b402d306b99590226ca7775ffb26f1be0200cdb377f6965d09413e5df59b0","duration":94.25999999999999,"language":"russian","status":"ready","lines":[{"start":0,"end":0.94,"text":"У меня настроение сейчас на саруспеете."},{"start":15.94,"end":18.96,"text":"Делай вопреки, делай от руки, бурь впереди, не"},{"start":30.0,"end":33.92,"text":"палапреки. В каждом наброске, в каждом черновике учитель"},{"start":35.14,"end":37.0,"text":"продолжается в своем ученике."},{"start":43.68,"end":45.18,"text":"Все мое жизнь я иду ко дну, все"},{"start":46.1,"end":49.56,"text":"мое жизнь я искал любовь, чтобы любить одну."},{"start":55.62,"end":59.84,"text":"Они сказали нам поздно спасать поздно, лечить плевать,"},{"start":59.9,"end":61.64,"text":"ведь наши дети будут лучше,"},{"start":62.52,"end":63.12,"text":"чем мы,"},{"start":64.1,"end":66.48,"text":"лучше, чем мы."},{"start":66.9,"end":67.5,"text":"Когда они будут лучше, чем мы."},{"start":77.4,"end":78.9,"text":"Воините, река во сне летите и просыпаетесь."},{"start":89.26,"end":93.46,"text":"Круговорот людей, ой, мама."}],"verification":{"independent_review":true,"word_agreement":0.59,"review_model":"gpt-4o-transcribe","unanchored_words":34,"needs_chunk_review":false}}
