{"version":1,"track_id":768,"audio_sha256":"07a1983ce276431341e55511a0330b9fd7e4151b92ee5d5e0deffca70544090d","duration":17.2,"language":"russian","status":"ready","lines":[{"start":0,"end":0.98,"text":"Ещё знаете, что я хочу?"},{"start":1.1,"end":3.9,"text":"У меня... О, прикольный ресницык."},{"start":4.74,"end":8.38,"text":"Короче, я фанат Беляриш, я обожаю Беляриш, и..."},{"start":8.38,"end":9.46,"text":"Вышел же татур на её мейк."},{"start":9.88,"end":12.14,"text":"И говорят, что подходит голубым глазам, поэтому..."},{"start":12.14,"end":14.06,"text":"Я не умею краситься, но попробую."},{"start":15.72,"end":16.88,"text":"И скину сюда результаты."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
