{"version":1,"track_id":815,"audio_sha256":"6686d0339487d3cfe11ce2951c7f5580b311c3a9fb27590e662c1593edd68272","duration":34.17,"language":"russian","status":"ready","lines":[{"start":0,"end":1.2,"text":"Ребята, всем привет!"},{"start":1.32,"end":1.88,"text":"Всем спокойной ночи!"},{"start":2.0,"end":3.34,"text":"Сейчас я буду делать вам разбор и записывать"},{"start":3.34,"end":4.92,"text":"хайлайн завтра. Но!"},{"start":5.42,"end":10.44,"text":"Я записала сейчас липсинг просто…"},{"start":10.44,"end":12.16,"text":"Я такого в жизни не видела ни у"},{"start":12.16,"end":14.48,"text":"кого. Этот липсинг вышел идеальным."},{"start":14.84,"end":16.54,"text":"Моя камера сама как будто сделала монтаж, но"},{"start":16.54,"end":17.52,"text":"на самом деле я просто вот так вот"},{"start":17.52,"end":17.9,"text":"рукой делала."},{"start":18.92,"end":20.82,"text":"Короче, но вы всё спите, поэтому сейчас я"},{"start":20.82,"end":22.46,"text":"его кладу не буду, но завтра я выложу."},{"start":23.36,"end":24.92,"text":"Прошу оценить, проявить какой-то актив, потому что мне"},{"start":24.92,"end":26.92,"text":"кажется, у этого ролика есть потенциал залететь."},{"start":27.88,"end":28.18,"text":"Есть."},{"start":29.14,"end":29.62,"text":"Я надеюсь."},{"start":30.84,"end":32.6,"text":"Ну, круто вышел, да."},{"start":32.64,"end":33.94,"text":"Всё. Всем спокойной ночи!"}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
