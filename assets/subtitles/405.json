{"version":1,"track_id":405,"audio_sha256":"839052cefcf7fc2a9ced2ed9274f8965badb0cd7db062cb4a1a5e5014ad32d49","duration":68.01,"language":"russian","status":"ready","lines":[{"start":0,"end":1.68,"text":"Йоу, йоу, щас чё на вид покажу."},{"start":4.08,"end":5.76,"text":"Извиняюсь за гитару."},{"start":6.38,"end":7.48,"text":"Она чуть поплыла у меня."},{"start":7.8,"end":8.76,"text":"Ну, ногти, сами понимаете."},{"start":10.28,"end":15.6,"text":"Руки целовал, носил на руках, жадно обнимал."},{"start":16.22,"end":17.82,"text":"Говорил, что не отдашь."},{"start":17.92,"end":20.98,"text":"Я видела, как ты вдруг подружился с милой"},{"start":20.98,"end":25.34,"text":"девочкой. Кофточки и рукавка лапят братишки из першки."},{"start":25.78,"end":29.16,"text":"Был вдруг подозрительным, мы стали много общаться."},{"start":29.2,"end":32.12,"text":"Ты вроде был в сети, но предпочел мне"},{"start":32.12,"end":33.12,"text":"отписаться."},{"start":33.96,"end":37.64,"text":"Написала всем подругам, что мы часто ссоримся."},{"start":38.26,"end":41.44,"text":"Описала самых лучших долбаным нартисам."},{"start":44.64,"end":45.56,"text":"Ла-ла-ла-ла-ла-ла-ла-ла-ла да-да-да-да нам нравится."},{"start":46.88,"end":48.7,"text":"Ну, чисто слова впихнула."},{"start":49.28,"end":52.38,"text":"Мама спрашивает, как я, а я плачу по"},{"start":52.38,"end":54.7,"text":"ночам. После школы пишу песни,"},{"start":55.5,"end":59.76,"text":"пересчитываю шаг. Не гадают мои сестры и расклады"},{"start":59.76,"end":61.18,"text":"так звучат."},{"start":62.42,"end":63.86,"text":"Так звучат. Та-ра-та."}],"verification":{"independent_review":false,"word_agreement":0.955,"needs_chunk_review":false}}
