{"version":1,"track_id":26,"audio_sha256":"e4144d69e6112b60a8b457ce25c8950274a4598c81c6ecfa62d259b8e0733fe3","duration":21.4,"language":"russian","status":"ready","lines":[{"start":0,"end":3.86,"text":"На битве немного беру буду, ты чистая, залитая,"},{"start":4.0,"end":7.54,"text":"но я не забуду день, когда мы встретились"},{"start":7.54,"end":8.58,"text":"с тобой."},{"start":11.74,"end":14.8,"text":"Поцарапайся бритвой, заставь мыть посуду, я не кто-то,"},{"start":15.4,"end":17.56,"text":"я не ты, но я не забуду день,"},{"start":18.12,"end":20.38,"text":"когда мы встретились с тобой."}],"verification":{"independent_review":false,"word_agreement":0.974,"needs_chunk_review":false}}
