{"version":1,"track_id":842,"audio_sha256":"07d23ae914c2e246f8d899f46a75f49331d50ee2e7e596909b3f7b517ceedee8","duration":54.74,"language":"russian","status":"ready","lines":[{"start":0.96,"end":6.06,"text":"Мне давно уже за двадцать, мои котятрики замужем,"},{"start":6.06,"end":9.7,"text":"плодятся со мной, ведь там мне пора остепениться,"},{"start":9.74,"end":12.36,"text":"я почти нашла супруга, но уже в пятый"},{"start":12.36,"end":13.04,"text":"раз его уходит подруга."},{"start":15.28,"end":16.94,"text":"Я останусь одна,"},{"start":18.62,"end":22.82,"text":"заведу десять кошек, буду вечно пьяна, я останусь"},{"start":22.82,"end":28.46,"text":"одна, да свидание хорошему не надо стонать, я"},{"start":28.46,"end":29.62,"text":"останусь одна,"},{"start":31.58,"end":35.62,"text":"заведу десять кошек, буду вечно пьяна, я останусь"},{"start":35.62,"end":40.2,"text":"одна, мне в награду стена и тишина,"},{"start":41.06,"end":41.26,"text":"тишина,"},{"start":42.12,"end":42.32,"text":"тишина."}],"verification":{"independent_review":true,"word_agreement":0.864,"review_model":"gpt-4o-transcribe","unanchored_words":9,"needs_chunk_review":false}}
