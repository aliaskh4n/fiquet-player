{"version":1,"track_id":673,"audio_sha256":"6da83aa31c3a5bcdb79c90f5805ab4da3373844732ac924c2214190e394548f9","duration":29.2,"language":"russian","status":"ready","lines":[{"start":0,"end":1.82,"text":"Ребята, ой, почему я как яйцо?"},{"start":1.96,"end":2.8,"text":"Почему у меня камера такая?"},{"start":3.22,"end":4.28,"text":"Я сейчас буду плакать."},{"start":4.58,"end":6.36,"text":"В общем, я пытаюсь вам записать песню, полную"},{"start":6.36,"end":9.04,"text":"версию на Свидери Гайла «Как пахнет твое запястье»."},{"start":9.04,"end":11.56,"text":"Но, вот, я хочу извлечь аудио, да?"},{"start":11.72,"end":12.94,"text":"Звуки как... Вот, послушайте."},{"start":17.72,"end":18.2,"text":"Вот!"},{"start":20.58,"end":22.66,"text":"Я не понимаю, что за звуки."},{"start":22.76,"end":24.64,"text":"Я же... Видео их нет, я не знаю,"},{"start":25.36,"end":28.3,"text":"как... Я не знаю, как извлечь аудио из"},{"start":28.3,"end":28.9,"text":"этого видео."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
