{"version":1,"track_id":1057,"audio_sha256":"690f50230c420e7e79c5ea8a6d23914e3f5861f9a0b7f90c1d744f8ec68609bf","duration":13.92,"language":"russian","status":"ready","lines":[{"start":0,"end":2.9,"text":"В общем, друзья, кто-то у меня просил разговорное"},{"start":2.9,"end":5.18,"text":"видео выставить, и плюс, кто я такая, откуда"},{"start":5.18,"end":6.98,"text":"я вот в этом видео записала."},{"start":7.1,"end":8.34,"text":"Сейчас буду выставлять видео."},{"start":8.46,"end":10.64,"text":"Если есть какие-то вопросы, напишите, пожалуйста, я задам"},{"start":10.64,"end":12.2,"text":"ещё одно видео и отвечу на все вопросы,"},{"start":12.24,"end":13.24,"text":"которые вы зададите."}],"verification":{"independent_review":false,"word_agreement":0.956,"needs_chunk_review":false}}
