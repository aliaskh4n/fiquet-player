{"version":1,"track_id":983,"audio_sha256":"b72a1a7a8c742b33ef1f4c8c6fa8e97dcb598675b87be4b6a9e5c91114d05d2e","duration":33.92,"language":"russian","status":"ready","lines":[{"start":0,"end":2.0,"text":"Так, я поняла, что мне будет удобнее голосовать,"},{"start":2.1,"end":3.22,"text":"поэтому сейчас буду объяснять."},{"start":3.74,"end":5.24,"text":"Играем, как я уже показала."},{"start":16.88,"end":19.2,"text":"Вот это сыграли, и потом вниз-вниз-вниз."},{"start":25.84,"end":29.42,"text":"Ну вот, просто, я думаю, многим было непонятно."},{"start":30.0,"end":30.92,"text":"Читать бумажки,"},{"start":31.72,"end":33.62,"text":"поэтому вот так вот живо вам показала."}],"verification":{"independent_review":false,"word_agreement":0.975,"needs_chunk_review":false}}
