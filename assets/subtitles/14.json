{"version":1,"track_id":14,"audio_sha256":"292d175b20b49dbaef3ebede32b984630f616c67b3811551d7810baa6e2c0e78","duration":21.52,"language":"russian","status":"ready","lines":[{"start":0,"end":2.94,"text":"Кстати, я не знаю, может делать больше контента"},{"start":2.94,"end":4.88,"text":"про себя, как бы там всякие..."},{"start":6.16,"end":9.38,"text":"Ну, знаете, маски там расставлять, допустим, к чему"},{"start":9.38,"end":10.34,"text":"бы я ревновала, то-сё."},{"start":11.46,"end":13.46,"text":"Я пыталась это записывать пару раз, но это"},{"start":13.46,"end":15.26,"text":"вышло кринжово, и я не стала это выкладывать."},{"start":15.42,"end":16.64,"text":"Может постараться ещё раз?"},{"start":16.8,"end":18.14,"text":"Вам бы было интереснее тогда?"},{"start":19.28,"end":21.22,"text":"По-моему, да. Мне бы точно было интереснее."}],"verification":{"independent_review":false,"word_agreement":0.966,"needs_chunk_review":false}}
