{"version":1,"track_id":841,"audio_sha256":"9c5386e9604188db0e2270b2325402e966cd041a7e53f9682006d04d97f3b5c2","duration":15.24,"language":"russian","status":"ready","lines":[{"start":0.62,"end":2.54,"text":"Сосхелп. Мне купила мама очки."},{"start":3.14,"end":5.64,"text":"Я поносила их буквально день."},{"start":5.94,"end":7.3,"text":"И всё, я не могу себя..."},{"start":8.0,"end":10.48,"text":"Я даже не день поносила, я месяц поносила."},{"start":10.66,"end":10.86,"text":"Я не могу..."},{"start":10.86,"end":11.74,"text":"Ой, какой месяц?"},{"start":12.04,"end":13.78,"text":"Час. Я без них уже не могу себя"},{"start":13.78,"end":14.54,"text":"воспринимать."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
