{"version":3,"track_id":851,"audio_sha256":"538421593d3cfd26fece8e88173d2db46c1859490438be2a1e47a30775ef4493","duration":52.3,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":5.22,"text":"Пока ты листаешь книжки, я листаю мемы","source_line":0},{"start":5.22,"end":9.39,"text":"У меня пакет винишка, у тебя - проблемы","source_line":1},{"start":9.39,"end":14.0,"text":"Ты болтаешь о любви, а я ногой болтаю","source_line":2},{"start":14.0,"end":18.459999084472656,"text":"Ты мечтаешь поступить, я умереть мечтаю","source_line":3},{"start":18.55,"end":22.89,"text":"Лай-лай-лай, ты сойди с ума, а я схожу за пивом","source_line":4},{"start":22.93,"end":27.17,"text":"Лай-лай-лай, знаю сохнешь по мне, как в саду крапива","source_line":5},{"start":27.17,"end":31.79,"text":"Лай-лай-лай, любишь ты, когда делают больно-больно","source_line":6},{"start":31.79,"end":36.29,"text":"Лай-лай-лай, хочешь быть со мной, значит будь прикольным","source_line":7},{"start":36.29,"end":40.55,"text":"Лай-лай-лай, лай-лай-лай","source_line":8},{"start":40.55,"end":44.71,"text":"Лай-лай-лай, лай-лай-лай","source_line":9},{"start":44.71,"end":51.63,"text":"Ты отдал своё пальто, позволил мне согреться","source_line":10}],"verification":{"source_text_checked":true,"word_agreement":0.804,"matched_words":78,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.377},"song":"мемы","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/8592877","source_sha256":"21f93fab672e564e0bcb14e1c608b3f841286a0973e7ea5db76c1e1c5368222b"}
