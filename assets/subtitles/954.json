{"version":3,"track_id":954,"audio_sha256":"dba668467634df4a88654dc4848409c73f02d994ed7294e028c5b9a18627c0ae","duration":51.96,"origin":"original_lyrics","status":"ready","lines":[{"start":3.0,"end":7.95,"text":"Ты опять в телефоне ищешь сообщения шлюх, пока сплю","source_line":12},{"start":7.95,"end":12.75,"text":"Ты опять их находишь, будишь и орёшь, все нервы к нулю","source_line":13},{"start":13.03,"end":18.73,"text":"Среди кресел, столов и полок, посуда в пол, я тебя ловлю","source_line":14},{"start":18.73,"end":23.18000030517578,"text":"Ты снова прощаешь всё, а руки говорят: \"Я люблю\"","source_line":15},{"start":23.97,"end":28.11,"text":"Я опять с самолёта в самолёт, в поезда","source_line":16},{"start":29.78,"end":33.73,"text":"Ты опять в переезде 5 часов, не устав","source_line":17},{"start":33.73,"end":38.71,"text":"Я с дороги в дом, ты туда же, всё в привычных цветах","source_line":18},{"start":39.33,"end":43.85,"text":"Ты опять оторвёшь, не удержав, я люблю","source_line":19},{"start":44.09,"end":48.92,"text":"Ещё одной тёмной ночью (каждый твой вдох)","source_line":20},{"start":48.92,"end":51.96,"text":"И каждый твой выдох (кричит об одном)","source_line":21}],"verification":{"source_text_checked":true,"word_agreement":0.662,"matched_words":49,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.367},"song":"Это любовь","artist":"Cкриптoнит","source_url":"https://lrclib.net/api/get/36289311","source_sha256":"e6c45b77c89da93cac54b72dad2922a615820ce5821c9736331a8b57c7cc6625"}
