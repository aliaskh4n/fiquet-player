{"version":1,"track_id":896,"audio_sha256":"52d9c5f11a309d9c7b53b2b91e50e91aaff97c38244703b782090aaba15050b0","duration":48.94,"language":"russian","status":"ready","lines":[{"start":0,"end":0.9,"text":"Всем доброе утро."},{"start":1.04,"end":1.62,"text":"Я только встала."},{"start":2.02,"end":2.8,"text":"Вот так вот."},{"start":2.8,"end":3.5,"text":"Протрянулась немножко."},{"start":4.52,"end":5.74,"text":"Первое. Что я хочу обратить."},{"start":5.92,"end":7.5,"text":"Вы видите эту кофту?"},{"start":7.76,"end":8.88,"text":"И я её заказала недавно."},{"start":9.44,"end":9.52,"text":"Второе."},{"start":10.32,"end":12.48,"text":"Стукнула 100к. Я только недавно вспомнила."},{"start":12.6,"end":14.4,"text":"В закреплённых у меня есть кружочек, где я"},{"start":14.4,"end":16.34,"text":"говорю, что будет какой-то розыгрыш, какая-то посылочка"},{"start":16.34,"end":19.24,"text":"победившему. Я вот думаю, я устрою розыгрыш."},{"start":20.26,"end":21.34,"text":"Но как его устроить?"},{"start":21.96,"end":23.76,"text":"Типа, я особо в этом не шарю."},{"start":23.9,"end":27.26,"text":"Как я планировала, это сказать, допустим, самый красивый"},{"start":27.26,"end":29.04,"text":"рисуночек меня, for example."},{"start":29.62,"end":29.98,"text":"И вот, например, у меня был такой рисунок,"},{"start":29.98,"end":30.18,"text":"который"},{"start":31.28,"end":34.22,"text":"скинули. Я бы устроила голосование в чате, типа,"},{"start":34.32,"end":35.44,"text":"какой рисуночек лучше."},{"start":35.96,"end":38.04,"text":"Рисунок первый, рисунок второй, рисунок третий."},{"start":38.44,"end":39.46,"text":"Мне кажется, это хорошая идея."},{"start":39.66,"end":41.68,"text":"Потому что единственный минус — не все умеют"},{"start":41.68,"end":42.12,"text":"рисовать."},{"start":43.62,"end":46.62,"text":"Я не знаю, на какой счёт устроить как"},{"start":46.62,"end":48.26,"text":"бы соревнование. У вас есть какие-то идеи?"}],"verification":{"independent_review":false,"word_agreement":0.97,"needs_chunk_review":false}}
