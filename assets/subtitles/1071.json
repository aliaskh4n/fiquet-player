{"version":3,"track_id":1071,"audio_sha256":"baafe1a5d992b52e99a976dc6844a335e6bea7e86f1ba787bc00e0d40f3fe336","duration":154.751,"origin":"original_lyrics","status":"ready","lines":[{"start":1.39,"end":4.32,"text":"Ты моё первое сентября","source_line":0},{"start":4.32,"end":5.34,"text":"Ты сильно пахнущий","source_line":1},{"start":5.34,"end":7.62,"text":"Спиртом забытый маркер","source_line":2},{"start":7.62,"end":9.76,"text":"И сколько не пытались разделить учителя","source_line":3},{"start":9.76,"end":12.51,"text":"Мы все сидели за одной партой","source_line":4},{"start":12.7,"end":16.97,"text":"Мама скажет так нельзя","source_line":5},{"start":17.42,"end":21.81,"text":"Для неё мы лишь друзья","source_line":6},{"start":21.86,"end":23.47,"text":"А за спиной все твердят","source_line":7},{"start":23.47,"end":24.76,"text":"О том, что ты так плохо","source_line":8},{"start":24.76,"end":27.04,"text":"Очень плохо на меня влияешь","source_line":9},{"start":27.04,"end":29.16,"text":"И руки пахнут табаком, но","source_line":10},{"start":29.16,"end":32.47,"text":"Лучше их меня ничто не согревает","source_line":11},{"start":32.56,"end":37.46,"text":"Черный блеск твоих ногтей","source_line":12},{"start":37.46,"end":42.35,"text":"Я влюбляюсь всё сильней","source_line":13},{"start":44.88,"end":47.09,"text":"В кабинете у директора","source_line":14},{"start":47.09,"end":49.55,"text":"Я целую всем назло тебя","source_line":15},{"start":49.8,"end":52.22,"text":"Разом все учителя кричат","source_line":16},{"start":52.22,"end":54.21,"text":"Завтра нас наверно исключат","source_line":17},{"start":54.21,"end":56.43,"text":"В кабинете у директора","source_line":18},{"start":56.43,"end":59.220001220703125,"text":"Я целую всем назло тебя","source_line":19},{"start":59.36,"end":61.86,"text":"Завтра выложат в интернет","source_line":20},{"start":61.86,"end":70.51,"text":"Маме передай привет","source_line":21},{"start":72.81,"end":75.36,"text":"И на экскурсии мы сбежим","source_line":22},{"start":75.36,"end":76.24,"text":"И будем за руку","source_line":23},{"start":76.24,"end":78.52,"text":"Гулять по пустому лесу","source_line":24},{"start":78.52,"end":80.22,"text":"А я тобой просто одержим","source_line":25},{"start":80.22,"end":83.76000213623047,"text":"Ты моя бледная софт-гранж принцесса","source_line":26},{"start":83.78,"end":88.43,"text":"Кровью напишу тебе","source_line":27},{"start":88.43,"end":92.76,"text":"Комплимент на зеркале","source_line":28},{"start":92.76,"end":95.12,"text":"Я помню жар от твоих волос","source_line":29},{"start":95.12,"end":95.92,"text":"И на одно плечо","source_line":30},{"start":95.92,"end":98.33,"text":"Надетую наспех блузку","source_line":31},{"start":98.42,"end":100.63,"text":"Большой портфель, охапка роз","source_line":32},{"start":100.68,"end":103.4000015258789,"text":"И ты не девушка, ты — искусство","source_line":33},{"start":103.54,"end":108.58,"text":"Пламенем сиял спортзал","source_line":34},{"start":108.58,"end":115.21,"text":"Все они ответят нам","source_line":35},{"start":115.21,"end":117.83,"text":"В кабинете у директора","source_line":36},{"start":117.83,"end":120.34,"text":"Я целую всем назло тебя","source_line":37},{"start":120.34,"end":123.14,"text":"Разом все учителя кричат","source_line":38},{"start":123.14,"end":125.24,"text":"Завтра нас наверно исключат","source_line":39},{"start":125.24,"end":127.57,"text":"В кабинете у директора","source_line":40},{"start":127.57,"end":129.99,"text":"Я целую всем назло тебя","source_line":41},{"start":129.99,"end":132.8,"text":"Завтра выложат в интернет","source_line":42},{"start":132.8,"end":153.07,"text":"Маме передай привет","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.705,"matched_words":134,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.346},"song":"В кабинете у директора","artist":"Алёна Швец","source_url":"https://www.mysongs.pro/sh/shvec-alena/alena-shvec-v-kabinete-u-direktora.html","source_sha256":"1cd9e54895c5197dd79fe637b8f08b6f77845faaaa34bfbc86cc5e1ca6a2a3f4"}
