{"version":2,"track_id":1071,"audio_sha256":"baafe1a5d992b52e99a976dc6844a335e6bea7e86f1ba787bc00e0d40f3fe336","duration":154.751,"origin":"original_lyrics","status":"ready","lines":[{"start":10.16,"end":12.38,"text":"Мы все сидели за одной партой","source_line":4},{"start":13.46,"end":16.82,"text":"Мама скажет так нельзя","source_line":5},{"start":17.88,"end":21.72,"text":"Для неё мы лишь друзья","source_line":6},{"start":22.34,"end":23.52,"text":"А за спиной все твердят","source_line":7},{"start":23.52,"end":24.78,"text":"О том, что ты так плохо","source_line":8},{"start":25.14,"end":27.04,"text":"Очень плохо на меня влияешь","source_line":9},{"start":29.52,"end":32.38,"text":"Лучше их меня ничто не согревает","source_line":11},{"start":33.2,"end":37.68,"text":"Черный блеск твоих ногтей","source_line":12},{"start":38.42,"end":42.34,"text":"Я влюбляюсь всё сильней","source_line":13},{"start":44.98,"end":47.14,"text":"В кабинете у директора","source_line":14},{"start":50.4,"end":52.12,"text":"Разом все учителя кричат","source_line":16},{"start":52.38,"end":54.26,"text":"Завтра нас наверно исключат","source_line":17},{"start":54.26,"end":56.48,"text":"В кабинете у директора","source_line":18},{"start":59.92,"end":61.9,"text":"Завтра выложат в интернет","source_line":20},{"start":62.6,"end":65.3,"text":"Маме передай привет","source_line":21},{"start":72.86,"end":75.38,"text":"И на экскурсии мы сбежим","source_line":22},{"start":75.68,"end":76.44,"text":"И будем за руку","source_line":23},{"start":76.44,"end":78.58,"text":"Гулять по пустому лесу","source_line":24},{"start":78.58,"end":80.26,"text":"А я тобой просто одержим","source_line":25},{"start":80.4,"end":83.76,"text":"Ты моя бледная софт-гранж принцесса","source_line":26},{"start":86.22,"end":88.48,"text":"Кровью напишу тебе","source_line":27},{"start":88.48,"end":92.7,"text":"Комплимент на зеркале","source_line":28},{"start":93.16,"end":95.18,"text":"Я помню жар от твоих волос","source_line":29},{"start":101.0,"end":103.4,"text":"И ты не девушка, ты — искусство","source_line":33},{"start":115.26,"end":117.88,"text":"В кабинете у директора","source_line":36},{"start":121.3,"end":122.8,"text":"Разом все учителя кричат","source_line":38},{"start":123.24,"end":125.34,"text":"Завтра нас наверно исключат","source_line":39},{"start":126.2,"end":127.62,"text":"В кабинете у директора","source_line":40},{"start":133.52,"end":138.78,"text":"Маме передай привет","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.705,"matched_words":134,"timing":"cached_word_anchors"},"song":"В кабинете у директора","artist":"Алёна Швец","source_url":"https://www.mysongs.pro/sh/shvec-alena/alena-shvec-v-kabinete-u-direktora.html","source_sha256":"1cd9e54895c5197dd79fe637b8f08b6f77845faaaa34bfbc86cc5e1ca6a2a3f4"}
