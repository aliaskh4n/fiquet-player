{"version":1,"track_id":507,"audio_sha256":"043c1b5571bf79c4bce9edc89ddac6ddf750734366df372fdaf5dc07b73d2905","duration":21.79,"language":"russian","status":"ready","lines":[{"start":0,"end":1.44,"text":"Заново. Идём к комбику."},{"start":2.14,"end":3.68,"text":"Рассказываю, как тут всё."},{"start":4.76,"end":8.0,"text":"Гейн у нас на максимум, драфт подключён, волюм"},{"start":8.0,"end":9.64,"text":"на минимум, чтобы не так громко."},{"start":10.36,"end":11.66,"text":"Трэмпл... Я не знаю, за что отвечать, мы"},{"start":11.66,"end":12.08,"text":"просто здесь."},{"start":13.92,"end":15.46,"text":"Мидл... Так, посередине."},{"start":16.1,"end":18.1,"text":"Ну, мидл не так важно, а бас у"},{"start":18.1,"end":21.32,"text":"нас на максимум прокачан на этом комбике, поэтому..."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
