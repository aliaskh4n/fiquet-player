{"version":1,"track_id":874,"audio_sha256":"8dd6d8bc9bb7584b0a6de771af86283fdcc088e0b0a43edd21e1d9627b9aa39a","duration":21.74,"language":"russian","status":"ready","lines":[{"start":0,"end":2.68,"text":"Так ещё, сама будучи ребёнком, я нашла кучу"},{"start":2.68,"end":6.32,"text":"фоточек, где я мелкая, и сейчас скину сюда"},{"start":6.32,"end":6.82,"text":"одно видео."},{"start":7.72,"end":10.14,"text":"Я там вела свой типа блог,"},{"start":11.04,"end":12.34,"text":"и я начинаю…"},{"start":12.34,"end":14.26,"text":"Ну ладно, сейчас скину, короче, видео с себя"},{"start":14.26,"end":18.82,"text":"мелкой. Будете знать, какая я была мили…"},{"start":18.82,"end":20.8,"text":"микро… микро."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
