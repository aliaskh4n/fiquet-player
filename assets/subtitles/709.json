{"version":1,"track_id":709,"audio_sha256":"0deb1144050d0d43725c468424a24857b8fbb8db54108663bdd3d9a6c57f43c7","duration":59.66,"language":"russian","status":"ready","lines":[{"start":0,"end":3.48,"text":"Вначале я покажу вот такую звёздочку, она из"},{"start":3.48,"end":6.56,"text":"лунного камня, и практически всё я купила в"},{"start":6.56,"end":6.9,"text":"Амазоне."},{"start":8.8,"end":11.22,"text":"Вот такая. Я её раньше очень часто носила."},{"start":11.92,"end":12.36,"text":"Потом."},{"start":15.54,"end":17.02,"text":"Вот, что я ношу сейчас."},{"start":18.38,"end":20.94,"text":"Мне безумно нравится сама идея, мне кажется, это"},{"start":20.94,"end":22.06,"text":"безумно красивое украшение."},{"start":23.68,"end":26.98,"text":"Это мне подарок на день рождения, и…"},{"start":26.98,"end":28.0,"text":"Спой, я тебя не люблю."},{"start":28.0,"end":29.38,"text":"Так, окей, не отвлекаемся."},{"start":30.38,"end":32.76,"text":"Это то ли Westfield, то ли Westwood,"},{"start":33.76,"end":36.78,"text":"но что-то такое крутое и дорогое."},{"start":37.04,"end":37.12,"text":"Да."},{"start":40.14,"end":42.22,"text":"Потом, моя любимая цепочка."},{"start":43.14,"end":44.96,"text":"Она очень длинная, но мне она тем и"},{"start":44.96,"end":46.16,"text":"нравится, она выглядит необычно."},{"start":46.72,"end":47.48,"text":"Ну, прямо сейчас, наверное."},{"start":48.86,"end":51.8,"text":"Я её купила во Франции, поэтому, к сожалению,"},{"start":52.18,"end":53.96,"text":"мне кажется, её нельзя будет достать."},{"start":56.12,"end":58.18,"text":"Вот так вот."},{"start":59.18,"end":59.28,"text":"Далее."}],"verification":{"independent_review":false,"word_agreement":0.991,"needs_chunk_review":false}}
