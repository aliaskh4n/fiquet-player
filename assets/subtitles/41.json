{"version":1,"track_id":41,"audio_sha256":"48b0a81f8d43f24a7e9bf501ae903ade171ec46ff0a6daf51f433b7af39d07ee","duration":28.7,"language":"russian","status":"ready","lines":[{"start":0,"end":3.64,"text":"И это абсурд, мне же не шестнадцать, чтобы"},{"start":4.96,"end":6.72,"text":"по кому-то так не убиваться."},{"start":7.0,"end":9.6,"text":"Просто показалось, нет, я не признаюсь."},{"start":9.84,"end":12.8,"text":"Чувствую ладонью, агрессивно огрызаюсь."},{"start":12.8,"end":14.12,"text":"Это так и было, просто-просто делась."},{"start":15.96,"end":18.92,"text":"Сразу отвечаю, нет, конечно, не влюбилась."},{"start":19.88,"end":21.84,"text":"То моё отпустит, то моя отвяжусь."},{"start":22.3,"end":25.02,"text":"Вот бы проглотить ещё таблетку от грусти."}],"verification":{"independent_review":true,"word_agreement":0.75,"review_model":"gpt-4o-transcribe","unanchored_words":12,"needs_chunk_review":false}}
