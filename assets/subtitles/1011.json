{"version":3,"track_id":1011,"audio_sha256":"9629482af44b51ec17dc394c1c70cde7ddfb73ef65e1d10d68b1f164ec62acc0","duration":152.54,"origin":"original_lyrics","status":"ready","lines":[{"start":1.73,"end":4.3,"text":"Откуда ты тут взялась?","source_line":2},{"start":4.3,"end":8.1,"text":"Классные шортики — бывшие джинсы Levi's","source_line":3},{"start":8.1,"end":9.69,"text":"Простой макияж","source_line":4},{"start":9.69,"end":16.05,"text":"Пахнешь как первый ландыш, тебя не буду срывать","source_line":5},{"start":16.07,"end":19.87,"text":"Откуда ты тут взялась? Оу","source_line":6},{"start":19.87,"end":26.19,"text":"Пахнешь как первый ландыш, тебя не буду срывать","source_line":7},{"start":26.57,"end":30.23,"text":"Подумал о тебе — и пошёл снег","source_line":8},{"start":30.23,"end":33.13,"text":"Холода нас греют: ближе к семье","source_line":9},{"start":33.13,"end":36.23,"text":"Всюду суета эта, где нас нет","source_line":10},{"start":36.23,"end":39.21,"text":"Новые текста, но не о тебе","source_line":11},{"start":39.21,"end":42.62,"text":"Хлопья летят наверх","source_line":12},{"start":42.62,"end":45.15,"text":"Всюду магия и свет","source_line":13},{"start":45.15,"end":48.68,"text":"Ты чё тут одна? Привет","source_line":14},{"start":48.68,"end":51.54,"text":"Пойдём на парад планет","source_line":15},{"start":51.54,"end":52.66,"text":"Пойдём на парад планет","source_line":23},{"start":52.66,"end":55.1,"text":"Я дам тебе тёплый шарф","source_line":24},{"start":55.1,"end":58.0,"text":"Там в космосе холода","source_line":25},{"start":58.0,"end":61.39,"text":"И мы встречаем рассвет","source_line":26},{"start":61.5,"end":64.88999938964844,"text":"Укутавшись в облака","source_line":27},{"start":76.56,"end":83.28,"text":"Новая эра любви, новая жизнь. Выбери ты","source_line":28},{"start":83.28,"end":87.74,"text":"Что-то родное до боли, но мы не знакомы","source_line":29},{"start":87.74,"end":91.72,"text":"Хочу целовать тебя снова и снова","source_line":30},{"start":91.72,"end":98.66,"text":"Эти уютные дни. Падают хлопья, и с ними мы","source_line":31},{"start":98.66,"end":102.12999725341797,"text":"Медленно тают, как наш поцелуй","source_line":32},{"start":102.46,"end":106.33000183105469,"text":"Медленно тают все наши мечты","source_line":33},{"start":107.72,"end":111.06,"text":"Хлопья летят наверх","source_line":35},{"start":111.06,"end":113.78,"text":"Всюду магия и свет","source_line":36},{"start":113.78,"end":117.36,"text":"Ты чё тут одна? Привет","source_line":37},{"start":117.36,"end":120.02,"text":"Пойдём на парад планет","source_line":38},{"start":120.02,"end":124.06,"text":"Я дам тебе тёплый шарф","source_line":39},{"start":124.06,"end":127.22,"text":"Там в космосе холода","source_line":40},{"start":127.22,"end":130.88,"text":"И мы встречаем рассвет","source_line":41},{"start":130.88,"end":134.41000366210938,"text":"Укутавшись в облака","source_line":42},{"start":146.6,"end":151.11,"text":"Откуда ты тут взялась?","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.92,"matched_words":150,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.445},"song":"FEDUK","artist":"Хлопья летят наверх","source_url":"https://lrclib.net/api/get/14645313","source_sha256":"200e55a1b6fcfed21247f3c4ff0424312ddef0e91564d42ced7844b6928e5cc8"}
