{"version":2,"track_id":1011,"audio_sha256":"9629482af44b51ec17dc394c1c70cde7ddfb73ef65e1d10d68b1f164ec62acc0","duration":152.54,"origin":"original_lyrics","status":"ready","lines":[{"start":1.78,"end":4.32,"text":"Откуда ты тут взялась?","source_line":2},{"start":4.38,"end":7.3,"text":"Классные шортики — бывшие джинсы Levi's","source_line":3},{"start":8.36,"end":9.72,"text":"Простой макияж","source_line":4},{"start":9.74,"end":15.96,"text":"Пахнешь как первый ландыш, тебя не буду срывать","source_line":5},{"start":16.12,"end":19.5,"text":"Откуда ты тут взялась? Оу","source_line":6},{"start":19.92,"end":24.94,"text":"Пахнешь как первый ландыш, тебя не буду срывать","source_line":7},{"start":26.62,"end":30.28,"text":"Подумал о тебе — и пошёл снег","source_line":8},{"start":30.28,"end":33.18,"text":"Холода нас греют: ближе к семье","source_line":9},{"start":33.18,"end":36.28,"text":"Всюду суета эта, где нас нет","source_line":10},{"start":37.9,"end":39.26,"text":"Новые текста, но не о тебе","source_line":11},{"start":39.26,"end":41.94,"text":"Хлопья летят наверх","source_line":12},{"start":42.7,"end":45.2,"text":"Всюду магия и свет","source_line":13},{"start":45.2,"end":48.46,"text":"Ты чё тут одна? Привет","source_line":14},{"start":48.46,"end":50.95,"text":"Пойдём на парад планет","source_line":15},{"start":51.57,"end":53.87,"text":"Я дам тебе тёплый шарф","source_line":16},{"start":55.41,"end":58.05,"text":"Там в космосе холода","source_line":17},{"start":58.05,"end":61.29,"text":"И мы встречаем рассвет","source_line":18},{"start":61.55,"end":64.89,"text":"Укутавшись в облака","source_line":19},{"start":76.61,"end":83.39,"text":"Новая эра любви, новая жизнь. Выбери ты","source_line":28},{"start":83.39,"end":87.87,"text":"Что-то родное до боли, но мы не знакомы","source_line":29},{"start":87.87,"end":91.77,"text":"Хочу целовать тебя снова и снова","source_line":30},{"start":91.77,"end":98.71,"text":"Эти уютные дни. Падают хлопья, и с ними мы","source_line":31},{"start":98.71,"end":102.13,"text":"Медленно тают, как наш поцелуй","source_line":32},{"start":102.51,"end":106.33,"text":"Медленно тают все наши мечты","source_line":33},{"start":107.77,"end":111.11,"text":"Хлопья летят наверх","source_line":35},{"start":111.11,"end":113.83,"text":"Всюду магия и свет","source_line":36},{"start":113.83,"end":117.19,"text":"Ты чё тут одна? Привет","source_line":37},{"start":117.41,"end":120.07,"text":"Пойдём на парад планет","source_line":38},{"start":120.07,"end":122.79,"text":"Я дам тебе тёплый шарф","source_line":39},{"start":124.21,"end":127.27,"text":"Там в космосе холода","source_line":40},{"start":127.27,"end":130.07,"text":"И мы встречаем рассвет","source_line":41},{"start":131.61,"end":134.41,"text":"Укутавшись в облака","source_line":42},{"start":146.65,"end":151.09,"text":"Откуда ты тут взялась?","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.92,"matched_words":150,"timing":"cached_word_anchors"},"song":"FEDUK","artist":"Хлопья летят наверх","source_url":"https://lrclib.net/api/get/14645313","source_sha256":"200e55a1b6fcfed21247f3c4ff0424312ddef0e91564d42ced7844b6928e5cc8"}
