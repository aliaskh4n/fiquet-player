{"version":1,"track_id":1011,"audio_sha256":"9629482af44b51ec17dc394c1c70cde7ddfb73ef65e1d10d68b1f164ec62acc0","duration":152.54,"language":"russian","status":"ready","lines":[{"start":1.78,"end":4.32,"text":"Откуда ты тут взялась?"},{"start":9.74,"end":13.76,"text":"Пахнешь, как первый ландыш тебя я не буду"},{"start":13.76,"end":19.5,"text":"срывать. Откуда ты тут взялась?"},{"start":19.92,"end":23.72,"text":"Пахнешь, как первый ландыш тебя я не буду"},{"start":23.72,"end":24.94,"text":"срывать."},{"start":26.62,"end":31.02,"text":"Подумал о тебе и пошел снег, холода на"},{"start":31.4,"end":31.94,"text":"степь ближе к зиме."},{"start":33.18,"end":34.6,"text":"Всюду суета, а тогда на снег."},{"start":37.9,"end":40.8,"text":"Но у этих стананий о тебе хлопья летят"},{"start":40.8,"end":41.94,"text":"наверх."},{"start":42.7,"end":45.2,"text":"Всюду магия и свет."},{"start":45.2,"end":47.12,"text":"Ты что тут одна,"},{"start":48.46,"end":50.95,"text":"привет. Пойдем на парад планет."},{"start":51.57,"end":55.05,"text":"Я там тебе теплый шар, там вкус мыслей"},{"start":56.51,"end":63.21,"text":"холода. И мы встречаем рассвет, укутывшись в облаках."},{"start":76.61,"end":81.47,"text":"Новая эра любви, новая жизнь."},{"start":81.51,"end":86.69,"text":"Выбери ты что-то родное да более, но мы"},{"start":86.69,"end":91.77,"text":"не знакомы. Хочу целовать тебя снова и снова."},{"start":91.77,"end":97.53,"text":"Эти уютные дни падают хлопья и с ними"},{"start":97.53,"end":102.13,"text":"мы. Медленно тают, как наш поцелуй."},{"start":102.51,"end":106.33,"text":"Медленно тают все наши мечты."},{"start":107.77,"end":111.11,"text":"Хлопья летят наверх."},{"start":111.11,"end":113.83,"text":"Всюду магия и свет."},{"start":113.83,"end":115.93,"text":"Ты что тут одна,"},{"start":117.19,"end":120.07,"text":"привет. Пойдем на парад планет."},{"start":120.07,"end":123.49,"text":"Я там тебе теплый шар, там вкус мыслей"},{"start":125.49,"end":134.41,"text":"холода. И мы встречаем рассвет, укутывшись в облаках."},{"start":146.65,"end":151.09,"text":"Откуда ты тут взялась?"}],"verification":{"independent_review":true,"word_agreement":0.789,"review_model":"gpt-4o-transcribe","unanchored_words":35,"needs_chunk_review":false}}
