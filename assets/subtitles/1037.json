{"version":1,"track_id":1037,"audio_sha256":"26d68df5beb5d3fb0481ca1d9f1c863e5a8779739860d25f2995ece8d0f53622","duration":17.58,"language":"russian","status":"ready","lines":[{"start":0,"end":2.4,"text":"Ещё хотелось спросить тех, кто разбирается, мне очень"},{"start":2.4,"end":4.02,"text":"надо узнать, но я не знаю, просто не"},{"start":4.02,"end":5.72,"text":"различаю, какая у меня форма лица, маски на"},{"start":5.72,"end":8.06,"text":"ТТ не работают, не подходят, мне ничто там"},{"start":8.06,"end":10.42,"text":"не подходит, вы не знаете, какая это форма"},{"start":10.42,"end":11.28,"text":"лица?"},{"start":12.56,"end":14.28,"text":"Это ромб? Нет, не ромб."},{"start":14.66,"end":15.52,"text":"Как там называлось?"},{"start":15.84,"end":16.48,"text":"Вот такого, тын-тын-тын."}],"verification":{"independent_review":false,"word_agreement":0.981,"needs_chunk_review":false}}
