{"version":1,"track_id":710,"audio_sha256":"4a52f7aa780f8d8e20aab31525b8dc27874635a10d0b4974f31e1fe4943017f3","duration":58.47,"language":"russian","status":"ready","lines":[{"start":0,"end":0.88,"text":"Далее."},{"start":2.6,"end":6.24,"text":"Вот такой у меня есть из Лабрадорита, если"},{"start":6.24,"end":7.14,"text":"я не ошибаюсь."},{"start":7.68,"end":9.98,"text":"Вот. Почему я сказала «не ошибаюсь»?"},{"start":10.14,"end":10.7,"text":"Окей, ладно."},{"start":13.06,"end":15.34,"text":"Я его раньше очень раз носила, его можно"},{"start":15.34,"end":17.3,"text":"заметить в моих каверах давних."},{"start":22.98,"end":23.66,"text":"Дальше-дальше. Что у меня ещё есть?"},{"start":24.92,"end":27.2,"text":"У меня есть такой розовый кварт с драконом."},{"start":27.2,"end":29.46,"text":"Он мне безумно нравится, но он просто не"},{"start":29.46,"end":31.66,"text":"особо подходит под мои вещи."},{"start":33.34,"end":34.48,"text":"Давай, фокусируйся,"},{"start":36.0,"end":39.66,"text":"фокусируйся. Вот такого дракончика получается."},{"start":42.04,"end":44.12,"text":"Ох, господи, что ещё у меня есть?"},{"start":44.7,"end":45.5,"text":"У меня есть кольца."},{"start":45.78,"end":48.28,"text":"Я вам сейчас все-все-все покажу."},{"start":57.34,"end":58.34,"text":"Кручка не хватает."}],"verification":{"independent_review":false,"word_agreement":0.977,"needs_chunk_review":false}}
