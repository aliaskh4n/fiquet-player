{"version":1,"track_id":618,"audio_sha256":"98871f76391ca440ecc3c6301c5d221e8c0ea16b7e2e8819c807e7901ae3bc01","duration":46.42,"language":"russian","status":"ready","lines":[{"start":0,"end":1.84,"text":"Многие спрашивали, как играть с ногтями."},{"start":3.1,"end":3.92,"text":"Не используя квинты."},{"start":4.58,"end":6.12,"text":"Я квинты... Мне неудобно играть."},{"start":6.28,"end":7.12,"text":"Я играю обычными аккордами."},{"start":7.44,"end":7.78,"text":"Допустим, G. I'm."},{"start":12.74,"end":14.14,"text":"Но они не всегда чистыми выходят, но всё-таки."},{"start":15.12,"end":15.84,"text":"Как я это делаю?"},{"start":17.26,"end":19.48,"text":"Я ставлю палец..."},{"start":19.48,"end":20.68,"text":"Не вот так вот, как обычно."},{"start":20.92,"end":21.9,"text":"А вот так вот, скорее."},{"start":22.88,"end":24.2,"text":"Об гриф. Вот, смотрите."},{"start":24.48,"end":25.0,"text":"Зажимаю G."},{"start":27.12,"end":28.44,"text":"Вот, видите, этот палец какой?"},{"start":30.26,"end":31.02,"text":"Почти чисто."},{"start":33.3,"end":34.76,"text":"Вот, и главное просто приловчиться."},{"start":35.14,"end":36.92,"text":"Чем дольше ты делаешь это с ногтями, тем"},{"start":36.92,"end":38.08,"text":"больше ты привыкаешь."},{"start":38.26,"end":39.48,"text":"И потом всё будет получаться."},{"start":42.1,"end":43.54,"text":"Квинтами тоже, кстати, можно."},{"start":45.04,"end":45.48,"text":"Всё."}],"verification":{"independent_review":false,"word_agreement":0.977,"needs_chunk_review":false}}
