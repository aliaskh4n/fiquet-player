{"version":1,"track_id":17,"audio_sha256":"ae18aaa31e50e94f06d7663675c736d8dbc70d088d7539ec5f93ed14cf24a1bd","duration":18.59,"language":"russian","status":"ready","lines":[{"start":0,"end":2.74,"text":"Последнее подтверждение. О, что это такое?"},{"start":3.08,"end":5.8,"text":"Все спрашивают, ну, один человек спрашивает, будет ли"},{"start":5.8,"end":6.16,"text":"сходка или нет."},{"start":6.34,"end":8.58,"text":"Да, сходка будет, и она будет через 30"},{"start":8.58,"end":10.22,"text":"минут на Достэк Плазе."},{"start":10.98,"end":13.26,"text":"Пока не знаю, где конкретно, но я не"},{"start":13.26,"end":15.74,"text":"думаю, что торговый центр настолько большой, что мы"},{"start":15.74,"end":16.94,"text":"все потеряемся там."},{"start":16.96,"end":17.78,"text":"Ну, на первом этаже."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
