{"version":3,"track_id":923,"audio_sha256":"66bbc0fc720136b7f256118baed1c88b3f1f93307e6742bb568478facdfa1e15","duration":31.78,"origin":"original_lyrics","status":"ready","lines":[{"start":1.14,"end":3.28,"text":"Шаг за шагом, год за годом","source_line":8},{"start":3.28,"end":5.23,"text":"Гордости полна душа","source_line":9},{"start":5.51,"end":7.5,"text":"И отрывки этих строчек","source_line":10},{"start":7.5,"end":9.47,"text":"Будут покорять сердца","source_line":11},{"start":9.47,"end":11.8,"text":"Для кого-то Мама — счастье","source_line":12},{"start":11.8,"end":13.79,"text":"Для кого-то лишь слова","source_line":13},{"start":13.79,"end":16.26,"text":"Пусть искра в сердцах сияет","source_line":14},{"start":16.26,"end":18.01,"text":"Что не гаснет никогда.","source_line":15},{"start":20.22,"end":22.44,"text":"Мысли прочь в эту ночь","source_line":1},{"start":22.44,"end":24.49,"text":"Мать не спит, день и ночь","source_line":2},{"start":24.5,"end":25.7,"text":"Снова уезжаю из родного дома я","source_line":16},{"start":25.7,"end":26.99,"text":"Снова вдаль дорога","source_line":17}],"verification":{"source_text_checked":true,"word_agreement":0.685,"matched_words":37,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.524},"song":"Мама","artist":"Динар Рахматуллин","source_url":"https://tekst-pesni.com/dinar-rahmatullin-mama-2/","source_sha256":"c40f27dfb51536d5f336ad613b30a9ef50a7dee0df1b267a4a2cfd9a6f36f912"}
