{"version":2,"track_id":923,"audio_sha256":"66bbc0fc720136b7f256118baed1c88b3f1f93307e6742bb568478facdfa1e15","duration":31.78,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.36,"text":"Шаг за шагом, год за годом","source_line":8},{"start":3.36,"end":5.19,"text":"Гордости полна душа","source_line":9},{"start":5.56,"end":7.66,"text":"И отрывки этих строчек","source_line":10},{"start":7.66,"end":9.52,"text":"Будут покорять сердца","source_line":11},{"start":9.52,"end":10.88,"text":"Для кого-то Мама — счастье","source_line":12},{"start":11.9,"end":13.84,"text":"Для кого-то лишь слова","source_line":13},{"start":13.84,"end":16.02,"text":"Пусть искра в сердцах сияет","source_line":14},{"start":16.44,"end":17.98,"text":"Что не гаснет никогда.","source_line":15},{"start":20.5,"end":22.44,"text":"Мысли прочь в эту ночь","source_line":1},{"start":22.9,"end":24.34,"text":"Мать не спит, день и ночь","source_line":2}],"verification":{"source_text_checked":true,"word_agreement":0.685,"matched_words":37,"timing":"cached_word_anchors"},"song":"Мама","artist":"Динар Рахматуллин","source_url":"https://tekst-pesni.com/dinar-rahmatullin-mama-2/","source_sha256":"c40f27dfb51536d5f336ad613b30a9ef50a7dee0df1b267a4a2cfd9a6f36f912"}
