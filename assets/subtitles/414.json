{"version":2,"track_id":414,"audio_sha256":"d0175fadf08bd020c7481ac3335adb823ae7c5e832120ce1ed472ec8e2f6ff94","duration":35.63,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.06,"text":"Па-па-па-па-па-па-па-па-па","source_line":0},{"start":6.1,"end":9.12,"text":"Сказала мама: «Выбрось краски и рот закрой","source_line":1},{"start":9.12,"end":11.4,"text":"Не суждено тебе ни петь, ни рисовать»","source_line":2},{"start":12.1,"end":14.68,"text":"Мне так хотелось стать маленькой рок-звездой","source_line":3},{"start":14.68,"end":17.0,"text":"Ломать гитары и улыбки раздавать","source_line":4},{"start":17.06,"end":20.22,"text":"Казалось, эти мечты совершили суицид","source_line":5},{"start":20.22,"end":22.42,"text":"Теперь не могут даже попросту дышать","source_line":6},{"start":22.42,"end":26.3,"text":"Но я узнала, что такое постмодерн, и вот","source_line":7},{"start":26.38,"end":27.88,"text":"Решила паблик свой создать","source_line":8}],"verification":{"source_text_checked":true,"word_agreement":0.82,"matched_words":50,"timing":"cached_word_anchors"},"song":"150 сантиметров","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/35347757","source_sha256":"a7c3744d729c17a190714457109c55425af2d1940c63d2b6963effc19848e910"}
