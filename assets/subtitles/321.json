{"version":1,"track_id":321,"audio_sha256":"e8d8630c9a9bc75d1079890370ac6604c5cba29c8c65e89e0dc17973308c5a38","duration":16.19,"language":"russian","status":"ready","lines":[{"start":1.08,"end":3.06,"text":"Заново. Ой, почему лагает?"},{"start":3.12,"end":5.58,"text":"Один пацан, короче, мой одноклассник, но мы с"},{"start":5.58,"end":6.3,"text":"ним не болтаем."},{"start":6.7,"end":9.08,"text":"Он, видимо, увидел, что я покрасила волосы, мы"},{"start":9.08,"end":11.68,"text":"идём. Он идёт спереди, он оборачивается."},{"start":11.84,"end":15.7,"text":"Это было на лестнице, и он, короче, улетел."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
