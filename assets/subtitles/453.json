{"version":1,"track_id":453,"audio_sha256":"d417c9532ee15c3a4a344e3024c45513f29a81103bdd29708a2657def2cdce73","duration":14.13,"language":"russian","status":"ready","lines":[{"start":0,"end":1.34,"text":"Ребята, всем привет."},{"start":2.2,"end":3.86,"text":"Я сболела, вы уже знаете."},{"start":4.0,"end":5.66,"text":"У меня сил хватает только, чтобы есть и"},{"start":5.66,"end":7.22,"text":"спать. Миша, голова болит."},{"start":7.68,"end":9.64,"text":"Но я собралась с Серилами и записала вам"},{"start":9.64,"end":13.48,"text":"сейчас кавер. И я прошу именно тебя глянуть"},{"start":13.48,"end":13.96,"text":"его."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
