{"version":1,"track_id":295,"audio_sha256":"babc6c5514c0f871c3d173155c39d99da6d92e7efc2b94851f453f18f3a7b281","duration":56.99,"language":"russian","status":"ready","lines":[{"start":0,"end":3.7,"text":"Сейчас будем обработать Во время школы много что-то"},{"start":4.46,"end":8.86,"text":"течет Налей мне еще Антисептика Это антисептик?"},{"start":10.34,"end":13.16,"text":"А нет Он не болит, ребята"},{"start":14.16,"end":16.58,"text":"Можно мне тоже Эта салфеточка одна?"},{"start":16.72,"end":17.9,"text":"Сейчас можно мне протереть?"},{"start":18.12,"end":20.74,"text":"Я одну ладошку протерла из четырех своих конечностей,"},{"start":21.06,"end":22.1,"text":"Лиза Давай я протру"},{"start":23.02,"end":27.44,"text":"Антисептик вайпс Пардон Подержи пожалуйста его Положил?"},{"start":28.9,"end":31.62,"text":"В общем я себя чувствую Тоже знаешь во"},{"start":31.62,"end":34.8,"text":"время школы Я не понимаю что делать Ощущения"},{"start":34.8,"end":35.68,"text":"вообще хуевые"},{"start":36.72,"end":37.52,"text":"Ой"},{"start":38.88,"end":39.68,"text":"Нормас"},{"start":40.54,"end":40.94,"text":"Ой"},{"start":41.98,"end":44.36,"text":"Марго еще подошла Марго хочешь сказать привет"},{"start":45.48,"end":47.08,"text":"Моим подписчикам"},{"start":48.66,"end":50.66,"text":"Марго посмотри Марго ты"},{"start":52.04,"end":54.92,"text":"Марго вот моя Марго Привет"}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
