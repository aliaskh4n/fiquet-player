{"version":1,"track_id":494,"audio_sha256":"2fc4515c4439465d99d104d2e3d536f770ea3f91bb237c66f207d18d2152ddb8","duration":15.49,"language":"russian","status":"ready","lines":[{"start":0,"end":2.02,"text":"Я там играю на электрогитаре."},{"start":2.4,"end":3.62,"text":"Почему я всё показываю жестами?"},{"start":3.94,"end":6.12,"text":"В общем, я играю на электрогитаре и мне"},{"start":6.12,"end":8.64,"text":"нужен ваш совет."},{"start":9.34,"end":13.08,"text":"Что больше под меня подходит электрогитарой или скорее"},{"start":13.08,"end":15.2,"text":"акустика? Я думаю, чередовать, на самом деле."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
