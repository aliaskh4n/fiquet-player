{"version":1,"track_id":223,"audio_sha256":"141669f26492fb9a2df4fcd7a45416d70117ae16fc2e509469ba27a9d08cc1a6","duration":16.29,"language":"russian","status":"ready","lines":[{"start":0,"end":1.68,"text":"Я уже вышла."},{"start":3.14,"end":3.9,"text":"Какой-то маленький-маленький на меня смотрит."},{"start":4.06,"end":5.42,"text":"А тут его папа."},{"start":6.06,"end":6.16,"text":"Он злой."},{"start":7.18,"end":9.78,"text":"Здесь стоял мужчина и орал на кого-то."},{"start":10.96,"end":12.26,"text":"Вот моя компашка очень крутая."},{"start":13.68,"end":14.48,"text":"Там еще Маргоша."},{"start":15.04,"end":16.04,"text":"Хотите я вам сниму Маргошу?"}],"verification":{"independent_review":false,"word_agreement":0.912,"needs_chunk_review":false}}
