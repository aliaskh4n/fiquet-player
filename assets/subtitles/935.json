{"version":1,"track_id":935,"audio_sha256":"ba03c6e1d2522e9137a318428a58b70dd6254d681a79770153521919ac526e34","duration":23.54,"language":"russian","status":"ready","lines":[{"start":0,"end":2.74,"text":"А еще я купила очень миленький кулончик в"},{"start":2.74,"end":5.32,"text":"виде дракончика, вот."},{"start":6.38,"end":6.7,"text":"Просто."},{"start":7.56,"end":11.06,"text":"Вы, кстати, я хотела спросить, вам было бы"},{"start":11.06,"end":12.98,"text":"комфортно, если бы здесь было больше, допустим, в"},{"start":12.98,"end":14.84,"text":"моей жизни какие-то моменты."},{"start":15.0,"end":16.76,"text":"Вот, допустим, я гуляю с подружками, фоточки наделала,"},{"start":16.82,"end":22.44,"text":"сюда скинула. Или здесь скорее как чисто для"},{"start":22.44,"end":23.5,"text":"разборов место сделать?"}],"verification":{"independent_review":false,"word_agreement":0.98,"needs_chunk_review":false}}
