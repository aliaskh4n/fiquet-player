{"version":1,"track_id":293,"audio_sha256":"92dac03da8612aae3bd99c285509341a4f2da8398294297fc9ed430b075d0c78","duration":35.66,"language":"russian","status":"ready","lines":[{"start":0,"end":2.12,"text":"Ну, в общем, дальше идёт история."},{"start":2.52,"end":3.4,"text":"Это уже с моего лица."},{"start":4.42,"end":5.8,"text":"Дело в том..."},{"start":6.02,"end":7.02,"text":"That's for my subscribers."},{"start":8.02,"end":11.3,"text":"В общем, я упала, я в себя споткнулась,"},{"start":11.36,"end":13.14,"text":"вот так вот, лицом вниз, просто ле."},{"start":13.52,"end":15.86,"text":"И я понимаю, что машина едет на меня,"},{"start":16.18,"end":17.78,"text":"но на этот момент мне уже так всё"},{"start":17.78,"end":20.48,"text":"равно. Я говорю, давите меня, давите меня, дави"},{"start":20.48,"end":21.48,"text":"мне машину, мне пофиг."},{"start":21.92,"end":25.08,"text":"Я лежу, Елиса начинает меня оттаскивать, а я"},{"start":25.08,"end":26.9,"text":"говорю, типа, я полежу, я полежу."},{"start":27.78,"end":29.64,"text":"А потом я валялась на дорожке."},{"start":30.24,"end":31.48,"text":"Ой, у меня так коленка болит, вы не"},{"start":31.48,"end":33.08,"text":"представляете, мне так грустно."}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
