{"version":1,"track_id":587,"audio_sha256":"2462aebe4f3c0106bfe7699509c472201c82b3b620030eb1320276b7ab9e9cad","duration":21.82,"language":"russian","status":"ready","lines":[{"start":0,"end":2.5,"text":"Я себя задним светом чувствую, как в фильме."},{"start":5.18,"end":6.64,"text":"А ещё я не знаю, что мне делать."},{"start":7.28,"end":7.76,"text":"Я..."},{"start":8.66,"end":11.68,"text":"Я болею. Я продолжаю записывать каверы, потому что"},{"start":11.68,"end":13.16,"text":"я не хочу их записывать."},{"start":13.52,"end":15.68,"text":"Но при этом я дико кашляю."},{"start":15.8,"end":16.88,"text":"И у меня вообще голос..."},{"start":16.88,"end":17.78,"text":"у меня испортился голос."},{"start":17.86,"end":18.74,"text":"Я не знаю, что мне делать."},{"start":18.9,"end":20.1,"text":"У меня голос стал хуже."},{"start":20.48,"end":21.68,"text":"Я хуже стала петь."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
