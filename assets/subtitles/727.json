{"version":2,"track_id":727,"audio_sha256":"a9608825b1bc0aad3cefaa555fcdcec372bd8bda3eae577e9625cac76485a095","duration":51.11,"origin":"original_lyrics","status":"ready","lines":[{"start":2.94,"end":7.74,"text":"Мальчишки не сходят от меня с ума","source_line":0},{"start":7.96,"end":12.44,"text":"Я им как младшая сестра","source_line":1},{"start":12.56,"end":16.46,"text":"Я им как младшая сестра","source_line":2},{"start":17.7,"end":20.86,"text":"Заварю всем чай и уложу всех спать","source_line":3},{"start":20.86,"end":26.02,"text":"Но почему же ты выбираешь их","source_line":13},{"start":26.64,"end":30.56,"text":"Кукол без души, что не хотят любви","source_line":14},{"start":30.56,"end":34.94,"text":"Но когда внутри сердечко заболит","source_line":15},{"start":35.86,"end":40.24,"text":"Ты снова позвонишь, снова мне звонишь","source_line":36}],"verification":{"source_text_checked":true,"word_agreement":0.898,"matched_words":44,"timing":"cached_word_anchors"},"song":"Младшая сестра","artist":"дора","source_url":"https://lrclib.net/api/get/4026368","source_sha256":"91490800b19c9d64fa36327a17ab434da45310c0cd94aa040fdcd2badab03d83"}
