{"version":1,"track_id":751,"audio_sha256":"99f1bef861235a3c37986f7433d70c79f9585c2c9eb70631bfb7c078f70d70ff","duration":48.03,"language":"russian","status":"ready","lines":[{"start":0.32,"end":3.6,"text":"И беги за нею, купы по её следам"},{"start":3.6,"end":8.08,"text":"ведут лишь трубы, зубы крепче, чем металл."},{"start":8.1,"end":13.28,"text":"Ты попал."},{"start":19.24,"end":26.42,"text":"По улице шагает, пётрами качая, дурак влюблённый пригласит"},{"start":26.42,"end":30.14,"text":"на кружку чая, сварит свет кричит жена, свой"},{"start":31.28,"end":34.44,"text":"праздник спасая, в нём голос совести сосредотел, как"},{"start":35.72,"end":36.28,"text":"глухая."}],"verification":{"independent_review":true,"word_agreement":0.762,"review_model":"gpt-4o-transcribe","unanchored_words":10,"needs_chunk_review":false}}
