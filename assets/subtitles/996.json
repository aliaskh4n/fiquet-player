{"version":1,"track_id":996,"audio_sha256":"9dba51221434009f6eb2860bbe0fde2036afb24c4d07015ebb07e2c8cffb9e9d","duration":41.52,"language":"russian","status":"ready","lines":[{"start":0,"end":0.72,"text":"И так ещё."},{"start":0.92,"end":1.76,"text":"Блин, я красно выгляжу."},{"start":1.9,"end":4.92,"text":"Натуральный румянец. В общем, я просто записывала кавер,"},{"start":5.04,"end":5.9,"text":"поэтому не стало жарко."},{"start":6.62,"end":7.88,"text":"Кто спрашивает, какая у меня гитара?"},{"start":8.42,"end":9.94,"text":"Я это закреплю, потому что много кто спрашивает."},{"start":10.26,"end":12.62,"text":"В общем, вот такая красотка Yamaha."},{"start":13.78,"end":15.78,"text":"Мне Yamaha должны заплатить за рекламу."},{"start":19.02,"end":23.54,"text":"Yamaha FS800 Yamaha Corporation."},{"start":23.64,"end":24.36,"text":"Made in China."},{"start":25.24,"end":25.96,"text":"Вот так вот."},{"start":26.3,"end":28.36,"text":"Я вам просто всю информацию про эту малышку"},{"start":28.36,"end":28.84,"text":"рассказала."},{"start":29.92,"end":31.12,"text":"Вот такая вот."},{"start":31.24,"end":33.24,"text":"Она, по-моему, довольно большая."},{"start":33.4,"end":34.9,"text":"Ну, есть же разные, типа, поменьше, больше."},{"start":34.98,"end":35.52,"text":"Но это, наверное,"},{"start":36.98,"end":38.38,"text":"середина где-то. Вот."}],"verification":{"independent_review":false,"word_agreement":0.976,"needs_chunk_review":false}}
