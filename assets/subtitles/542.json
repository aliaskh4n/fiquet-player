{"version":1,"track_id":542,"audio_sha256":"8f427240cea340012a63e1766bca5aa1b74a61acad7fe1d0bf7cef2c3c5165f7","duration":23.88,"language":"russian","status":"ready","lines":[{"start":0,"end":2.24,"text":"В общем, сегодня у меня экспериментальный кавер, потому"},{"start":2.24,"end":4.3,"text":"что я сделала кавер на песню, на которую"},{"start":4.3,"end":5.28,"text":"нигде нет аккордов."},{"start":5.52,"end":6.24,"text":"Сейчас я вам покажу эту песню."},{"start":14.56,"end":16.02,"text":"Вот эта песенка, если знаете,"},{"start":17.14,"end":19.84,"text":"вот. Я подобрала на неё вроде как аккорды,"},{"start":19.94,"end":22.8,"text":"я надеюсь, что звучит нормально, то сейчас выложим"},{"start":22.8,"end":23.18,"text":"разбор."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
