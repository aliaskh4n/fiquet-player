{"version":1,"track_id":934,"audio_sha256":"75e4807ae02e3896d7cb439da0d906e9df20b5c83549e9bbf4ba7b866d7b6a31","duration":33.19,"language":"russian","status":"ready","lines":[{"start":0,"end":1.78,"text":"Короче, я только что заметила,"},{"start":2.86,"end":6.42,"text":"актив поднялся, тьфу-тьфу-тьфу, лишь бы не сглазить."},{"start":6.74,"end":8.68,"text":"Но даже если упадёт, ничего страшного, потому что"},{"start":8.68,"end":10.98,"text":"два видео залетели на…"},{"start":10.98,"end":13.94,"text":"Ну типа вот «Весь мой мунитест обилийно за"},{"start":13.94,"end":18.68,"text":"тебя», и потом второе, где я пою этот…"},{"start":20.84,"end":22.44,"text":"«Васла превратилась», короче."},{"start":22.8,"end":23.72,"text":"Вот песня про это."},{"start":24.26,"end":25.36,"text":"Аншалет! Я очень рада."},{"start":25.38,"end":27.7,"text":"Поэтому сейчас я взяла гитару в руки, буду"},{"start":27.7,"end":32.04,"text":"записывать вам разборы на эти песни."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
