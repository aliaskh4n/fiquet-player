{"version":1,"track_id":835,"audio_sha256":"cd18eb2d5d38112c14fd08155f97311c3a2fc45ce06ba26345e8c519ec7b366c","duration":25.74,"language":"russian","status":"ready","lines":[{"start":0,"end":1.08,"text":"Окей, давайте так."},{"start":2.16,"end":4.62,"text":"Просто, ну, мне кажется, что фонг и еда"},{"start":5.18,"end":6.7,"text":"— это довольно такие совместивые вещи."},{"start":7.04,"end":8.82,"text":"Если вам не понравится, вы мне скажите, да"},{"start":8.82,"end":10.3,"text":"я слишком много намутила."},{"start":10.76,"end":14.86,"text":"Я такая, окей, следующий мой распорядок дня будет"},{"start":14.86,"end":18.46,"text":"в очень спокойном формате, в таком, ну, лайтовый,"},{"start":18.78,"end":19.34,"text":"вот."},{"start":20.8,"end":23.5,"text":"Скажите, пожалуйста, вам понравился фонг и еда или"},{"start":23.5,"end":25.44,"text":"нет? Я могу это удалить, пока не поздно."}],"verification":{"independent_review":false,"word_agreement":0.984,"needs_chunk_review":false}}
