{"version":1,"track_id":80,"audio_sha256":"1dbf8161d1e227307be4d29fa1bd213f835119ebfab4d0873e5758eb76d2c565","duration":38.67,"language":"russian","status":"ready","lines":[{"start":5.02,"end":6.02,"text":"Старый кофе, кофе шином, выходной, совар, казак, тюнке,"},{"start":9.12,"end":13.18,"text":"трещина, лапочка луны над парком."},{"start":13.18,"end":15.12,"text":"Я без ключу на байсепря с пахтном бухманом,"},{"start":19.14,"end":21.38,"text":"медухи. Ты хочешь меня снять,"},{"start":22.3,"end":25.1,"text":"снять. Я хочу писать стихи, стихи."},{"start":25.1,"end":28.02,"text":"Уезжай, чай не допивай."},{"start":29.28,"end":31.06,"text":"Снега дождь, там уходи."},{"start":31.06,"end":36.12,"text":"Пусть хоть все переморозит, пусть хоть торнадо унесет"},{"start":36.76,"end":38.6,"text":"даль. Может есть еще твой трамвай."}],"verification":{"independent_review":true,"word_agreement":0.648,"review_model":"gpt-4o-transcribe","unanchored_words":19,"needs_chunk_review":false}}
