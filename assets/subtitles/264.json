{"version":1,"track_id":264,"audio_sha256":"020b6c1912593fe26333df588568b3d09a13a4d4c89c7daed1afe420fef85b4d","duration":16.51,"language":"russian","status":"ready","lines":[{"start":0,"end":1.72,"text":"Подожди, подожди, сфоткай, сфоткай."},{"start":1.9,"end":2.64,"text":"Азия, Азия, Азия."},{"start":4.66,"end":6.16,"text":"В общем, котики и котята."},{"start":6.44,"end":7.58,"text":"У нас сегодня такое."},{"start":7.9,"end":10.74,"text":"Утро прекрасное, просто шибасино, вайбовое."},{"start":11.04,"end":12.9,"text":"Осень пришла. Это же осень?"},{"start":13.92,"end":14.02,"text":"Да."},{"start":14.98,"end":15.46,"text":"Да."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
