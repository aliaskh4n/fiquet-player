{"version":1,"track_id":823,"audio_sha256":"7a341514a0b48cd728de5559507cf90d080de1ada7624948a81e85ba620938bf","duration":27.44,"language":"russian","status":"ready","lines":[{"start":0,"end":4.18,"text":"Окей, сейчас чисто по фану надела платье, походила"},{"start":4.18,"end":5.3,"text":"на каблуках."},{"start":7.84,"end":9.9,"text":"Валяюсь. Такой ужас, капец."},{"start":10.32,"end":11.12,"text":"Это так неудобно."},{"start":11.48,"end":14.44,"text":"Я боготворю девушек, которые красиво ходят на каблуках."},{"start":14.54,"end":16.42,"text":"Но вроде как научилась, да?"},{"start":17.48,"end":21.38,"text":"О, е-е-е. Кто-нибудь знает какие-нибудь песни, под которые"},{"start":21.38,"end":23.16,"text":"можно походить красиво на каблуках?"},{"start":23.42,"end":24.4,"text":"Я хочу тут это снять."},{"start":24.76,"end":25.08,"text":"Титок."}],"verification":{"independent_review":false,"word_agreement":0.939,"needs_chunk_review":false}}
