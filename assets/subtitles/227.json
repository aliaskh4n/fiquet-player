{"version":1,"track_id":227,"audio_sha256":"3f4be491dfcdae5fc444847ff859549a4f5bbe68d507ad6bc3c45b1c8aefbc94","duration":35.11,"language":"russian","status":"ready","lines":[{"start":0,"end":1.0,"text":"У вас, кстати, нет такого, что…"},{"start":1.0,"end":2.08,"text":"У меня вечно проблема,"},{"start":3.42,"end":6.68,"text":"когда мне даже очень сильно плохо, у меня"},{"start":6.68,"end":8.04,"text":"прям… Я могу, допустим…"},{"start":8.04,"end":9.46,"text":"У меня был период, когда я не вставала"},{"start":9.46,"end":11.18,"text":"с кровати, лежала три месяца."},{"start":11.34,"end":12.12,"text":"Ну вот так вот просто."},{"start":12.3,"end":12.86,"text":"И снимала каверы."},{"start":12.98,"end":14.34,"text":"Это единственное моё развлечение было."},{"start":15.32,"end":17.34,"text":"У вас нет такого, что вы думаете о"},{"start":17.34,"end":18.64,"text":"том, что вам плохо у себя, а потом"},{"start":18.64,"end":20.46,"text":"думаете «Нет, я прибедняюсь»."},{"start":20.46,"end":22.58,"text":"Хотя по сути ты не прибедняешься, потому что"},{"start":22.58,"end":23.94,"text":"это твои мысли в твоей голове."},{"start":26.12,"end":27.7,"text":"Надеюсь, это не странно звучит."},{"start":30.64,"end":31.76,"text":"Ну нет, я скину."},{"start":32.02,"end":34.22,"text":"Знаете, у меня настоящая вот такая бешеная…"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
