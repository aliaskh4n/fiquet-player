{"version":1,"track_id":975,"audio_sha256":"aa664b2e5549087b09e750207b7ea44dbaac066bfdbb603830b6a9f3f12145be","duration":54.34,"language":"russian","status":"ready","lines":[{"start":0,"end":1.3,"text":"Так, по поводу нюансов."},{"start":1.58,"end":2.16,"text":"Их не так много."},{"start":2.48,"end":5.16,"text":"В общем, у нас бой просто в припеве."},{"start":6.6,"end":9.64,"text":"Первая часть этого боя долгая, а дальше он"},{"start":9.64,"end":11.64,"text":"быстро идёт. То есть вниз, вниз, вниз-внизверх."},{"start":14.48,"end":14.58,"text":"Вот."},{"start":15.48,"end":16.92,"text":"Просто говорю, чтобы не было непонятно, вдруг кто-то"},{"start":17.36,"end":19.56,"text":"будет играть вниз, вниз, вниз, вниз-вверх."},{"start":20.94,"end":24.24,"text":"В общем, я сейчас продемонстрирую очень медленно на"},{"start":24.24,"end":24.7,"text":"аккордах."},{"start":36.24,"end":37.88,"text":"А вот как в оригинале."}],"verification":{"independent_review":false,"word_agreement":0.95,"needs_chunk_review":false}}
