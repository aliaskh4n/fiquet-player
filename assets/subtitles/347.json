{"version":1,"track_id":347,"audio_sha256":"137537ac5c4e9785f86b0bad32fd1342922e40dc20e013ee2019e3f598e96e4d","duration":29.9,"language":"russian","status":"ready","lines":[{"start":0,"end":2.02,"text":"Ребята, что за причесон?"},{"start":3.48,"end":4.92,"text":"Мага! Мага, давай!"},{"start":5.32,"end":8.58,"text":"Сейчас. Подождите. Хочу себе шлемчик такой сделать."},{"start":16.64,"end":17.1,"text":"Ну, короче,"},{"start":17.88,"end":20.84,"text":"я выставила новый кавер, и вы видите мой…"},{"start":20.84,"end":21.76,"text":"Вы видите, как я одета?"},{"start":21.98,"end":23.46,"text":"Я специально оделась для этого кавера."},{"start":27.12,"end":28.4,"text":"Зацените, бабуся подарила."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
