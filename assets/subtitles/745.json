{"version":1,"track_id":745,"audio_sha256":"612e3c13563d06003e687bbca94bd8ee49c19ef72b78c2e959a5b1335c7cc6c3","duration":29.75,"language":"russian","status":"ready","lines":[{"start":0,"end":2.6,"text":"Я сейчас чищу зубы, я беру щетку."},{"start":4.72,"end":6.64,"text":"Во-первых, я никогда не слушала Моргена."},{"start":7.02,"end":8.94,"text":"На его последний альбом я вот сейчас чищу"},{"start":8.94,"end":10.1,"text":"зубы и слушаю музыку."},{"start":10.6,"end":12.4,"text":"Мне зашло. Прямо конкретно."},{"start":12.54,"end":13.78,"text":"Последний вокзал там и так далее."},{"start":14.2,"end":17.32,"text":"И второе, знаете песню «До скорых встреч на"},{"start":17.32,"end":19.6,"text":"мятых простынях, цветом мак»."},{"start":19.6,"end":22.72,"text":"Я слушала постоянно репите, и я сейчас посмотрела,"},{"start":22.78,"end":24.98,"text":"на меня авторка этой песни подписана."},{"start":26.78,"end":26.98,"text":"Вот."},{"start":28.3,"end":29.22,"text":"Просто новость крутая."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
