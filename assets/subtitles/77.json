{"version":1,"track_id":77,"audio_sha256":"dbde8ee74299dff9d98a9ae2b2dcffb7239c2dc284bb3d0d33cf50e737d6bc79","duration":31.67,"language":"russian","status":"ready","lines":[{"start":0,"end":1.06,"text":"Она любит кого?"},{"start":1.92,"end":3.46,"text":"Она любит своего Блюфенда."},{"start":4.94,"end":7.74,"text":"Еще на тайну моих руках."},{"start":7.74,"end":8.6,"text":"Мы не ждем всех обид."},{"start":12.4,"end":13.0,"text":"Дай мне пространства путыться в облака."},{"start":13.58,"end":16.26,"text":"Она купит мне теплый свитер."},{"start":16.88,"end":17.24,"text":"Как ты с неба посыпаешься за облаков."},{"start":19.32,"end":21.96,"text":"Какие слезы, какие обиды."},{"start":21.96,"end":25.12,"text":"Я приду к ней, будет легко."}],"verification":{"independent_review":true,"word_agreement":0.644,"review_model":"gpt-4o-transcribe","unanchored_words":16,"needs_chunk_review":false}}
