{"version":1,"track_id":671,"audio_sha256":"f285b5e0ae928a49c2550089aee2e38d72a9c443d228e6a6ff2e1ef379152499","duration":90.92,"language":"russian","status":"ready","lines":[{"start":0,"end":2.74,"text":"Предупреждение. Кишлак и маты."},{"start":4.06,"end":5.66,"text":"Я против матов, если что."},{"start":6.16,"end":32.8,"text":"Так. Без вспомогательных вещей я уебываю в джаз,"},{"start":32.88,"end":33.28,"text":"Без вспомогательных вещей я уебываю в джаз, я"},{"start":33.28,"end":36.88,"text":"хочу только ее, но зачем ненавидеть нас?"},{"start":37.38,"end":41.02,"text":"Я спасу себя от одиночества, но я не"},{"start":41.02,"end":43.22,"text":"знаю, как мне сохранить себя."},{"start":44.76,"end":48.22,"text":"Возможно, все это когда-нибудь закончится, и ты нет"},{"start":48.84,"end":50.6,"text":"больше никогда."},{"start":51.42,"end":54.74,"text":"Но я отдам себе отдельный угол в памяти,"},{"start":55.48,"end":58.46,"text":"в моей тренированной детской голове."},{"start":58.46,"end":63.4,"text":"Нас окружает мысль бесконечной зависти, но я привык"},{"start":64.02,"end":65.68,"text":"себе уже даже во сне."},{"start":66.44,"end":70.58,"text":"Без вспомогательных вещей я уебываю в джаз, мы"},{"start":70.58,"end":73.72,"text":"плывем будто по гере, будто все как в"},{"start":73.72,"end":77.5,"text":"первый раз. Без вспомогательных вещей я уебываю в"},{"start":77.5,"end":78.0,"text":"джаз."}],"verification":{"independent_review":true,"word_agreement":0.65,"review_model":"gpt-4o-transcribe","unanchored_words":41,"needs_chunk_review":false}}
