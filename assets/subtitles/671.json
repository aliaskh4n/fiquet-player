{"version":2,"track_id":671,"audio_sha256":"f285b5e0ae928a49c2550089aee2e38d72a9c443d228e6a6ff2e1ef379152499","duration":90.92,"origin":"original_lyrics","status":"ready","lines":[{"start":33.28,"end":36.88,"text":"Я хочу только её, можете ненавидеть нас","source_line":23},{"start":37.46,"end":40.0,"text":"Я спасу тебя от одиночества","source_line":33},{"start":40.32,"end":43.22,"text":"Но я не знаю как мне сохранить себя","source_line":35},{"start":44.16,"end":47.42,"text":"Быть может это всё когда-нибудь закончится","source_line":37},{"start":51.42,"end":54.74,"text":"Но я отдам тебе отдельный угол памяти","source_line":41},{"start":55.48,"end":58.46,"text":"В моей травмированной детской голове","source_line":43},{"start":58.46,"end":62.3,"text":"Нас окружают монстры бесконечной зависти","source_line":45},{"start":62.76,"end":65.68,"text":"Но я привык к тебе уже даже во сне","source_line":47},{"start":66.44,"end":70.22,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":49},{"start":70.58,"end":73.92,"text":"Мы плывём будто под герой, будто всё как в первый раз","source_line":51},{"start":74.22,"end":78.0,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":53}],"verification":{"source_text_checked":true,"word_agreement":0.894,"matched_words":76,"timing":"cached_word_anchors"},"song":"Я уёбываю в джаз","artist":"Кишлак","source_url":"https://mychords.net/ru/kishlak/228287-kishlak-ya-uyebyvayu-v-dzhaz.html","source_sha256":"669d916f31babbe1a12a140292de41a9ff1b8f2454f2b7bceed49f3d98fa6360"}
