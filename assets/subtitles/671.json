{"version":3,"track_id":671,"audio_sha256":"f285b5e0ae928a49c2550089aee2e38d72a9c443d228e6a6ff2e1ef379152499","duration":90.92,"origin":"original_lyrics","status":"ready","lines":[{"start":20.84,"end":25.04,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":12},{"start":25.04,"end":28.7,"text":"Мы плывём будто под герой, будто всё как в первый раз","source_line":13},{"start":28.7,"end":32.83,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":14},{"start":32.83,"end":36.99,"text":"Я хочу только её, можете ненавидеть нас","source_line":15},{"start":37.14,"end":40.05,"text":"Я спасу тебя от одиночества","source_line":16},{"start":40.18,"end":43.220001220703125,"text":"Но я не знаю как мне сохранить себя","source_line":17},{"start":43.9,"end":47.55,"text":"Быть может это всё когда-нибудь закончится","source_line":18},{"start":47.65,"end":50.599998474121094,"text":"И ты не кончишь со мной больше никогда","source_line":19},{"start":51.32,"end":54.94,"text":"Но я отдам тебе отдельный угол памяти","source_line":20},{"start":54.94,"end":58.41,"text":"В моей травмированной детской голове","source_line":21},{"start":58.41,"end":62.39,"text":"Нас окружают монстры бесконечной зависти","source_line":22},{"start":62.46,"end":65.68000030517578,"text":"Но я привык к тебе уже даже во сне","source_line":23},{"start":66.12,"end":70.24,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":24},{"start":70.24,"end":73.86,"text":"Мы плывём будто под герой, будто всё как в первый раз","source_line":25},{"start":73.86,"end":88.55,"text":"Без вспомогательных веществ я уёбываю в джаз","source_line":26}],"verification":{"source_text_checked":true,"word_agreement":0.894,"matched_words":76,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.459},"song":"Я уёбываю в джаз","artist":"Кишлак","source_url":"https://mychords.net/ru/kishlak/228287-kishlak-ya-uyebyvayu-v-dzhaz.html",