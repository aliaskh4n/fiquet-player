{"version":2,"track_id":752,"audio_sha256":"c86fa54447dd135e3df9e09474e490be83f84e4239ff58481c98f5486df5bdff","duration":71.3,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":1.12,"text":"Любовь моя","source_line":0},{"start":1.12,"end":3.84,"text":"Всегда выходила мне боком","source_line":1},{"start":3.84,"end":5.44,"text":"Любовь моя","source_line":18},{"start":5.44,"end":7.58,"text":"Всегда выходила мне боком","source_line":19},{"start":8.24,"end":9.68,"text":"Занозой под ноготь","source_line":2},{"start":10.38,"end":12.94,"text":"Жить мешает да больно вытащить","source_line":3},{"start":12.94,"end":15.14,"text":"Я жду когда загорится красный","source_line":4},{"start":19.3,"end":20.52,"text":"Жалко водителей","source_line":6},{"start":21.18,"end":23.48,"text":"Сколько раз клялся себе и стенам","source_line":7},{"start":23.48,"end":25.68,"text":"Не быть тяжестью, якорем","source_line":8},{"start":25.68,"end":28.28,"text":"Не цепляться за руки людей","source_line":9},{"start":28.28,"end":32.46,"text":"Но начинаю гулять по кругу и кричать","source_line":10},{"start":32.46,"end":36.88,"text":"Не в первый раз сквозь тьму прожитых дней","source_line":11},{"start":36.88,"end":39.0,"text":"Врачи напишут мне в карточке неврастеник","source_line":12},{"start":41.28,"end":44.26,"text":"Лечение: медикаменты и физический труд","source_line":13},{"start":44.26,"end":46.02,"text":"А я тонущий в иле","source_line":14},{"start":46.72,"end":48.72,"text":"Молча смотрел вокруг","source_line":15},{"start":49.0,"end":50.08,"text":"Просто хотел","source_line":16},{"start":50.68,"end":52.5,"text":"Чтоб меня любили","source_line":17},{"start":59.2,"end":62.02,"text":"А я тонущий в иле","source_line":33},{"start":62.74,"end":64.56,"text":"Молча смотрел вокруг","source_line":34},{"start":64.78,"end":65.7,"text":"Просто хотел","source_line":35},{"start":66.38,"end":67.94,"text":"Чтоб меня любили","source_line":36}],"verification":{"source_text_checked":true,"word_agr