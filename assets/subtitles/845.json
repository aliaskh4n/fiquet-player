{"version":1,"track_id":845,"audio_sha256":"9eaf8957ab76414f06c6b32cf272a5e33719b0dd1e160be154fbcc2d727c5cc7","duration":41.2,"language":"russian","status":"ready","lines":[{"start":0,"end":1.54,"text":"Короче, ребята, есть идея."},{"start":2.02,"end":5.1,"text":"Посмотрите, у кавер-мейкеров обычно есть какие-то свои"},{"start":5.1,"end":6.62,"text":"фишечки, допустим. Не дорожать."},{"start":7.24,"end":8.06,"text":"Допустим, это Вова."},{"start":8.6,"end":9.2,"text":"Ну, кто их знает?"},{"start":9.94,"end":12.08,"text":"Крутые ребята. Они орут, это Вова, а потом"},{"start":12.08,"end":13.86,"text":"бьют. Ну их, блин, их все знают."},{"start":14.5,"end":16.94,"text":"Короче, вот. Или там, я не знаю, Сончик."},{"start":18.02,"end":22.12,"text":"Сонечески, по-моему. У него на заднем фоне подсветка"},{"start":22.12,"end":22.38,"text":"всегда."},{"start":23.38,"end":23.9,"text":"Ну или Вика."},{"start":24.14,"end":27.36,"text":"У неё безумно такой нежный голос."},{"start":27.5,"end":28.06,"text":"Это её фишка."},{"start":28.06,"end":30.12,"text":"А у меня её нету."},{"start":30.18,"end":32.06,"text":"И поэтому я придумала одну идею."},{"start":32.18,"end":34.32,"text":"Но мне будет нужна ваша помощь."},{"start":34.42,"end":36.92,"text":"Сейчас я вас попрошу кое-что сделать."},{"start":37.58,"end":39.36,"text":"А вы, пожалуйста, сделайте, кому не сложно."},{"start":39.64,"end":40.48,"text":"Там надо будет нарисовать кое-что."}],"verification":{"independent_review":false,"word_agreement":0.95,"needs_chunk_review":false}}
