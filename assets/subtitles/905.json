{"version":2,"track_id":905,"audio_sha256":"e24d60b75e1220303878498d79f85353a9cf603da73687110ba13903c5e8a553","duration":92.4,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":5.0,"text":"Мир переверни, небо опрокинь","source_line":1},{"start":8.94,"end":11.8,"text":"В каждом наброске, в каждом черновике","source_line":2},{"start":19.56,"end":22.28,"text":"Всю мою жизнь я иду ко дну","source_line":4},{"start":22.28,"end":24.64,"text":"Всю мою жизнь я искал любовь","source_line":5},{"start":24.64,"end":26.54,"text":"Чтобы любить одну","source_line":6},{"start":35.98,"end":39.04,"text":"Плевать, ведь наши дети будут лучше, чем мы","source_line":8},{"start":41.3,"end":47.8,"text":"Когда меня не станет — я буду петь голосами","source_line":10},{"start":48.54,"end":53.28,"text":"Моих детей и голосами их детей","source_line":11},{"start":53.28,"end":56.14,"text":"Нас просто меняют местами","source_line":12},{"start":56.14,"end":62.92,"text":"Таков закон сансары, круговорот людей","source_line":13},{"start":65.14,"end":71.66,"text":"Когда меня не станет — я буду петь голосами","source_line":15},{"start":72.36,"end":77.26,"text":"Моих детей и голосами их детей","source_line":16},{"start":77.68,"end":80.52,"text":"Нас просто меняют местами","source_line":17},{"start":80.52,"end":87.36,"text":"Таков закон сансары, круговорот людей","source_line":18}],"verification":{"source_text_checked":true,"word_agreement":0.931,"matched_words":81,"timing":"cached_word_anchors"},"song":"Сансара","artist":"Basta","source_url":"https://lrclib.net/api/get/36519110","source_sha256":"33211caf9a3d2332ce734953abc0440f493239a6e386e816ae26f1aba84e7248"}
