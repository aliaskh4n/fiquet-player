{"version":3,"track_id":905,"audio_sha256":"e24d60b75e1220303878498d79f85353a9cf603da73687110ba13903c5e8a553","duration":92.4,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":5.0,"text":"Мир переверни, небо опрокинь","source_line":1},{"start":8.89,"end":11.89,"text":"В каждом наброске, в каждом черновике","source_line":2},{"start":11.94,"end":16.399999618530273,"text":"Учитель продолжается в своем ученике","source_line":3},{"start":19.51,"end":22.23,"text":"Всю мою жизнь я иду ко дну","source_line":4},{"start":22.23,"end":24.38,"text":"Всю мою жизнь я искал любовь","source_line":5},{"start":24.38,"end":26.540000915527344,"text":"Чтобы любить одну","source_line":6},{"start":31.21,"end":34.73,"text":"Они сказали — нас поздно спасать и поздно лечить","source_line":7},{"start":34.73,"end":36.55,"text":"Плевать, ведь наши дети будут лучше, чем мы","source_line":8},{"start":36.55,"end":41.25,"text":"Лучше, чем мы... Лучше, чем мы","source_line":9},{"start":41.25,"end":48.03,"text":"Когда меня не станет — я буду петь голосами","source_line":10},{"start":48.49,"end":53.23,"text":"Моих детей и голосами их детей","source_line":11},{"start":53.23,"end":56.09,"text":"Нас просто меняют местами","source_line":12},{"start":56.09,"end":59.99,"text":"Таков закон сансары, круговорот людей","source_line":13},{"start":65.09,"end":71.69,"text":"Когда меня не станет — я буду петь голосами","source_line":15},{"start":72.31,"end":77.63,"text":"Моих детей и голосами их детей","source_line":16},{"start":77.63,"end":80.47,"text":"Нас просто меняют местами","source_line":17},{"start":80.47,"end":88.65,"text":"Таков закон сансары, круговорот людей","source_line":18}],"verification":{"source_text_checked":true,"word_agreement":0.931,"matched_words":81,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.56},"song":"Сансара","artist":"Basta","source_url":"https://lrclib.net/api/get/36519110","source_sha