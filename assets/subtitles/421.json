{"version":1,"track_id":421,"audio_sha256":"dbc24b184bdcca81794fd515bf5e62b313ddce90484f4c8059a924652a255677","duration":54.62,"language":"russian","status":"ready","lines":[{"start":0,"end":2.8,"text":"Я пришла после концерта, и сейчас я буду"},{"start":2.8,"end":4.24,"text":"рассказывать, как это всё было."},{"start":5.42,"end":8.6,"text":"Вначале была какая-то певица, ну, рассказываю, потому что"},{"start":8.6,"end":9.6,"text":"многим интересно, думаю."},{"start":9.96,"end":11.32,"text":"Была какая-то певица, ноунейм."},{"start":11.98,"end":14.1,"text":"Она пела, если честно, не попадала в ноты"},{"start":14.1,"end":16.32,"text":"местами. Ну, я сама грешная иногда."},{"start":18.68,"end":20.16,"text":"Потом... Свет показ."},{"start":21.46,"end":24.24,"text":"Началась довольно такая жутковатая музыка."},{"start":24.98,"end":25.48,"text":"Белый куб."},{"start":26.58,"end":29.36,"text":"И оттуда уходит она."},{"start":30.18,"end":32.66,"text":"Билли Айлиш. Собственная персона."},{"start":33.84,"end":35.2,"text":"Она сразу начинает петь."},{"start":38.04,"end":40.04,"text":"И у меня появилось какое-то сознание, что, знаете,"},{"start":40.08,"end":40.86,"text":"она тоже человек."},{"start":41.14,"end":44.48,"text":"До этого это была тётя на..."},{"start":45.1,"end":48.14,"text":"Ну, допустим, тётя в гугле, которая всегда красивая."},{"start":48.18,"end":50.62,"text":"А сейчас я поняла, что она человек."},{"start":51.0,"end":52.76,"text":"И причём она очень добрая."},{"start":53.46,"end":54.44,"text":"Сейчас расскажу, почему."}],"verification":{"independent_review":false,"word_agreement":0.971,"needs_chunk_review":false}}
