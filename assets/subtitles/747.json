{"version":3,"track_id":747,"audio_sha256":"949c33a19fc1dab7cdedd97cc1543ebf996872c590a9ca207557b2bd5a40f2d9","duration":42.02,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":4.77,"text":"До скорых встреч на мятых простынях, цвета мак","source_line":8},{"start":6.58,"end":12.03,"text":"До скорых трепетных касаний содрогающихся рук","source_line":9},{"start":12.1,"end":15.05,"text":"Кого любят — того ждут","source_line":10},{"start":15.05,"end":18.78,"text":"Сквозь муки долгих ожиданий","source_line":11},{"start":18.78,"end":23.25,"text":"Мой любимый аромат, ты моя вторая кожа","source_line":12},{"start":23.25,"end":27.71,"text":"И, быть может, не сейчас, но когда-нибудь мы сможем","source_line":13},{"start":27.71,"end":31.95,"text":"Оторваться от земли, полететь против теченья","source_line":14},{"start":31.95,"end":38.20000076293945,"text":"Ничего не говори, возьми руку и беги (беги, беги)","source_line":15}],"verification":{"source_text_checked":true,"word_agreement":0.907,"matched_words":49,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.671},"song":"ALMARY","artist":"До скорых встреч","source_url":"https://lrclib.net/api/get/15992223","source_sha256":"5626b7b3c3240c2f869dee08e4eb8ca3466f3a9bcf42df18b8dc0eeb44a12982"}
