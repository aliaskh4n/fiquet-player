{"version":2,"track_id":747,"audio_sha256":"949c33a19fc1dab7cdedd97cc1543ebf996872c590a9ca207557b2bd5a40f2d9","duration":42.02,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":4.16,"text":"До скорых встреч на мятых простынях, цвета мак","source_line":0},{"start":6.63,"end":11.94,"text":"До скорых трепетных касаний содрогающихся рук","source_line":1},{"start":15.1,"end":18.86,"text":"Сквозь муки долгих ожиданий","source_line":11},{"start":18.86,"end":23.3,"text":"Мой любимый аромат, ты моя вторая кожа","source_line":12},{"start":23.3,"end":27.76,"text":"И, быть может, не сейчас, но когда-нибудь мы сможем","source_line":13},{"start":27.76,"end":31.24,"text":"Оторваться от земли, полететь против теченья","source_line":14},{"start":32.0,"end":38.2,"text":"Ничего не говори, возьми руку и беги (беги, беги)","source_line":15}],"verification":{"source_text_checked":true,"word_agreement":0.907,"matched_words":49,"timing":"cached_word_anchors"},"song":"ALMARY","artist":"До скорых встреч","source_url":"https://lrclib.net/api/get/15992223","source_sha256":"5626b7b3c3240c2f869dee08e4eb8ca3466f3a9bcf42df18b8dc0eeb44a12982"}
