{"version":1,"track_id":665,"audio_sha256":"4e4ada32a2c01e78eecb0718ee7b4650f317b5aa3c1881fb00d20b79369550e0","duration":117.9,"language":"russian","status":"ready","lines":[{"start":0,"end":1.86,"text":"У меня настроение сыграть вам нервы, поэтому я"},{"start":1.86,"end":3.0,"text":"вам сейчас сыграю нервы."},{"start":30.6,"end":34.78,"text":"И кто из нас больной, если ты все"},{"start":34.78,"end":36.2,"text":"еще со мной."},{"start":36.96,"end":41.86,"text":"Демоны не спят, ночью я уеду в ад."},{"start":42.2,"end":47.24,"text":"И ты одна можешь достать меня со дна."},{"start":59.1,"end":66.34,"text":"Тупые подруги, печальные суки."},{"start":76.0,"end":76.76,"text":"Дверь пиздевы, тебе в мои дозы."},{"start":77.32,"end":80.76,"text":"Ты бы охуела даже от одной, разбираюсь на"},{"start":82.04,"end":84.2,"text":"что со мной."},{"start":84.78,"end":87.86,"text":"И кто из нас больной, если ты все"},{"start":87.86,"end":89.24,"text":"еще со мной."},{"start":89.9,"end":94.84,"text":"Демоны не спят, ночью я уеду в ад."},{"start":95.3,"end":99.74,"text":"И ты одна можешь достать меня со дна."}],"verification":{"independent_review":true,"word_agreement":0.678,"review_model":"gpt-4o-transcribe","unanchored_words":37,"needs_chunk_review":false}}
