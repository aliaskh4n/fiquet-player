{"version":1,"track_id":1004,"audio_sha256":"fa9c0694b7275ff89a452c81954f2e7371ef8316c1a1af9b9768a6f659f0b9d3","duration":47.39,"language":"russian","status":"ready","lines":[{"start":0,"end":2.82,"text":"Окей, погнали. Я хочу еще начать с этого."},{"start":6.12,"end":7.68,"text":"Любовная сцена, дубль первый."},{"start":10.64,"end":15.18,"text":"Ты абсолютно везде, ты абсолютно всегда, ты на"},{"start":15.18,"end":18.2,"text":"земле и в воде, ты все минуты в"},{"start":18.2,"end":21.48,"text":"годах, ты будто наш президент, что целый день"},{"start":22.66,"end":24.64,"text":"на гостях, ты как мета в городах, и"},{"start":24.64,"end":27.94,"text":"я тобою пропах, ты будто воздух,"},{"start":30.0,"end":31.04,"text":"я будто ноздри."},{"start":33.76,"end":36.74,"text":"Не будь серьезной,"},{"start":38.22,"end":40.08,"text":"все очень просто."},{"start":42.82,"end":44.58,"text":"Пока не идеально, но как запишу кавер, там"},{"start":44.58,"end":45.64,"text":"будет все отлично."}],"verification":{"independent_review":true,"word_agreement":0.914,"review_model":"gpt-4o-transcribe","unanchored_words":6,"needs_chunk_review":false}}
