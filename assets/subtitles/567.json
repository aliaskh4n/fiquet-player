{"version":1,"track_id":567,"audio_sha256":"9cfcd2ad4d79d59783294a4427159c2f050909a4f71514626728cfba83893bcf","duration":59.67,"language":"russian","status":"ready","lines":[{"start":0,"end":1.62,"text":"Марго, скажи им."},{"start":1.64,"end":2.44,"text":"Я бы уголовник."},{"start":4.42,"end":5.98,"text":"Хочешь показать?"},{"start":10.32,"end":13.4,"text":"И второе, у неё ногти, поэтому она сегодня"},{"start":13.4,"end":16.18,"text":"на своём бубне, а я гитарист, получается."},{"start":17.6,"end":21.38,"text":"Я снова маленький солнце, я для мамы опять"},{"start":21.38,"end":28.08,"text":"сильнейший. Я снова боюсь собак оставаться без квартиры."},{"start":28.08,"end":32.12,"text":"А деревья такие большие, незнакомые пути."},{"start":32.66,"end":34.48,"text":"Слова поиграют в прятки."},{"start":35.98,"end":39.4,"text":"Мне как раньше по полу я сдала, я"},{"start":39.4,"end":42.14,"text":"не достаю до пола ногами."},{"start":43.5,"end":48.08,"text":"Или пол до моих ног не достает."},{"start":49.58,"end":52.54,"text":"Дома я считаю врагами,"},{"start":54.66,"end":59.52,"text":"просто делают мёд, а крышок заканчивается."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
