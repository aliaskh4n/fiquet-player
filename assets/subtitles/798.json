{"version":1,"track_id":798,"audio_sha256":"ac281dced5514fe11e6bc7b3e2c00d1515c2b827bded981279d2ef725e3d8f41","duration":15.15,"language":"russian","status":"ready","lines":[{"start":0,"end":1.96,"text":"Мне, кстати, сказали, что мой этот смех похож."},{"start":2.14,"end":4.36,"text":"Это я впервые так смеюсь."},{"start":4.98,"end":7.86,"text":"Мне кажется, реально у меня просто уже всё."},{"start":8.7,"end":10.5,"text":"Ну, мне сказали, что я похожа на кролика,"},{"start":11.66,"end":12.24,"text":"когда так смеюсь."},{"start":12.7,"end":14.0,"text":"Но, по-моему, нет, по-моему, нет."},{"start":14.04,"end":14.9,"text":"Это не кролик."}],"verification":{"independent_review":false,"word_agreement":0.95,"needs_chunk_review":false}}
