{"version":2,"track_id":101,"audio_sha256":"3593dbaabe40c2456a2822f09138d8d5064b08905a1b2e581bec6af283885f65","duration":88.5,"origin":"original_lyrics","status":"ready","lines":[{"start":1.54,"end":3.54,"text":"Падал мокрый снег","source_line":0},{"start":3.54,"end":7.42,"text":"Между тем и новостей","source_line":1},{"start":7.56,"end":11.22,"text":"А я отдала тебе","source_line":2},{"start":11.22,"end":12.9,"text":"Свое сердце","source_line":3},{"start":12.9,"end":15.3,"text":"Среди серых стен","source_line":4},{"start":15.92,"end":18.28,"text":"А ты наискосок","source_line":5},{"start":18.28,"end":22.08,"text":"Свои чувства - на замок","source_line":6},{"start":22.94,"end":25.72,"text":"А хотелось как у всех","source_line":7},{"start":26.26,"end":27.28,"text":"Как же долго","source_line":8},{"start":30.24,"end":31.0,"text":"Снег","source_line":11},{"start":31.0,"end":34.56,"text":"У тебя нет пути назад","source_line":12},{"start":34.86,"end":38.36,"text":"Растает все, что ты сказал","source_line":13},{"start":38.52,"end":41.18,"text":"Меня кусают слезы","source_line":14},{"start":45.68,"end":49.08,"text":"Но пока рука в моей руке","source_line":16},{"start":49.94,"end":52.84,"text":"Ты назовешь меня никем","source_line":17},{"start":53.46,"end":56.16,"text":"Зачем скучаю очень","source_line":18},{"start":56.16,"end":56.96,"text":"Долго","source_line":19},{"start":59.82,"end":60.14,"text":"Снег","source_line":21},{"start":60.14,"end":61.78,"text":"В мои глаза","source_line":22},{"start":62.84,"end":65.62,"text":"Не могу, хочу назад","source_line":23},{"start":66.38,"end":69.34,"text":"Пальцы тянутся в ночи","source_line":24},{"start":72.0,"end":74.02,"text":"Город дышит и молчит","source_line":26},{"start":74.02,"end":75.82,"text":"Наедине","source_line":27},{"start":76.86,"end":79.44,"text":"Слышу мысли обо мне","source_line":28},{"start":80.28,"end":83.24,"text":"А хотелось как у всех","source_line":29}],"verification":{"source_text_checked":true,"word_agreemen