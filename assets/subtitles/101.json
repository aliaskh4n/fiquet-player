{"version":3,"track_id":101,"audio_sha256":"3593dbaabe40c2456a2822f09138d8d5064b08905a1b2e581bec6af283885f65","duration":88.5,"origin":"original_lyrics","status":"ready","lines":[{"start":0.88,"end":3.49,"text":"Падал мокрый снег","source_line":0},{"start":3.49,"end":7.5,"text":"Между тем и новостей","source_line":1},{"start":7.5,"end":11.17,"text":"А я отдала тебе","source_line":2},{"start":11.17,"end":12.85,"text":"Свое сердце","source_line":3},{"start":12.85,"end":15.28,"text":"Среди серых стен","source_line":4},{"start":15.28,"end":18.23,"text":"А ты наискосок","source_line":5},{"start":18.23,"end":22.08,"text":"Свои чувства - на замок","source_line":6},{"start":22.08,"end":26.12,"text":"А хотелось как у всех","source_line":7},{"start":26.12,"end":27.41,"text":"Как же долго","source_line":8},{"start":27.54,"end":28.41,"text":"Падал","source_line":9},{"start":28.44,"end":30.1,"text":"Прошлогодний","source_line":10},{"start":30.1,"end":30.95,"text":"Снег","source_line":11},{"start":30.95,"end":34.67,"text":"У тебя нет пути назад","source_line":12},{"start":34.78,"end":38.32,"text":"Растает все, что ты сказал","source_line":13},{"start":38.32,"end":41.3,"text":"Меня кусают слезы","source_line":14},{"start":41.3,"end":44.74,"text":"Я приду сегодня поздно","source_line":15},{"start":44.74,"end":49.13,"text":"Но пока рука в моей руке","source_line":16},{"start":49.38,"end":52.91,"text":"Ты назовешь меня никем","source_line":17},{"start":53.08,"end":56.11,"text":"Зачем скучаю очень","source_line":18},{"start":56.11,"end":56.959999084472656,"text":"Долго","source_line":19},{"start":57.04,"end":59.68,"text":"Падал прошлогодний","source_line":20},{"start":59.68,"end":60.08,"text":"Снег","source_line":21},{"start":60.08,"end":62.0,"text":"В мои глаза","source_line":22},{"start":62.32,"end":65.76,"text":"Не могу, хочу назад","source_line":23},{"start":65.76,"end":69.4399995803833,"text":"Пальцы тянутся в ночи","source_line":24},{"start":69.68,"end":70.96,"text":"Город плачет","source_line":25},{"start":70.96,"end":73.97,"text":"Город дышит и молчит","source_line":26},{"start":73.97,"end":75.87,"text":"Наедине","source_line":27},{"start":76.28,"end":79.6399998664856,"text":"Слышу мысли обо мне","source_line":28},{"start":79.77,"end":85.04000091552734,"text":"А хотелось как у всех","source_line":29}],"verification":{"source_text_checked":true,"word_agreement":0.875,"matched_words":84,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.381},"song":"Снег","artist":"fiquet","source_url":"https://lrclib.net/api/get/34250048","source_sha256":"a8174df8ab573c143ad669ed21961209599afde2de10c77e6c1e1a62d089f9e8"}
