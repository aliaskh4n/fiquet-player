{"version":1,"track_id":180,"audio_sha256":"75cc87ec00a1639df960cee1129add3d83ecb56c3236e9d2ab7264da515cdfe9","duration":38.68,"language":"russian","status":"ready","lines":[{"start":0.74,"end":3.24,"text":"Ребят, сейчас будет скрипка."},{"start":5.58,"end":9.12,"text":"Многие меня спрашивали под видосом последним, выздоровела ли"},{"start":9.12,"end":11.52,"text":"я или нет, и сказали, что вы ждёте"},{"start":11.52,"end":12.5,"text":"новостей в ТГК."},{"start":13.36,"end":15.46,"text":"Новости такие. Я не выздоровела."},{"start":18.14,"end":19.86,"text":"Я вам больна пела."},{"start":22.06,"end":22.72,"text":"Это что такое?"},{"start":24.18,"end":25.72,"text":"И насчёт стрима."},{"start":25.94,"end":27.8,"text":"Я очень хочу выйти на стрим, но вы"},{"start":27.8,"end":29.72,"text":"видите, как я выгляжу, какая у меня голова,"},{"start":30.56,"end":33.84,"text":"собственно, грязная. И как-то я не знаю, на"},{"start":33.84,"end":35.72,"text":"стрим стоит ли выходить так или нет."}],"verification":{"independent_review":false,"word_agreement":0.971,"needs_chunk_review":false}}
