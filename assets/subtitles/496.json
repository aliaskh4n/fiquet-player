{"version":1,"track_id":496,"audio_sha256":"0af44f849839453e1807fe6705a52fdbabf3ccb23ece92ec8852736abdab1aed","duration":18.26,"language":"russian","status":"ready","lines":[{"start":0,"end":3.0,"text":"Вот этот хоккеист был первым мальчиком, который позвал"},{"start":3.0,"end":3.68,"text":"меня в кино."},{"start":5.58,"end":9.58,"text":"Он еще сделал мне красивое письмо, конверт сам"},{"start":9.58,"end":12.88,"text":"сделал, сердечко там нарисовал и подарил мне."},{"start":13.96,"end":16.34,"text":"Там было написано «Я, ты мне очень нравишься,"},{"start":16.36,"end":18.18,"text":"я приглашаю тебя в кино»."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
