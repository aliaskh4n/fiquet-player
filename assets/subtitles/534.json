{"version":2,"track_id":534,"audio_sha256":"dd774c60165b45e399d7e2f10bf876571ead457510f5627936cd26502515e0d7","duration":30.17,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":3.04,"text":"Я никогда не буду работать","source_line":3},{"start":3.2,"end":5.38,"text":"Ни за что не окунусь в эту пропасть","source_line":4},{"start":5.38,"end":7.74,"text":"Буду самым первым на глупость","source_line":5},{"start":7.9,"end":9.94,"text":"А для моей мамы — это преступность","source_line":6},{"start":9.94,"end":12.34,"text":"Я буду завтракать вечно обедом","source_line":7},{"start":12.48,"end":14.16,"text":"На кроватке, укрывшись пледом","source_line":8},{"start":14.54,"end":16.8,"text":"Все спросят как ты? Как настроение?","source_line":9},{"start":17.2,"end":18.22,"text":"Я отвечу: Оно ахуенное","source_line":10}],"verification":{"source_text_checked":true,"word_agreement":0.976,"matched_words":40,"timing":"cached_word_anchors"},"song":"Мяу мяу мяу","artist":"Шарлот","source_url":"https://lrclib.net/api/get/36745791","source_sha256":"e2b593c1a70e3364abc2e44e2cc1ee19ee396b6cf75257ce424cc0e3ef78c5bb"}
