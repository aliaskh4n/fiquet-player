{"version":1,"track_id":467,"audio_sha256":"cb820689da54e3dc525068fbec4bd0ae1c8e4d46668238648f1e1ce1919e14c9","duration":13.57,"language":"russian","status":"ready","lines":[{"start":0,"end":2.72,"text":"Вы сейчас, скорее всего, спите, но смотрите, в"},{"start":2.72,"end":3.28,"text":"каком я аутфите."},{"start":3.72,"end":6.36,"text":"И этот аутфит полностью соответствует моему новому каверу."},{"start":7.02,"end":9.36,"text":"Я прошу вас посмотреть, потому что я не"},{"start":9.36,"end":11.24,"text":"видела ни одного кавера на эту песню."},{"start":11.88,"end":12.8,"text":"Я первая. Надеюсь."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
