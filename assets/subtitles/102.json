{"version":1,"track_id":102,"audio_sha256":"f15e4d68682071c7db41be39ff2728560d0b676181840f1c3e7964ffdbe582b3","duration":60.1,"language":"russian","status":"ready","lines":[{"start":1.88,"end":6.04,"text":"Вдруг это не кровь, а разбавленные краски, вдруг"},{"start":6.04,"end":9.14,"text":"это все сон, ты считаешь мне сказки."},{"start":9.14,"end":12.3,"text":"Воздух стал липким, я не могу дышать, оказалась"},{"start":14.22,"end":15.52,"text":"липкой, я ложусь спать."},{"start":22.7,"end":27.24,"text":"Закрываю уши, я слышу грозу, маленькие твари вокруг"},{"start":28.36,"end":34.12,"text":"нам лесу. Стреляй, во мне больше не будет"},{"start":35.48,"end":40.74,"text":"смысла, во мне точно не было смысла, смысла."},{"start":41.24,"end":45.12,"text":"Я тоже буду скучать, стреляй,"},{"start":46.12,"end":48.76,"text":"меня больше не будет слышно."},{"start":48.76,"end":54.28,"text":"Во мне точно не было смысла, смысла."},{"start":54.68,"end":57.52,"text":"Я тоже буду скучать."}],"verification":{"independent_review":true,"word_agreement":0.903,"review_model":"gpt-4o-transcribe","unanchored_words":7,"needs_chunk_review":false}}
