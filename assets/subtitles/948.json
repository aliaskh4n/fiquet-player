{"version":1,"track_id":948,"audio_sha256":"796d34dbe0e8bffc7bea7ec143839e5d32053436de935286ef6c5e123702071a","duration":20.15,"language":"russian","status":"ready","lines":[{"start":2.36,"end":3.54,"text":"Во-первых, я не знаю, почему я вот так"},{"start":3.54,"end":5.42,"text":"вот руками, оказывается, делаю, когда пою."},{"start":5.76,"end":6.36,"text":"А это и есть же..."},{"start":6.36,"end":7.42,"text":"Ну, ладно, покинь и суть."},{"start":7.7,"end":7.88,"text":"Хорошо."},{"start":9.44,"end":11.32,"text":"И, второе, почему я так сильно сутуюсь?"},{"start":11.7,"end":12.92,"text":"Я думала, у меня..."},{"start":12.92,"end":14.26,"text":"Ну, сейчас у меня ровная осанка."},{"start":15.5,"end":16.98,"text":"Но почему я, когда пою, я вот так"},{"start":16.98,"end":17.26,"text":"делаю?"},{"start":18.66,"end":19.72,"text":"Я буду над этим работать."}],"verification":{"independent_review":false,"word_agreement":0.982,"needs_chunk_review":false}}
