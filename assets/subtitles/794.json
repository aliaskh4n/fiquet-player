{"version":1,"track_id":794,"audio_sha256":"831169f79e96a3b1f5ca4effb7e9f694ce2acf03caa6a9b9e37f6dd283c49068","duration":53.99,"language":"russian","status":"ready","lines":[{"start":0.76,"end":2.32,"text":"Кто-то ещё просил у меня обзор на комнату,"},{"start":2.5,"end":4.4,"text":"у меня уже есть фотка полной комнаты, но"},{"start":4.4,"end":5.26,"text":"давайте так начнём."},{"start":5.64,"end":9.12,"text":"Это более подробный гайд, я без понятия."},{"start":10.44,"end":10.68,"text":"Тут дверь, почапали-почапали."},{"start":15.2,"end":18.26,"text":"На столе у меня сейчас беспорядок, но это"},{"start":18.26,"end":18.82,"text":"творческое."},{"start":19.8,"end":20.56,"text":"Там нету близкими деревьев."},{"start":20.66,"end":23.6,"text":"У меня некоторые изменения в комнате, поскольку нужно"},{"start":23.6,"end":23.98,"text":"учиться."},{"start":26.24,"end":28.3,"text":"Потом тут моя кровать, я тут лежу и"},{"start":28.3,"end":29.24,"text":"зачастую снимаю каверы."},{"start":30.34,"end":31.26,"text":"Вот моя лампа,"},{"start":32.96,"end":33.86,"text":"вот я."},{"start":36.24,"end":37.08,"text":"Хорошо,"},{"start":38.4,"end":41.36,"text":"что ещё? Тут у меня два больших окна"},{"start":41.36,"end":44.42,"text":"и крутой ночник-телевизор."},{"start":46.96,"end":47.7,"text":"Я смогу его включить?"}],"verification":{"independent_review":false,"word_agreement":0.964,"needs_chunk_review":false}}
