{"version":1,"track_id":967,"audio_sha256":"a02ef5e001e6fc57f9a9766c9499d6277d278b5e3456ea6f6d48436a56b9dc5e","duration":45.15,"language":"russian","status":"ready","lines":[{"start":0.74,"end":1.46,"text":"Третья часть."},{"start":3.76,"end":6.84,"text":"Это не совсем украшение, это бутылочка с цветами."},{"start":6.84,"end":8.02,"text":"Я не знаю, почему она здесь."},{"start":9.42,"end":11.02,"text":"Мне нужно всё распутать."},{"start":12.22,"end":13.9,"text":"У меня не проколты уши."},{"start":14.5,"end":15.68,"text":"Ну, хотя это будет интересно."},{"start":15.78,"end":18.22,"text":"Ну, в общем, поэтому я ношу клипсы."},{"start":18.58,"end":21.36,"text":"Вот, у меня есть клипсы с жемчужинками."},{"start":21.52,"end":23.7,"text":"У меня куча была, но они все потерялись"},{"start":25.58,"end":27.16,"text":"где-то. Так. Ух, распутать надо."},{"start":27.48,"end":28.28,"text":"Ух, распутать надо."},{"start":29.04,"end":30.34,"text":"Ух, распутать надо."},{"start":33.14,"end":35.06,"text":"Так, друзья, обзор на этом заканчивается."},{"start":35.22,"end":37.2,"text":"Ну, в принципе, я всё показала, то, что"},{"start":37.2,"end":37.7,"text":"у меня есть."},{"start":37.98,"end":38.52,"text":"У меня не так много."},{"start":42.72,"end":44.48,"text":"Я не знаю, как это носить, честно."}],"verification":{"independent_review":false,"word_agreement":0.989,"needs_chunk_review":false}}
