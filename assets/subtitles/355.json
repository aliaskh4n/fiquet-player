{"version":1,"track_id":355,"audio_sha256":"64cd845c4fe051bcf1bbf624a76a39e6b977b1c44dd64269c2364e7d30769cd7","duration":22.04,"language":"russian","status":"ready","lines":[{"start":0.84,"end":3.68,"text":"Я видела… Сейчас, волосы ещё просеиваю."},{"start":4.74,"end":8.26,"text":"Я видела, что кто-то говорил, что хочет уснуть"},{"start":8.26,"end":9.04,"text":"под мой голос."},{"start":10.24,"end":13.46,"text":"Я вот думаю, может, через полчасика…"},{"start":13.46,"end":16.26,"text":"Ну где-то тоже на полчасика приблизительно стрим, где"},{"start":16.26,"end":17.48,"text":"я попою вам колыбельки."},{"start":18.74,"end":20.9,"text":"Как думаем? Или мы спим?"}],"verification":{"independent_review":false,"word_agreement":0.95,"needs_chunk_review":false}}
