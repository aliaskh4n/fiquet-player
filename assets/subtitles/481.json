{"version":3,"track_id":481,"audio_sha256":"ef610669510da4609cc128e1ca3a8689dc89941e8cdb3807251b81cdad8b28d7","duration":78.23,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":2.3,"text":"А я всегда буду курить","source_line":8},{"start":2.3,"end":5.12,"text":"Пусть мои волосы впитают этот дым","source_line":9},{"start":5.12,"end":8.1,"text":"Ты знаешь то, что мне легче тебя убить","source_line":10},{"start":8.1,"end":11.520000457763672,"text":"Чем подарить тебе свободу в этот мир","source_line":11},{"start":12.56,"end":14.46,"text":"Ты и я","source_line":12},{"start":14.46,"end":17.5,"text":"Потерялись среди тысячи планет","source_line":13},{"start":17.5,"end":20.5,"text":"Как не сойти с ума","source_line":14},{"start":20.74,"end":24.21,"text":"Приняв то, что нас там больше нет?","source_line":15},{"start":24.28,"end":26.55,"text":"(Пам-парам, па-пам-парарам)","source_line":16},{"start":27.62,"end":35.43,"text":"(Пам-парам, па-пам-парарам)","source_line":17},{"start":35.43,"end":38.3,"text":"Я никогда не брошу пить","source_line":18},{"start":38.3,"end":41.16,"text":"Пусть всегда буду я весёлый и бухой","source_line":19},{"start":41.16,"end":44.1,"text":"Ты знаешь то, что мне легче тебя забыть","source_line":20},{"start":44.1,"end":47.02,"text":"Чем быть одиноким волком под луной","source_line":21},{"start":47.02,"end":50.22,"text":"И ты нашла уже тысячи причин","source_line":22},{"start":50.22,"end":53.06,"text":"Чтобы не смотреть в мои глаза","source_line":23},{"start":53.06,"end":55.86,"text":"Но почему-то среди тысячи мужчин","source_line":24},{"start":55.86,"end":59.02000045776367,"text":"Ты выбираешь сумасшедшего меня","source_line":25}],"verification":{"source_text_checked":true,"word_agreement":0.843,"matched_words":75,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.45},"song":"Среди тысячи","artist":"SunThugga","source_url":"https://lrclib.net/api/get/110390