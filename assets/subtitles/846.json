{"version":3,"track_id":846,"audio_sha256":"0fe8530af289f462dce07f76aa5dbf249362378b9c954597eb74d27bc9f5771d","duration":47.0,"origin":"original_lyrics","status":"ready","lines":[{"start":0.94,"end":7.260000228881836,"text":"Я всего лишь подохну тут, в этом чёртовом Питере","source_line":16},{"start":7.94,"end":12.859999656677246,"text":"Нелюбимая, страшная, как в РФ демократия","source_line":17},{"start":13.72,"end":19.35,"text":"У тебя через поцелуй забрала все проклятия","source_line":18},{"start":20.28,"end":23.2,"text":"Если меня собьёт машина — это будет твой отец","source_line":19},{"start":23.2,"end":25.82,"text":"На тебя лишь посмотрела, поняла, что мне конец","source_line":20},{"start":25.82,"end":28.32,"text":"Если не проснусь наутро — это будет твоя мать","source_line":21},{"start":28.32,"end":30.39,"text":"Всё прощу, и их не буду оскорблять","source_line":22},{"start":30.39,"end":33.42,"text":"Если меня собьёт машина — это будет твой отец","source_line":23},{"start":33.42,"end":36.38,"text":"На тебя лишь посмотрела, поняла, что мне конец","source_line":24},{"start":36.38,"end":38.91,"text":"Не расстраивайся, детка, ни при чём твоя семья","source_line":25},{"start":38.91,"end":41.43,"text":"Виновата только я, я-я-я-я","source_line":26}],"verification":{"source_text_checked":true,"word_agreement":0.928,"matched_words":64,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.398},"song":"Неудачница","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/9532446","source_sha256":"64ee1201bd4ecac3c81bb2d9189598b1af4395eb6907f30cbdc9a69ece7db6be"}
