{"version":3,"track_id":91,"audio_sha256":"094b72173498fc95f8934205d69f39b2d5ee1e84cd9860661563939d14187028","duration":130.8,"origin":"original_lyrics","status":"ready","lines":[{"start":1.18,"end":8.15,"text":"Ты обещал, что я красивая","source_line":0},{"start":8.54,"end":10.76,"text":"Хочется фотографировать","source_line":1},{"start":10.76,"end":13.25,"text":"Плёнка заполнится снимками","source_line":2},{"start":13.56,"end":15.96,"text":"Глазами зелёными, синими","source_line":3},{"start":15.96,"end":19.85,"text":"Здесь поцелуи и фотографии","source_line":4},{"start":20.52,"end":22.78,"text":"Наши альбомы, гербарии","source_line":5},{"start":22.78,"end":25.89,"text":"Ты изменял — я разбила аквариум","source_line":6},{"start":26.16,"end":26.97,"text":"Пореву","source_line":7},{"start":28.56,"end":31.26,"text":"Фотоплёнка забита чувствами","source_line":8},{"start":31.26,"end":34.28,"text":"Мне придётся всё удалить","source_line":9},{"start":34.28,"end":36.85,"text":"Фотография — не искусство","source_line":10},{"start":37.06,"end":39.88,"text":"Фотографировать — не любить","source_line":11},{"start":39.88,"end":42.59,"text":"Я поймала все твои родинки","source_line":12},{"start":42.62,"end":45.33,"text":"Их теперь не смогу забыть","source_line":13},{"start":45.46,"end":47.99,"text":"Фотография — лишь пародия","source_line":14},{"start":48.2,"end":50.28,"text":"Фотографировать — не любить","source_line":15},{"start":50.28,"end":53.77,"text":"Не любить, не любить, не любить, не любить, не любить","source_line":16},{"start":55.0,"end":60.15,"text":"Фотографировать — не любить","source_line":18},{"start":61.54,"end":65.86,"text":"Рядом с тобой проявились демоны","source_line":19},{"start":65.86,"end":68.16,"text":"Плачут кровавыми стенами","source_line":20},{"start":68.16,"end":70.9,"text":"Даже они извиняются без конца","source_line":21},{"start":70.9,"end":72.98,"text":"Как же мне это, блин, нравится","source_line":22},{"start":72.98,"end":76.87,"text":"Ты мой любимый ребёнок анархии","source_line":23},{"start":77.06,"end":79.3,"text":"По классу разбросаны парты","source_line":24},{"start":79.3,"end":81.73,"text":"И мелом рисую всё белое","source_line":25},{"start":82.08,"end":84.43,"text":"Последнее фото сделано","source_line":26},{"start":85.06,"end":87.7,"text":"Фотоплёнка забита чувствами","source_line":27},{"start":87.7,"end":90.63,"text":"Мне придётся всё удалить","source_line":28},{"start":90.72,"end":93.31,"text":"Фотография — не искусство","source_line":29},{"start":93.54,"end":96.36,"text":"Фотографировать — не любить","source_line":30},{"start":96.36,"end":98.98,"text":"Я поймала все твои родинки","source_line":31},{"start":98.98,"end":101.87,"text":"Их теперь не смогу забыть","source_line":32},{"start":102.08,"end":104.61,"text":"Фотография — лишь пародия","source_line":33},{"start":104.86,"end":129.07,"text":"Фотографировать — не любить","source_line":34}],"verification":{"source_text_checked":true,"word_agreement":0.92,"matched_words":92,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.56},"song":"Фотография","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/14303098","source_sha256":"424ddb26e639c1d406a0551c0324436052be15c425684cbeab1689053410d2c1"}
