{"version":1,"track_id":91,"audio_sha256":"094b72173498fc95f8934205d69f39b2d5ee1e84cd9860661563939d14187028","duration":130.8,"language":"russian","status":"ready","lines":[{"start":0,"end":2.52,"text":"Так, заново фотография Лена Швец."},{"start":3.06,"end":30.3,"text":"Пою. Еще что-то я красавица."},{"start":30.3,"end":31.42,"text":"Поливаю. Фотопленка забита чувствами."},{"start":31.58,"end":34.28,"text":"Мне придется все удалить."},{"start":36.14,"end":36.82,"text":"Фотографии не искусство."},{"start":37.52,"end":39.86,"text":"Фотографировать не любить."},{"start":39.96,"end":41.74,"text":"Я помыла все твои розинки."},{"start":42.92,"end":45.2,"text":"Их теперь не смогу забыть."},{"start":46.02,"end":47.88,"text":"Фотография лишь пародия."},{"start":48.58,"end":51.48,"text":"Фотографировать не любить."},{"start":52.08,"end":53.98,"text":"Не любить, не любить, не любить."},{"start":61.86,"end":65.08,"text":"Рядом с тобой появились демоны."},{"start":66.32,"end":68.1,"text":"Плачут кровавыми стенами."},{"start":68.62,"end":68.82,"text":"Даже они изменяются."},{"start":71.66,"end":72.94,"text":"Мне это, блин, нравится."},{"start":75.02,"end":75.74,"text":"Боль. По любимой ребенок анархии."},{"start":77.32,"end":77.52,"text":"По классу распался на порты и меланы."},{"start":80.62,"end":81.68,"text":"Свое все белое."},{"start":82.38,"end":84.4,"text":"Последнее фото сделано."},{"start":85.2,"end":87.78,"text":"Фотопленка забита чувствами."},{"start":87.78,"end":90.52,"text":"Мне придется все удалить."},{"start":92.64,"end":93.3,"text":"Фотографии не искусство."},{"start":93.94,"end":96.32,"text":"Фотографировать не любить."},{"start":96.44,"end":98.36,"text":"Я помыла все твои розинки."},{"start":99.5,"end":101.84,"text":"Их теперь не смогу забыть."},{"start":102.42,"end":104.58,"text":"Фотография лишь пародия."},{"start":123.98,"end":124.22,"text":"Фотографировать не любить."}],"verification":{"independent_review":true,"word_agreement":0.634,"review_model":"gpt-4o-t