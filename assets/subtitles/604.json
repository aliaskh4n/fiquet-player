{"version":1,"track_id":604,"audio_sha256":"d677fee2da348baac42d66bf67615420f01988e93de09631ec020c7057f60c14","duration":25.2,"language":"russian","status":"ready","lines":[{"start":0,"end":2.72,"text":"Кстати, сейчас мы будем тестировать новый шампунь."},{"start":2.82,"end":4.16,"text":"Подождите. Подождите."},{"start":8.62,"end":10.74,"text":"Такой шампунь у меня есть, и он должен"},{"start":10.74,"end":12.34,"text":"затемнить мой цвет волос."},{"start":12.46,"end":14.32,"text":"Поэтому сейчас я вам покажу до, а потом"},{"start":14.32,"end":16.94,"text":"покажу после. По-моему, слишком много контента за сегодня,"},{"start":17.0,"end":18.9,"text":"но ладно. Вот такой до."},{"start":19.98,"end":21.8,"text":"Они грязные, если что,"},{"start":23.1,"end":24.88,"text":"и не расчесанные, видимо."}],"verification":{"independent_review":false,"word_agreement":0.98,"needs_chunk_review":false}}
