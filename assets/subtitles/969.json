{"version":1,"track_id":969,"audio_sha256":"9adc28fb7b4dea8aa9b4d77648b6b1f1ed1bbc7e16e8a88dfae90f45478734ef","duration":22.72,"language":"russian","status":"ready","lines":[{"start":0,"end":4.1,"text":"Пока я вела эфир, подписалось, по-моему, 59 человек"},{"start":4.1,"end":7.84,"text":"на телеграм-канал. Неужели моя реклама так работает?"},{"start":8.26,"end":8.76,"text":"Ошалеть."},{"start":9.7,"end":11.34,"text":"Блин, я по-моему скучаю, короче."},{"start":11.52,"end":13.4,"text":"Как будто... как будто родственника у меня отняли."},{"start":13.82,"end":15.34,"text":"Ладно, я буду вести эфиры чаще."},{"start":15.86,"end":16.54,"text":"Вот, намного чаще."},{"start":17.02,"end":19.2,"text":"И буду сюда писать и в Инстаграм, когда"},{"start":19.2,"end":20.6,"text":"будут эфиры."}],"verification":{"independent_review":false,"word_agreement":0.938,"needs_chunk_review":false}}
