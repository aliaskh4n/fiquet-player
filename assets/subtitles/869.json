{"version":1,"track_id":869,"audio_sha256":"88176d8c70fe1d8f9814cbf57d7290dfc474c24b8a18b1e945f2ddbfc921f4ad","duration":22.22,"language":"russian","status":"ready","lines":[{"start":0,"end":2.76,"text":"Это, конечно, не так важно, но посмотрите, как"},{"start":2.76,"end":5.02,"text":"ровно я заколола себе волосы."},{"start":5.1,"end":5.94,"text":"Это же просто."},{"start":7.66,"end":9.76,"text":"Я, наконец-то, научилась делать это ровно."},{"start":10.3,"end":11.38,"text":"А ещё всех с добрым утром."},{"start":11.66,"end":12.36,"text":"Я недавно встала."},{"start":14.2,"end":14.3,"text":"Вот."},{"start":16.76,"end":19.34,"text":"Через 40 минут пойду записывать вам каверы и"},{"start":19.34,"end":20.96,"text":"разборы. Всех целую."}],"verification":{"independent_review":false,"word_agreement":0.977,"needs_chunk_review":false}}
