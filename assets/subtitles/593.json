{"version":1,"track_id":593,"audio_sha256":"1ca243429f6ed793acdb1de5165adb86b0052bb24e1063e332cb1ceae465d874","duration":13.78,"language":"russian","status":"ready","lines":[{"start":0,"end":2.64,"text":"У меня в эту неделю был дикий регресс,"},{"start":2.82,"end":5.44,"text":"потому что я сделала и ногти, и аккорды"},{"start":5.44,"end":7.22,"text":"у меня плохо звучали, и еще заболела."},{"start":7.42,"end":8.6,"text":"Сейчас у меня нос заложен,"},{"start":9.5,"end":11.68,"text":"но я выздоровлю, и я нагоню всё."},{"start":12.46,"end":13.16,"text":"Вы не переживайте."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
