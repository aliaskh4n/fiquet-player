{"version":3,"track_id":1019,"audio_sha256":"14fb60397b4bae380c6b46f2b4f65a6bb11842286b5c760006ac74d5e2cd9736","duration":44.76,"origin":"original_lyrics","status":"ready","lines":[{"start":0.64,"end":3.98,"text":"Я не хочу искать сотни других","source_line":15},{"start":3.98,"end":5.98,"text":"Следы которых не видел в тебе","source_line":16},{"start":5.98,"end":8.67,"text":"Ты заменила мне целый мир","source_line":17},{"start":9.0,"end":11.32,"text":"И я спасу этот мир от всех бед","source_line":18},{"start":11.32,"end":12.5,"text":"Ты не такая, как все","source_line":19},{"start":12.5,"end":13.86,"text":"Все не такие, как ты","source_line":20},{"start":13.86,"end":16.61,"text":"Но мы в друг друге нашли все наши мечты","source_line":21},{"start":16.88,"end":19.55,"text":"На моём плече засыпает моё счастье","source_line":22},{"start":19.66,"end":20.59,"text":"Счастье","source_line":23},{"start":22.52,"end":27.7,"text":"Счастье моё — быть с тобой вдвоём","source_line":24},{"start":27.7,"end":32.73,"text":"Счастье моё — возвращаться домой","source_line":25},{"start":32.73,"end":37.63999938964844,"text":"Когда вокруг бесконечный бой","source_line":26},{"start":37.86,"end":40.17,"text":"В моём сердце мир","source_line":27},{"start":40.36,"end":42.9399995803833,"text":"В моём сердце покой","source_line":28}],"verification":{"source_text_checked":true,"word_agreement":0.75,"matched_words":12,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.451},"song":"Счастье","artist":"Нервы","source_url":"https://lrclib.net/api/get/35004904","source_sha256":"7bdb39912b89db482cef3fefcb940112f6be58b468359e25da9431466a71f736"}
