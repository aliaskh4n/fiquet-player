{"version":1,"track_id":296,"audio_sha256":"1666b07e59e8d0c76d99c8591243ed7c1a98f4f59b7d21a04a5deb93a69d7202","duration":21.85,"language":"russian","status":"ready","lines":[{"start":0.84,"end":3.78,"text":"Ребята, посмотрите на мой новый стиль и прикол"},{"start":3.78,"end":8.4,"text":"в том, что я сейчас, я сейчас ходила,"},{"start":8.56,"end":9.96,"text":"у меня, оказывается, штаны."},{"start":10.7,"end":11.74,"text":"Сейчас я покажу свои штаны."},{"start":12.76,"end":15.62,"text":"Тут у них такой пуговицы, пуговицы, вот, и,"},{"start":16.04,"end":16.2,"text":"о, привет."},{"start":17.28,"end":19.5,"text":"В общем, эта пуговица была расстёгнута, я просто"},{"start":19.5,"end":21.48,"text":"ходила практически без штанов всё это время."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
