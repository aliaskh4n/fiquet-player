{"version":1,"track_id":887,"audio_sha256":"727f1bfe0483e856e63fa27d8c29f7cc052e7b04405691e0d007f326bbdd7613","duration":14.47,"language":"russian","status":"ready","lines":[{"start":0,"end":2.32,"text":"Потому что я даже накрасилась ради этого, да?"},{"start":3.3,"end":6.06,"text":"И сейчас я хочу выложить, потому что, ну..."},{"start":6.62,"end":8.58,"text":"Я накрасилась, как бы, я не так часто"},{"start":8.58,"end":10.34,"text":"крашусь, и прикольно будет."},{"start":10.58,"end":12.24,"text":"Но я не знаю, какое мне выложить!"},{"start":12.48,"end":13.42,"text":"Я не знаю, какое."},{"start":13.42,"end":14.36,"text":"Мне нужна ваша помощь."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
