{"version":2,"track_id":117,"audio_sha256":"0994eabd705cd5f7c9da3080a6947e4df4e76069c7fbca5c32f587b4b5c963bd","duration":104.28,"origin":"original_lyrics","status":"ready","lines":[{"start":5.74,"end":7.46,"text":"На месте тапки,","source_line":27},{"start":8.28,"end":10.16,"text":"А человека нет.","source_line":28},{"start":14.96,"end":17.24,"text":"Горят напрасно,","source_line":31},{"start":18.28,"end":19.46,"text":"Пылают от тоски","source_line":32},{"start":20.24,"end":22.38,"text":"Ждут спички и табак","source_line":33},{"start":22.66,"end":25.0,"text":"Когда начнется спор","source_line":34},{"start":26.32,"end":27.52,"text":"Оставлены вот так","source_line":35},{"start":27.8,"end":29.44,"text":"не тронуты с тех пор","source_line":36},{"start":29.7,"end":32.04,"text":"А ты не близок не далёк,","source_line":37},{"start":32.54,"end":34.34,"text":"Не смотришь с высоты","source_line":38},{"start":35.08,"end":36.96,"text":"И где-то под землёй","source_line":39},{"start":40.14,"end":42.0,"text":"Вот, кажется пархнула","source_line":41},{"start":43.48,"end":46.88,"text":"Птичка с халата на пальто","source_line":42},{"start":49.54,"end":53.26,"text":"Ночь снова обманула","source_line":43},{"start":53.36,"end":57.22,"text":"В темноте привалилось не то.","source_line":44},{"start":58.94,"end":60.0,"text":"А ты исчез","source_line":45},{"start":61.34,"end":64.22,"text":"Ни в пустоте, ни в темноте не отыскать","source_line":46},{"start":66.52,"end":70.84,"text":"Ты слился с воздухом, ты превратился в дым,","source_line":47},{"start":70.84,"end":76.54,"text":"Остались буквы в документах, на счетах","source_line":48},{"start":77.44,"end":81.2,"text":"И эти буквы были именем твоим","source_line":49},{"start":87.16,"end":91.74,"text":"Ты слился с воздухом, ты превратился в дым,","source_line":22},{"start":92.76,"end":97.12,"text":"Остались буквы в документах, на счетах","source_line":23},{"start":97.12,"end":101.62,"text":"И эти буквы были именем твоим","source_line":24}],"verification":{"source_text_checked":true,"word_agreement":0.754,"matched_words":95,"timing":"cached_word_anchors"},"song":"Твоё имя","artist":"Монеточка","source_url":"https://lrclib.net/api/get/34517285","source_sha256":"4cf035d5e76d128682e4e65bbe998f8c38e9e9f2de00508cbeae54a6fd3fbe5e"}
