{"version":3,"track_id":117,"audio_sha256":"0994eabd705cd5f7c9da3080a6947e4df4e76069c7fbca5c32f587b4b5c963bd","duration":104.28,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":2.700000047683716,"text":"Здесь все впорядке,","source_line":25},{"start":2.9,"end":5.07,"text":"Здесь сохранился след,","source_line":26},{"start":5.56,"end":7.53,"text":"На месте тапки,","source_line":27},{"start":8.04,"end":10.25,"text":"А человека нет.","source_line":28},{"start":10.42,"end":12.55,"text":"Здесь не погасли","source_line":29},{"start":12.88,"end":14.91,"text":"Окурки, фитильки,","source_line":30},{"start":14.91,"end":17.239999771118164,"text":"Горят напрасно,","source_line":31},{"start":17.54,"end":19.459999084472656,"text":"Пылают от тоски","source_line":32},{"start":19.9,"end":22.45,"text":"Ждут спички и табак","source_line":33},{"start":22.46,"end":24.95,"text":"Когда начнется спор","source_line":34},{"start":24.95,"end":27.48,"text":"Оставлены вот так","source_line":35},{"start":27.48,"end":29.36,"text":"не тронуты с тех пор","source_line":36},{"start":29.36,"end":32.040000915527344,"text":"А ты не близок не далёк,","source_line":37},{"start":32.3,"end":34.34000015258789,"text":"Не смотришь с высоты","source_line":38},{"start":34.86,"end":37.05,"text":"И где-то под землёй","source_line":39},{"start":37.1,"end":39.85,"text":"Не ты не ты не ты не ты...","source_line":40},{"start":39.92,"end":43.42,"text":"Вот, кажется пархнула","source_line":41},{"start":43.42,"end":46.89,"text":"Птичка с халата на пальто","source_line":42},{"start":49.49,"end":53.2,"text":"Ночь снова обманула","source_line":43},{"start":53.2,"end":57.220001220703125,"text":"В темноте привалилось не то.","source_line":44},{"start":58.58,"end":60.87,"text":"А ты исчез","source_line":45},{"start":61.02,"end":66.23,"text":"Ни в пустоте, ни в темноте не отыскать","source_line":46},{"start":66.34,"end":70.79,"text":"Ты слился с воздухом, ты превратился в дым,","source_line":47},{"start":70.79,"end":76.44,"text":"Остались буквы в документах, на счетах","source_line":48},{"start":76.44,"end":81.19999694824219,"text":"И эти буквы были именем твоим","source_line":49},{"start":81.82,"end":86.77999877929688,"text":"Ни в пустоте, ни в темноте не отыскать","source_line":21},{"start":87.04,"end":91.73999786376953,"text":"Ты слился с воздухом, ты превратился в дым,","source_line":22},{"start":92.04,"end":96.96,"text":"Остались буквы в документах, на счетах","source_line":23},{"start":96.96,"end":102.85,"text":"И эти буквы были именем твоим","source_line":24}],"verification":{"source_text_checked":true,"word_agreement":0.754,"matched_words":95,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.569},"song":"Твоё имя","artist":"Монеточка","source_url":"https://lrclib.net/api/get/34517285","source_sha256":"4cf035d5e76d128682e4e65bbe998f8c38e9e9f2de00508cbeae54a6fd3fbe5e"}
