{"version":1,"track_id":269,"audio_sha256":"1fa950a96ea4f2ef7922ae116f7c307406c53be9ff4d7eb99e8a4b9a19a99aa2","duration":114.1,"language":"russian","status":"ready","lines":[{"start":0,"end":3.92,"text":"Йоу, всем привет, это разбор на супермаркет, да,"},{"start":4.36,"end":6.92,"text":"я уже изучилась, поэтому я буду пытаться, но"},{"start":6.92,"end":9.0,"text":"вначале я вам просто медленно сыграю, капну второй,"},{"start":9.6,"end":9.96,"text":"играем."},{"start":28.22,"end":30.3,"text":"Итак, зажимаем, аккордаем,"},{"start":31.32,"end":33.16,"text":"играем пятую и первую струну,"},{"start":34.22,"end":34.88,"text":"затем вторую,"},{"start":36.3,"end":39.32,"text":"ставим вот так вот руку, то есть мы"},{"start":39.32,"end":41.18,"text":"на первой струне зажимаем шестой лад,"},{"start":42.2,"end":43.62,"text":"на четвертой струне зажимаем третий,"},{"start":44.9,"end":49.02,"text":"затем играем третий лад на первой струне,"},{"start":50.18,"end":53.3,"text":"затем просто так,"},{"start":54.58,"end":57.6,"text":"вот вы поняли, зажали, отпустили, зажали,"},{"start":58.36,"end":62.4,"text":"и затем переходим указательным пальцем на пятую струну,"},{"start":62.6,"end":63.0,"text":"третий лад,"},{"start":66.04,"end":68.3,"text":"вот ударили, потом зажимаем аэм,"},{"start":69.34,"end":70.76,"text":"играем вторую струну,"},{"start":72.24,"end":74.1,"text":"заново на ту же самую позицию и играем"},{"start":74.1,"end":74.8,"text":"то же самое,"},{"start":77.14,"end":79.6,"text":"но теперь мы играем на второй струне третий"},{"start":79.6,"end":79.84,"text":"лад,"},{"start":82.14,"end":83.08,"text":"затем аэм,"},{"start":85.2,"end":91.42,"text":"потом играем аэм, держим, зажимаем вторую струну,"},{"start":93.28,"end":96.66,"text":"играем просто так первую на третьем,"},{"start":97.68,"end":98.96,"text":"просто так,"},{"start":100.1,"end":101.56,"text":"вторую струну на третьем,"},{"start":102.98,"end":106.68,"text":"затем сэ, затем еэм."},{"start":106.76,"end":107.94,"text":"А что потом?"},{"start":109.04,"end":112.07,"text":"Люблю ловить снежинки ртом."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
