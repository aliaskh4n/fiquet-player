{"version":1,"track_id":1018,"audio_sha256":"c62e46dafe037ec90c1d57a6d1b42673c8f77424a574a53420cffeffaadfb1b2","duration":137.66,"language":"russian","status":"ready","lines":[{"start":0,"end":15,"text":"[Неразборчивый фрагмент]","unclear":true},{"start":15,"end":30,"text":"[Неразборчивый фрагмент]","unclear":true},{"start":30,"end":45,"text":"[Неразборчивый фрагмент]","unclear":true},{"start":45,"end":60,"text":"[Неразборчивый фрагмент]","unclear":true},{"start":60.92,"end":65.18,"text":"Раны съедены, давно цветы завяли, все равно так"},{"start":65.18,"end":69.28,"text":"происходит рано или поздно."},{"start":69.72,"end":73.34,"text":"Я слишком много вас ждала, нам надо по"},{"start":75,"end":81.22,"text":"Малая, а ты слишком взрослая Летай, летай на"},{"start":81.22,"end":85.72,"text":"тур, спокойно можешь в клейдор Я повелась тогда"},{"start":85.72,"end":90,"text":"на эти трюки Всё было круто"},{"start":90,"end":94.2,"text":"Но прости, мы будем видеться в сети, Тону"},{"start":94.2,"end":97.66,"text":"выстричь, я умываю руки."},{"start":98.6,"end":104.94,"text":"Мальчик, грёбанный обманщик, Вечно что-то прячет от меня."},{"start":105,"end":120,"text":"[Неразборчивый фрагмент]","unclear":true},{"start":120.62,"end":124.16,"text":"Вечно что-то прячет от меня."},{"start":128.14,"end":133.78,"text":"Сложная задача. Слишком много значит для меня."}],"verification":{"independent_review":true,"word_agreement":0.889,"review_model":"gpt-4o-transcribe","unanchored_words":1,"needs_chunk_review":false,"chunk_review":true,"unclear_lines":5,"chunk_methods":{"two_models":3,"independent_windows":2}}}
