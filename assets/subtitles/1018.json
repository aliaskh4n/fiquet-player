{"version":2,"track_id":1018,"audio_sha256":"c62e46dafe037ec90c1d57a6d1b42673c8f77424a574a53420cffeffaadfb1b2","duration":137.66,"origin":"original_lyrics","status":"ready","lines":[{"start":3.58,"end":6.1,"text":"А я тихонечко курю","source_line":1},{"start":6.1,"end":7.78,"text":"На остановке","source_line":2},{"start":8.28,"end":10.96,"text":"Поджидая автобус","source_line":3},{"start":10.96,"end":13.64,"text":"Ты шутишь что-то про ментов","source_line":4},{"start":14.14,"end":16.34,"text":"Про безответную любовь","source_line":5},{"start":16.34,"end":20.8,"text":"Боюсь, тебе твой юмор не поможет","source_line":6},{"start":21.42,"end":23.72,"text":"Ну, предложи аперитив","source_line":7},{"start":24.12,"end":25.82,"text":"Давай подольше посидим","source_line":8},{"start":25.82,"end":27.54,"text":"Расскажешь мне про худшие свидания","source_line":9},{"start":30.38,"end":33.34,"text":"А время близиться к нулю","source_line":10},{"start":33.68,"end":35.76,"text":"И почему я так смеюсь?","source_line":11},{"start":35.76,"end":40.08,"text":"Как ты сумел привлечь моё внимание?","source_line":12},{"start":40.08,"end":42.68,"text":"Мальчик, грёбаный обманщик","source_line":13},{"start":43.72,"end":47.56,"text":"Вечно что-то прячет от меня","source_line":14},{"start":49.78,"end":53.64,"text":"Мальчик, сложная задача","source_line":16},{"start":53.64,"end":59.28,"text":"Слишком много значит для меня","source_line":17},{"start":59.54,"end":62.32,"text":"Конфеты съедены давно","source_line":19},{"start":62.5,"end":64.5,"text":"Цветы завянут всё равно","source_line":20},{"start":64.5,"end":69.18,"text":"Так происходит рано или поздно","source_line":21},{"start":69.18,"end":71.96,"text":"Я слишком многого ждала","source_line":22},{"start":72.22,"end":74.24,"text":"Нам нужно по своим делам","source_line":23},{"start":74.24,"end":75.84,"text":"Ведь я малая","source_line":24},{"start":76.48,"end":78.9,"text":"А ты слишком взрослый","source_line":25},{"start":83.68,"end":88.18,"text":"Я повелась тогда на эти трюки","source_line":28},{"start":88.18,"end":91.14,"text":"Всё было круто, но, прости","source_line":29},{"start":91.22,"end":93.22,"text":"Мы будем видеться в сети","source_line":30},{"start":93.22,"end":94.62,"text":"До новых встреч","source_line":31},{"start":94.62,"end":97.58,"text":"Я умываю руки","source_line":32},{"start":97.76,"end":100.1,"text":"Мальчик, грёбаный обманщик","source_line":33},{"start":101.14,"end":104.82,"text":"Вечно что-то прячет от меня","source_line":34},{"start":106.92,"end":110.18,"text":"Мальчик, сложная задача","source_line":36},{"start":110.86,"end":114.52,"text":"Слишком много значит для меня","source_line":37},{"start":116.32,"end":117.72,"text":"(Мальчик)","source_line":45},{"start":120.24,"end":124.98,"text":"Вечно что то прячет от меня","source_line":40},{"start":125.9,"end":129.24,"text":"Мальчик, сложная задача","source_line":42},{"start":130.14,"end":133.98,"text":"Слишком много значит для меня","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.872,"matched_words":143,"timing":"cached_word_anchors"},"song":"мальчик","artist":"кис-кис","source_url":"https://lrclib.net/api/get/33453209","source_sha256":"0ac3c99f9746e9e211ed649aa82c326af573693ab6a827d62448404d45141c8a"}
