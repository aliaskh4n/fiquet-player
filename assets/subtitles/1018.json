{"version":3,"track_id":1018,"audio_sha256":"c62e46dafe037ec90c1d57a6d1b42673c8f77424a574a53420cffeffaadfb1b2","duration":137.66,"origin":"original_lyrics","status":"ready","lines":[{"start":3.53,"end":6.05,"text":"А я тихонечко курю","source_line":1},{"start":6.05,"end":7.82,"text":"На остановке","source_line":2},{"start":7.82,"end":10.91,"text":"Поджидая автобус","source_line":3},{"start":10.91,"end":13.66,"text":"Ты шутишь что-то про ментов","source_line":4},{"start":13.66,"end":16.24,"text":"Про безответную любовь","source_line":5},{"start":16.24,"end":21.05,"text":"Боюсь, тебе твой юмор не поможет","source_line":6},{"start":21.16,"end":23.6,"text":"Ну, предложи аперитив","source_line":7},{"start":23.6,"end":25.77,"text":"Давай подольше посидим","source_line":8},{"start":25.77,"end":30.33,"text":"Расскажешь мне про худшие свидания","source_line":9},{"start":30.33,"end":33.34000015258789,"text":"А время близиться к нулю","source_line":10},{"start":33.54,"end":35.71,"text":"И почему я так смеюсь?","source_line":11},{"start":35.71,"end":40.03,"text":"Как ты сумел привлечь моё внимание?","source_line":12},{"start":40.03,"end":43.67,"text":"Мальчик, грёбаный обманщик","source_line":13},{"start":43.67,"end":47.560001373291016,"text":"Вечно что-то прячет от меня","source_line":14},{"start":49.73,"end":53.59,"text":"Мальчик, сложная задача","source_line":16},{"start":53.59,"end":59.279998779296875,"text":"Слишком много значит для меня","source_line":17},{"start":59.49,"end":62.28,"text":"Конфеты съедены давно","source_line":19},{"start":62.28,"end":64.45,"text":"Цветы завянут всё равно","source_line":20},{"start":64.45,"end":69.13,"text":"Так происходит рано или поздно","source_line":21},{"start":69.13,"end":71.9,"text":"Я слишком многого ждала","source_line":22},{"start":71.9,"end":74.35,"text":"Нам нужно по своим делам","source_line":23},{"start":74.44,"end":75.98000001907349,"text":"Ведь я малая","source_line":24},{"start":76.02,"end":78.62,"text":"А ты слишком взрослый","source_line":25},{"start":78.62,"end":81.46,"text":"Лишь пару месяцев на тур","source_line":26},{"start":81.46,"end":83.63,"text":"Спокойно можешь клеить дур","source_line":27},{"start":83.63,"end":88.13,"text":"Я повелась тогда на эти трюки","source_line":28},{"start":88.13,"end":91.0,"text":"Всё было круто, но, прости","source_line":29},{"start":91.0,"end":93.17,"text":"Мы будем видеться в сети","source_line":30},{"start":93.17,"end":94.57,"text":"До новых встреч","source_line":31},{"start":94.57,"end":96.54,"text":"Я умываю руки","source_line":32},{"start":96.54,"end":98.54,"text":"Мальчик, грёбаный обманщик","source_line":33},{"start":98.54,"end":100.29,"text":"Вечно что-то прячет от меня","source_line":34},{"start":106.87,"end":110.73,"text":"Мальчик, сложная задача","source_line":36},{"start":110.81,"end":114.5199966430664,"text":"Слишком много значит для меня","source_line":37},{"start":117.84,"end":120.19,"text":"Мальчик, грёбаный обманщик","source_line":39},{"start":120.19,"end":124.9800033569336,"text":"Вечно что то прячет от меня","source_line":40},{"start":125.85,"end":130.08,"text":"Мальчик, сложная задача","source_line":42},{"start":130.08,"end":133.97999572753906,"text":"Слишком много значит для меня","source_line":43}],"verification":{"source_text_checked":true,"word_agreement":0.872,"matched_words":143,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.398},"song":"мальчик","artist":"кис-кис","source_url":"https://lrclib.net/api/get/33453209","source_sha256":"0ac3c99f9746e9e211ed649aa82c326af573693ab6a827d62448404d45141c8a"}
