{"version":2,"track_id":118,"audio_sha256":"3c16de3a0f37bd9eea728d8cd493024c5146b6bcc0bb06c41e5258acf5dec1c5","duration":30.7,"origin":"original_lyrics","status":"ready","lines":[{"start":0.78,"end":4.96,"text":"Но зачем ты начинал, если не хочешь продолжать?","source_line":21},{"start":5.02,"end":9.64,"text":"Оставайся лучше сам, я постараюсь не мешать","source_line":22},{"start":9.64,"end":13.82,"text":"Но вчера произошёл какой-то сбой","source_line":23},{"start":13.82,"end":18.62,"text":"Ты уехал от меня почему-то очень злой","source_line":24},{"start":18.62,"end":23.2,"text":"Разберись с головой, играй, но не со мной","source_line":25},{"start":23.2,"end":26.72,"text":"Не хочешь ты — ну так напишет другой","source_line":26}],"verification":{"source_text_checked":true,"word_agreement":0.952,"matched_words":40,"timing":"cached_word_anchors"},"song":"бабочки","artist":"zhanulka","source_url":"https://lrclib.net/api/get/5084374","source_sha256":"b209dcaff1dafc794d11eadb088ad1d7a740019ff559f16442ef934795619898"}
