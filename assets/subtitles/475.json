{"version":3,"track_id":475,"audio_sha256":"97af269ee805d0bdb56009e1956d3886b5b8b58596aaf462073ffb450eb632a4","duration":36.5,"origin":"original_lyrics","status":"ready","lines":[{"start":0.5,"end":4.38,"text":"От чего тебе грустно? Зачем спишь сутки напролёт?","source_line":21},{"start":4.38,"end":8.6,"text":"Сколько было таких дней? Я уже потеряла счёт","source_line":22},{"start":8.6,"end":11.039999961853027,"text":"Ты пропал, тебя нет (Тебя нет)","source_line":23},{"start":11.52,"end":15.4,"text":"Мне это нужно, тебе — нет (нет)","source_line":24},{"start":15.4,"end":18.8,"text":"Тебе получше, а мне нет","source_line":25},{"start":18.8,"end":23.31,"text":"И ты снова мне снишься, но уже в другой мезансцене","source_line":26},{"start":23.31,"end":27.52,"text":"Я давлюсь сухим вином и не вылажу с постели","source_line":27},{"start":27.52,"end":31.32,"text":"Во мне говорит спирт, и я не соображаю","source_line":28},{"start":31.32,"end":35.07,"text":"Ну, а если быть честной, я очень скучаю","source_line":29}],"verification":{"source_text_checked":true,"word_agreement":0.75,"matched_words":42,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.517},"song":"Лазить по стенам","artist":"brokendaddy?","source_url":"https://lrclib.net/api/get/17971878","source_sha256":"ec7f2917958a720abdf72a5e26fce3294c153716f8eb086f4422ca80a500e254"}
