{"version":1,"track_id":475,"audio_sha256":"97af269ee805d0bdb56009e1956d3886b5b8b58596aaf462073ffb450eb632a4","duration":36.5,"language":"russian","status":"ready","lines":[{"start":0,"end":4.34,"text":"Отчего тебе грустно, зачем спишь сутки напролет?"},{"start":4.64,"end":8.52,"text":"Сколько было таких, и я уже потеряла счет."},{"start":9.74,"end":11.04,"text":"Ты пропал, тебя нет."},{"start":11.78,"end":14.24,"text":"Мне это нужно, тебе нет."},{"start":16.92,"end":18.16,"text":"Тебе получше во мне."},{"start":18.64,"end":22.18,"text":"Снова ты снишься, но уже другой без нацеления."},{"start":23.36,"end":26.18,"text":"Я добьюсь сухим вином, и не ложусь в"},{"start":26.96,"end":30.26,"text":"постели. Во мне говорит спирт, и я не"},{"start":30.26,"end":34.98,"text":"соображаю. А если быть честной, я очень скучаю."}],"verification":{"independent_review":true,"word_agreement":0.75,"review_model":"gpt-4o-transcribe","unanchored_words":15,"needs_chunk_review":false}}
