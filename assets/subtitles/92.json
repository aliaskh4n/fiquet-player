{"version":3,"track_id":92,"audio_sha256":"a0907dae118eb23f50eae07a6750c326175cd56610823178ab358834299e5034","duration":62.72,"origin":"original_lyrics","status":"ready","lines":[{"start":7.14,"end":15.51,"text":"Я влюбился в барабанщицу собственной группы","source_line":3},{"start":15.51,"end":17.76,"text":"Я знаю, как это глупо","source_line":4},{"start":17.76,"end":21.13,"text":"Не делает сердце моё ни стука","source_line":5},{"start":21.13,"end":23.59,"text":"Лишь малый и бочка лупят","source_line":6},{"start":23.59,"end":26.73,"text":"Она и кричала, и ела записки","source_line":7},{"start":27.0,"end":29.17,"text":"О любви моей искренней","source_line":8},{"start":29.17,"end":32.63,"text":"Стучат её палочки мне по лицу","source_line":9},{"start":32.63,"end":36.13,"text":"Может хоть так я пойму?","source_line":10},{"start":36.13,"end":40.03,"text":"Не пойму","source_line":11},{"start":40.03,"end":46.33,"text":"Стучат мне барабаны, пау-пау, в голову пьяную","source_line":12},{"start":46.66,"end":52.25,"text":"Под этот пульс знакомый, пау-пау, без метронома","source_line":13},{"start":52.35,"end":58.2599983215332,"text":"Стучат мне барабаны, пау-пау, в голову пьяную","source_line":14},{"start":58.54,"end":62.72,"text":"Под этот пульс знакомый, пау-пау, без метронома","source_line":15}],"verification":{"source_text_checked":true,"word_agreement":0.767,"matched_words":46,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.359},"song":"Барабанщица","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/11078506","source_sha256":"d386e9ea11ecd78791060aa1137a168f3eae97c0f552855c15e7cece4927ef1c"}
