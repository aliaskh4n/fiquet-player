{"version":1,"track_id":968,"audio_sha256":"4dda7dbfd0e0595a4b24e38c1bbe711c7feb3cdfc55a4277a3c30800c0dd4112","duration":25.01,"language":"russian","status":"ready","lines":[{"start":0,"end":3.18,"text":"Ашалеть, ребята, вас 80 тысяч."},{"start":4.32,"end":7.24,"text":"80 тысяч. Возможно, скоро будет 100 тысяч."},{"start":7.36,"end":9.62,"text":"Ну, окей, не скоро, но это ближе,"},{"start":10.54,"end":12.22,"text":"чем... Короче, ближе, близко."},{"start":13.14,"end":15.42,"text":"Поэтому... Ну, как обещала, стрим, значит, сегодня буду"},{"start":15.42,"end":16.68,"text":"вести. Вам когда удобно."},{"start":16.72,"end":19.82,"text":"Я могу запустить плюс-минус сейчас, или через час,"},{"start":20.04,"end":22.24,"text":"или... Или завтра, если сейчас уже поздно."},{"start":22.98,"end":23.92,"text":"Обещайте, как лучше."},{"start":24.42,"end":24.68,"text":"Пока."}],"verification":{"independent_review":false,"word_agreement":0.981,"needs_chunk_review":false}}
