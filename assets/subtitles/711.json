{"version":1,"track_id":711,"audio_sha256":"bc41dce4fb9e42face3b36086b2bdc637d5e10ccff8e54379ce9c384949272d2","duration":59.54,"language":"russian","status":"ready","lines":[{"start":0,"end":1.38,"text":"Мне подарили подарок."},{"start":1.78,"end":2.24,"text":"Три целых."},{"start":3.2,"end":4.14,"text":"Спасибо большое, Алина."},{"start":4.2,"end":8.26,"text":"Итак, вот такое кольцо у меня есть."},{"start":8.86,"end":11.36,"text":"Оно похоже на бабочку, и его можно менять"},{"start":11.36,"end":12.78,"text":"по размеру."},{"start":14.24,"end":16.62,"text":"Но я его редко ношу, потому что оно"},{"start":16.62,"end":17.9,"text":"не настоящее. Ну,"},{"start":19.2,"end":22.22,"text":"металлом покрыто, и из-за этого у меня на"},{"start":22.22,"end":24.1,"text":"пальцах остаются зеленые следы."},{"start":25.16,"end":26.84,"text":"Ну, и это не очень."},{"start":29.24,"end":31.44,"text":"Далее у меня есть такая змейка."},{"start":32.12,"end":33.46,"text":"Камешек меняет свой цвет."},{"start":33.94,"end":37.18,"text":"У меня есть такое более феноменальное кольцо."},{"start":39.82,"end":41.92,"text":"Господи, что у меня ещё есть?"},{"start":43.3,"end":44.78,"text":"А, ну и главное, это от Пандоры."},{"start":45.94,"end":47.26,"text":"Очень красивая комбинация, я считаю."},{"start":47.34,"end":48.42,"text":"Я сама собирала."},{"start":48.6,"end":49.84,"text":"А ещё у меня день рождения нет, так"},{"start":49.84,"end":50.3,"text":"подарили."},{"start":53.04,"end":56.4,"text":"Ну, всё. По-моему, всё рассказала."},{"start":58.4,"end":58.66,"text":"Ну, всё."}],"verification":{"independent_review":false,"word_agreement":0.981,"needs_chunk_review":false}}
