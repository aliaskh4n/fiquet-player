{"version":1,"track_id":881,"audio_sha256":"e3101fac13009069285bdbe6a886da3a78f372981711cbb9f6b339569beee97a","duration":26.74,"language":"russian","status":"ready","lines":[{"start":0,"end":2.48,"text":"Так, сейчас будем отвечать на все вопросики, которые"},{"start":2.48,"end":3.02,"text":"там есть."},{"start":3.86,"end":7.12,"text":"Мне 15 лет, и я научилась играть на"},{"start":7.12,"end":7.4,"text":"гитаре"},{"start":8.38,"end":9.52,"text":"4 года назад где-то."},{"start":10.22,"end":13.96,"text":"Я начала играть песню «Алёна Чвец», но я"},{"start":13.96,"end":15.6,"text":"начала играть на гитаре после «Домбры»."},{"start":16.38,"end":18.64,"text":"«Домбры» — это национальный казахский инструмент, кто не"},{"start":18.64,"end":18.7,"text":"знал."},{"start":19.5,"end":22.18,"text":"Вот, начала играть, и потом перешла на гитарку,"},{"start":23.9,"end":25.74,"text":"также играла лет шире, а потом саму дальше"},{"start":25.74,"end":26.08,"text":"пошла."}],"verification":{"independent_review":false,"word_agreement":0.968,"needs_chunk_review":false}}
