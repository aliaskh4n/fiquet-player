{"version":1,"track_id":276,"audio_sha256":"07f4a898c309403fef0e11ab7bc58ec733de98c2fc853b1782e936453c1eb87c","duration":21.54,"language":"russian","status":"ready","lines":[{"start":0,"end":3.58,"text":"Сегодня у моей бабусечки день рождения, и мне"},{"start":3.58,"end":6.54,"text":"пришлось встать пораньше, поэтому как бы 20 минут"},{"start":6.54,"end":6.9,"text":"я не знаю,"},{"start":7.66,"end":8.7,"text":"что делать."},{"start":10.64,"end":11.48,"text":"Клинский, кстати."},{"start":13.38,"end":15.3,"text":"Я удивлена. Я, по сути, ем очень много"},{"start":15.3,"end":17.48,"text":"сладков в последнее время, она должна была уже"},{"start":17.48,"end":17.88,"text":"усыпать,"},{"start":19.08,"end":21.1,"text":"но бомба замедленного действия не действует."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
