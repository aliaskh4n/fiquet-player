{"version":1,"track_id":543,"audio_sha256":"cb260d9ebb4cb009cc64578e6217c77aaede15b8c87d3f0a528e51cdf665de41","duration":32.97,"language":"russian","status":"ready","lines":[{"start":0,"end":3.22,"text":"Я захожу с какой-то дуры в номер просто"},{"start":3.22,"end":6.92,"text":"потому, что мне страшно оставаться одному."},{"start":7.12,"end":10.56,"text":"Она хочет меня знать, раздеви со мной, улыбится"},{"start":12.04,"end":15.72,"text":"за красоту, она думает про семью, я думаю"},{"start":15.72,"end":18.64,"text":"про блядь, узнавая этим Москву."},{"start":18.64,"end":21.2,"text":"Чем выше тем ниже, я кто знает, как"},{"start":21.2,"end":22.36,"text":"же я живу."},{"start":23.24,"end":24.92,"text":"Страхами помогу, согрею, переведу."}],"verification":{"independent_review":true,"word_agreement":0.7,"review_model":"gpt-4o-transcribe","unanchored_words":15,"needs_chunk_review":false}}
