{"version":1,"track_id":999,"audio_sha256":"c95fa8aa91536e76d8c64fc380601f8fb85ba12c54b1796da4cee01c386ec4a7","duration":33.61,"language":"russian","status":"ready","lines":[{"start":0,"end":1.0,"text":"Я иду в школу."},{"start":1.78,"end":4.34,"text":"Я пыталась сделать косыночку красивую, как в инстаграме,"},{"start":4.36,"end":5.88,"text":"но у меня получилось вот это, но не"},{"start":5.88,"end":8.82,"text":"суть. Где моя обещанная теплая Англия?"},{"start":8.9,"end":10.12,"text":"Почему я когда иду в школу..."},{"start":11.12,"end":11.6,"text":"Блин, не видно."},{"start":11.74,"end":13.56,"text":"Ну, короче, здесь дико холодно, хоть и снега"},{"start":13.56,"end":15.1,"text":"нет. Я иду в кофте,"},{"start":15.92,"end":19.98,"text":"куртке, футболке, джинсах с начесок, мне холодно."},{"start":21.9,"end":24.32,"text":"Так, сегодня я хочу быть продуктивной."},{"start":24.42,"end":25.1,"text":"Запишу вам нолу-каверов."},{"start":26.22,"end":27.6,"text":"Я сегодня выложу три, кстати,"},{"start":28.64,"end":31.08,"text":"в 14.00 по Англии."},{"start":31.08,"end":32.86,"text":"Пожалуйста, пролайкайте мне там."}],"verification":{"independent_review":false,"word_agreement":0.974,"needs_chunk_review":false}}
