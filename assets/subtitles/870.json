{"version":1,"track_id":870,"audio_sha256":"ddcc53756bc39da87bbe300dad69fe249fa37874651202be36ac2ddbb06d9abb","duration":50.07,"language":"russian","status":"ready","lines":[{"start":0,"end":1.88,"text":"Знаете, притряслось немножко."},{"start":2.12,"end":3.24,"text":"Такое настроение попеть каверы."},{"start":4.08,"end":4.92,"text":"Поэтому мы сейчас будем петь нервы."},{"start":5.54,"end":6.72,"text":"А еще смотрите, какое у меня колечко."},{"start":9.06,"end":13.42,"text":"Я снова оказался виноват,"},{"start":14.24,"end":17.28,"text":"но в этот раз я даже рад."},{"start":18.46,"end":21.18,"text":"Мы не смогли в этом миновать,"},{"start":22.44,"end":23.14,"text":"друг друга заживо пожирать."},{"start":26.2,"end":29.42,"text":"Гитара улица струна,"},{"start":31.18,"end":34.64,"text":"ты с берегов, а я со дна."},{"start":35.54,"end":38.32,"text":"Такая улица, опять одна, на-на-на-на-на-на-на."}],"verification":{"independent_review":true,"word_agreement":0.821,"review_model":"gpt-4o-transcribe","unanchored_words":10,"needs_chunk_review":false}}
