{"version":1,"track_id":681,"audio_sha256":"38caffc5868c4347bb2c8bfeeea3c8a5dd7320ce7817f2874f6b6a47bb08f5c7","duration":72.67,"language":"russian","status":"ready","lines":[{"start":1.62,"end":10.92,"text":"Все, что я должен видеть, маленький глупый смысл."},{"start":12.76,"end":16.32,"text":"Когда-нибудь я продолжу полет."},{"start":20.28,"end":28.04,"text":"Прости мне мои распросы, но это невыносимо."},{"start":28.04,"end":37.38,"text":"Так быстро проходит осень, так тянутся долго зимы."},{"start":38.9,"end":41.62,"text":"Съедают мои детали"},{"start":42.8,"end":43.9,"text":"ветер и снег добавь."},{"start":46.9,"end":50.38,"text":"Куда бы мы не летали."}],"verification":{"independent_review":true,"word_agreement":0.81,"review_model":"gpt-4o-transcribe","unanchored_words":8,"needs_chunk_review":false}}
