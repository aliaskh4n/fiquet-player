{"version":1,"track_id":829,"audio_sha256":"aba13a573fc298ed9a1b7193422db13423ca318bafbce9c7e4f5253a2be90d3a","duration":24.2,"language":"russian","status":"ready","lines":[{"start":0,"end":1.48,"text":"Просто мне недавно, как бы,"},{"start":2.44,"end":3.2,"text":"я опять давит..."},{"start":3.2,"end":6.54,"text":"ну, я решила выдавить прыщ, вышло ужасно, я"},{"start":6.54,"end":7.6,"text":"не знаю, как я завтра в школу пойду,"},{"start":7.68,"end":8.78,"text":"но я закрашу это."},{"start":8.78,"end":9.5,"text":"Так вот."},{"start":12.76,"end":15.64,"text":"Мне отец купил огромную упаковку курта."},{"start":16.1,"end":18.96,"text":"Чтобы вы знали, я ела только один вид"},{"start":18.96,"end":20.52,"text":"курта за всю свою жизнь."},{"start":21.22,"end":23.72,"text":"Делать обзор на курт или не делать?"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
