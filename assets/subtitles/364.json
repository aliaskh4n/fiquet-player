{"version":1,"track_id":364,"audio_sha256":"be021d551a5672869df362cb4980003a385a7a3a9fa2f772ea20bb490437a584","duration":36.35,"language":"russian","status":"ready","lines":[{"start":0,"end":2.74,"text":"Что же вы всегда такие грязные у меня."},{"start":3.02,"end":7.36,"text":"Ужас. Я заселилась в отель, в номер, на"},{"start":7.36,"end":7.78,"text":"две недели."},{"start":10.02,"end":10.52,"text":"Смотрите, какая красота."},{"start":10.74,"end":11.18,"text":"Всё моё."},{"start":12.1,"end":13.1,"text":"Всё здесь моё."},{"start":13.72,"end":15.34,"text":"Уже познакомилась с новыми ребятами."},{"start":15.56,"end":17.84,"text":"Это опять актёрская, только уже две недели, и"},{"start":17.84,"end":18.76,"text":"более профессиональная."},{"start":19.68,"end":21.46,"text":"Ребята у меня очень крутые друзья появились."},{"start":21.68,"end":22.54,"text":"Я их всех запомнила."},{"start":22.66,"end":23.76,"text":"Все имена. 11 человек."},{"start":23.88,"end":24.62,"text":"Это для меня рекорд."},{"start":25.92,"end":26.38,"text":"Вот."},{"start":29.78,"end":31.48,"text":"Такие дела. Ковры теперь здесь."},{"start":31.92,"end":35.8,"text":"Мне кажется, довольно красиво и атмосферно."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
