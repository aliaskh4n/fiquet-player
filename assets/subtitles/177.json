{"version":1,"track_id":177,"audio_sha256":"9d73a0d7d647bfd1e6cbf7cb287661385516a56c53781e52102314fdc74db0f8","duration":53.91,"language":"russian","status":"ready","lines":[{"start":0.46,"end":1.6,"text":"Сейчас я вам расскажу."},{"start":1.86,"end":4.2,"text":"Вот это вот, вот аккорды я обычно беру"},{"start":4.2,"end":8.5,"text":"на adm.am.dm Вот это говно полно."},{"start":8.68,"end":10.64,"text":"Сейчас я вам буду рассказывать, как правильно играть"},{"start":10.64,"end":12.76,"text":"эту песню. Нигде не могла найти, пришлось самой"},{"start":12.76,"end":14.64,"text":"подбирать. Сидела тут, ради вас похотела."},{"start":15.14,"end":19.4,"text":"В общем, в начале мы зажимаем, я не"},{"start":19.4,"end":20.76,"text":"знаю, какой этот аккорд называется, но в общем"},{"start":20.76,"end":21.5,"text":"вот такой вот."},{"start":21.5,"end":24.2,"text":"Это как джем на третьем, только это на"},{"start":24.2,"end":25.34,"text":"пятом получается, да?"},{"start":25.5,"end":26.58,"text":"Раз, два, три, четыре, пять."},{"start":26.62,"end":27.22,"text":"Да, на пятом."},{"start":28.22,"end":32.26,"text":"Потом идем на этот, зажимаем вот так вот."},{"start":32.42,"end":33.56,"text":"Три, три, три, один."},{"start":34.96,"end":38.84,"text":"И потом на четвертом."},{"start":41.54,"end":42.5,"text":"И на втором."},{"start":44.04,"end":45.22,"text":"И получается так."}],"verification":{"independent_review":false,"word_agreement":0.99,"needs_chunk_review":false}}
