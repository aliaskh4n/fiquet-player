{"version":1,"track_id":202,"audio_sha256":"46868066d9172f92c525a057734a964554c7ea0411cfb38e9abc0f586019d62d","duration":22.64,"language":"russian","status":"ready","lines":[{"start":0,"end":1.7,"text":"Я сейчас... Всем доброе утро, во-первых."},{"start":3.36,"end":4.34,"text":"Во-вторых, по-моему, я чуть-чуть приболела."},{"start":8.04,"end":9.54,"text":"В-третьих... Мне почему-то вот именно в это время"},{"start":9.54,"end":12.32,"text":"многие говорят, что мой прошлый цвет волос мне"},{"start":12.32,"end":13.16,"text":"шёл намного лучше."},{"start":13.54,"end":15.34,"text":"Именно красный. Как думаете?"},{"start":16.5,"end":19.7,"text":"Мне кажется, мне пойдёт холодный оттенок волос."}],"verification":{"independent_review":false,"word_agreement":0.833,"needs_chunk_review":false}}
