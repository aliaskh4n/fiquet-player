{"version":1,"track_id":35,"audio_sha256":"effe8c768f0714953ccb334e6b6666478d2c36a3805b19bc34ffc87ed37bc0c2","duration":21.11,"language":"russian","status":"ready","lines":[{"start":0,"end":1.58,"text":"Коты, всем привет."},{"start":2.8,"end":4.54,"text":"Не выходила на связь, но занята была, понимаете."},{"start":4.58,"end":5.82,"text":"Я приехала в Караганду."},{"start":6.12,"end":7.14,"text":"Вот, сейчас покажу вам."},{"start":10.78,"end":12.14,"text":"Двое человек меня уже узнали."},{"start":12.6,"end":13.54,"text":"Веду счет за два дня."},{"start":15.18,"end":18.12,"text":"И вот, ну, думаю, сход скоро устроится."},{"start":18.84,"end":20.74,"text":"В Центральном парке можно на тракционах покататься."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
