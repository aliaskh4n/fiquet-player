{"version":1,"track_id":529,"audio_sha256":"750760d4cf7e77c06e6d56a3e9c8731cc36167c39a72e140d74168ff19f9de7e","duration":18.69,"language":"russian","status":"ready","lines":[{"start":0,"end":2.44,"text":"В последнее время, ну нет, не в последнее,"},{"start":2.74,"end":5.86,"text":"давненько уже хвалят один фильм «Солнцестояние», хор"},{"start":5.86,"end":8.14,"text":"называется, и говорят, что нужна сильная психика, чтобы"},{"start":8.14,"end":9.3,"text":"посмотреть."},{"start":10.56,"end":14.12,"text":"Поэтому я сейчас посмотрю, а потом скажу вам"},{"start":14.12,"end":17.08,"text":"отзывы сюда. Может кто-нибудь смотрел «Солнцестояние»?"},{"start":17.92,"end":18.16,"text":"Знакомо?"}],"verification":{"independent_review":false,"word_agreement":0.974,"needs_chunk_review":false}}
