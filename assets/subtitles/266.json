{"version":1,"track_id":266,"audio_sha256":"125082127eecfd137c381203f00b5cfe48d1930924c0c6cb0d683b27dc9c5479","duration":58.7,"language":"russian","status":"ready","lines":[{"start":0,"end":3.86,"text":"История, кстати, с этими кукурузными палочками и то,"},{"start":3.86,"end":4.92,"text":"как мы хотели посмотреть фильм."},{"start":5.16,"end":6.36,"text":"В общем, мы с подругами собрались,"},{"start":7.3,"end":9.4,"text":"пришли на другой конец города ради вкусняшек, в"},{"start":9.4,"end":11.06,"text":"дождь, там чуть ли не смерч."},{"start":11.9,"end":12.46,"text":"Пришли, супер."},{"start":13.98,"end":15.02,"text":"Полчаса заняло всё."},{"start":15.6,"end":16.3,"text":"Пришли с вкусняшками,"},{"start":17.18,"end":20.14,"text":"положили в какую-то, ну в какую-то комнату, и"},{"start":20.14,"end":21.42,"text":"сами пошли помогать"},{"start":23.08,"end":25.76,"text":"моей другой подруге, потому что ей срочно позвонили,"},{"start":25.76,"end":29.0,"text":"ей нужно было отнести еду с одного конца"},{"start":29.0,"end":29.86,"text":"школы на другой."},{"start":30.7,"end":32.84,"text":"Помогли. Уже все уставшие."},{"start":33.16,"end":34.86,"text":"Заходим. Еда закрыта."},{"start":35.46,"end":36.16,"text":"Кабинет закрыли."},{"start":36.96,"end":38.66,"text":"Начинаем просить, нам кабинет открывают."},{"start":38.96,"end":41.64,"text":"Берём вкусняшки, приходим наверх."},{"start":42.22,"end":44.84,"text":"Начинаем смотреть фильм, и нам звонит девочка в"},{"start":44.84,"end":47.44,"text":"истерике. Причём она не моя подруга, не подруга"},{"start":47.44,"end":49.14,"text":"никого, в общем."},{"start":49.38,"end":49.9,"text":"Правильно же сказала?"},{"start":50.64,"end":52.66,"text":"Просто знакомая. Она плачет."},{"start":52.66,"end":54.5,"text":"Потом мы говорим ей, ну что такое, нам"},{"start":54.5,"end":57.0,"text":"несложно помочь. Сейчас вторая часть будет, видимо."},{"start":57.7,"end":58.26,"text":"Да, вторая часть."}],"verification":{"independent_review":false,"word_agreement":0.985,"needs_chunk_review":false}}
