{"version":1,"track_id":181,"audio_sha256":"c3c643e2f5e998322c6f618d870e70c45b032072f6e2610c1facf9ee53fa72cc","duration":34.02,"language":"russian","status":"ready","lines":[{"start":0.64,"end":3.32,"text":"Ну а из позитивного…"},{"start":3.32,"end":5.82,"text":"Чуть ещё негатива, по-моему, я себе прищипала бровь,"},{"start":5.84,"end":8.06,"text":"я не уверена, скажите да или нет."},{"start":8.3,"end":9.08,"text":"Помни чуть-чуть, да?"},{"start":10.84,"end":12.06,"text":"Но из хорошего я похудела,"},{"start":12.88,"end":15.58,"text":"прям визуально я очень сильно похудела."},{"start":15.74,"end":17.84,"text":"Вот так я раньше выглядела с фильтрами, а"},{"start":17.84,"end":19.3,"text":"сейчас я без фильтров так выгляжу, и у"},{"start":19.3,"end":21.0,"text":"меня стала почему-то чистая кожа."},{"start":25.22,"end":26.14,"text":"Ну и вот так."},{"start":26.14,"end":31.08,"text":"Ещё скоро выходит моя песня, ещё одна, такая"},{"start":31.08,"end":32.16,"text":"зимняя."},{"start":32.96,"end":33.58,"text":"Готовы, дети?"}],"verification":{"independent_review":false,"word_agreement":0.957,"needs_chunk_review":false}}
