{"version":1,"track_id":576,"audio_sha256":"a8571835ba001a580f009178f4c246d915f1b54487d2948e65fca5adc8123dba","duration":17.44,"language":"russian","status":"ready","lines":[{"start":0.7,"end":6.42,"text":"Единственное, я это взяла как черновик на завтра"},{"start":6.42,"end":7.86,"text":"экзамен, типа набросок."},{"start":8.16,"end":9.68,"text":"Но я боюсь, что я завтра приду с"},{"start":9.68,"end":12.84,"text":"ним, и учительница такая, Дарья, нет, слишком много"},{"start":12.84,"end":15.22,"text":"деталей, поэтому нет, нельзя, рисую заново."},{"start":15.68,"end":17.08,"text":"Я не знаю, что я тогда завтра буду"},{"start":17.08,"end":17.32,"text":"делать."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
