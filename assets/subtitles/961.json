{"version":1,"track_id":961,"audio_sha256":"670547347358dd9c7b97fca0be4389c6aac9fedc66c1b2c8b920f7e1ae44d36b","duration":21.18,"language":"russian","status":"ready","lines":[{"start":0,"end":2.24,"text":"Короче, ребята, которые были на стриме, спасибо большое."},{"start":2.34,"end":4.44,"text":"Я... Я с собой недовольна, потому что у"},{"start":4.44,"end":5.66,"text":"меня не было iPad'а, и я не смогла"},{"start":5.66,"end":6.94,"text":"вам сыграть всё, что вы просили."},{"start":7.3,"end":7.74,"text":"Вот."},{"start":9.08,"end":12.44,"text":"Но... Следующий стрим будет куда лучше, я уверена."},{"start":12.7,"end":14.88,"text":"Просто я сейчас в середине приезда, то есть..."},{"start":15.38,"end":16.56,"text":"Поэтому... Вот, всем спасибо,"},{"start":18.78,"end":19.68,"text":"кто был на стриме."},{"start":20.32,"end":20.36,"text":"Целую."}],"verification":{"independent_review":false,"word_agreement":0.982,"needs_chunk_review":false}}
