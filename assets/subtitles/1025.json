{"version":1,"track_id":1025,"audio_sha256":"3908ab22e65c604d0b69438509926663ffda3606387db48cc9afd4e4048e8b87","duration":34.73,"language":"russian","status":"ready","lines":[{"start":0,"end":1.84,"text":"Короче, я не понимаю, как это работает."},{"start":4.1,"end":4.42,"text":"Какое-то покраснение какое-то."},{"start":5.72,"end":9.36,"text":"Вот эту штуку я заплагинила in в мой"},{"start":9.36,"end":9.72,"text":"телефон,"},{"start":10.52,"end":12.56,"text":"ничего не поменялось, звук пропал."},{"start":14.22,"end":16.28,"text":"Но это очень сильно выглядит, да, это очень"},{"start":16.28,"end":19.4,"text":"сильно выглядит, но я не знаю, не могу"},{"start":19.4,"end":21.72,"text":"понять. То есть я подключаю..."},{"start":21.72,"end":22.58,"text":"Как это подключается?"},{"start":22.66,"end":23.76,"text":"Блютуз не получается."},{"start":24.02,"end":27.54,"text":"Я пыталась wire подключать, но тоже не получилось."},{"start":28.54,"end":30.72,"text":"Если кто знает, помогите."},{"start":30.9,"end":33.44,"text":"Holy Land. Подключать к айфону."},{"start":33.72,"end":34.18,"text":"Вот как."}],"verification":{"independent_review":false,"word_agreement":0.971,"needs_chunk_review":false}}
