{"version":1,"track_id":1076,"audio_sha256":"35548e6fbe2fdd89143b6501eab6862553963c5505f63b51e61cd8236da4ed6c","duration":58.499,"language":"russian","status":"ready","lines":[{"start":0,"end":1.08,"text":"А на кухне супостыни?"},{"start":3.92,"end":5.62,"text":"Говорят, но я тебя люблю."},{"start":6.58,"end":11.12,"text":"Нож гоняю подворуки, но я тебя люблю."},{"start":11.12,"end":13.82,"text":"Все хорошие и плохие?"},{"start":15.34,"end":17.0,"text":"Говорят, но я тебя люблю."},{"start":17.0,"end":19.92,"text":"В этом городе ты где-то ходишь, я никак"},{"start":20.68,"end":22.6,"text":"тебя не найду."},{"start":22.6,"end":25.16,"text":"Есть девчонки молодые?"},{"start":26.7,"end":28.28,"text":"Говорят, но я тебя люблю."},{"start":28.28,"end":30.94,"text":"Мы с друзьями идем за пиво?"},{"start":32.52,"end":33.98,"text":"Говорят, но я тебя люблю."},{"start":34.02,"end":37.74,"text":"Говорят, ты спишь с другими, но я все"},{"start":37.74,"end":39.58,"text":"равно тебя люблю."},{"start":40.48,"end":41.06,"text":"Зубом с ножом, с теплостью?"},{"start":43.58,"end":45.16,"text":"Говорят, но я тебя люблю."}],"verification":{"independent_review":true,"word_agreement":0.789,"review_model":"gpt-4o-transcribe","unanchored_words":16,"needs_chunk_review":false}}
