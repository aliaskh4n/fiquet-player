{"version":1,"track_id":313,"audio_sha256":"20cffd7bd1994c7643a9df00dc5bb7e92a222897a28e0239f9448a8061534b00","duration":44.04,"language":"russian","status":"ready","lines":[{"start":0,"end":2.92,"text":"В общем, вот Лизочка, моя любимая, тоже приехала."},{"start":3.88,"end":4.76,"text":"Наконец-то ребята тут приехали."},{"start":5.5,"end":7.24,"text":"Смотрите, какие у меня крутые штаны."},{"start":7.5,"end":8.74,"text":"Смотрите, какие у меня крутые штаны."},{"start":9.7,"end":11.3,"text":"Пого, хочешь показаться моим подписчикам?"},{"start":11.7,"end":12.82,"text":"Они по тебе заскучились."},{"start":13.02,"end":13.08,"text":"Ой."},{"start":14.04,"end":14.68,"text":"Дива."},{"start":15.54,"end":16.18,"text":"Дива."},{"start":18.06,"end":19.86,"text":"Некультурные слова говорит девочка."},{"start":20.4,"end":20.96,"text":"Кстати, я осуждалась."},{"start":21.54,"end":22.52,"text":"Но я это скину всё равно."},{"start":23.34,"end":24.72,"text":"Так что вот ждите новые каверы."},{"start":24.8,"end":27.18,"text":"Может быть мы вместе с Лизой..."},{"start":27.18,"end":29.18,"text":"Можно? Можно? Сейчас я буду бегать."},{"start":30.46,"end":30.88,"text":"Можешь отойти."},{"start":32.88,"end":33.08,"text":"Отойди,"},{"start":35.08,"end":35.28,"text":"отойди."},{"start":37.96,"end":38.9,"text":"Всё, мы шли."}],"verification":{"independent_review":false,"word_agreement":0.986,"needs_chunk_review":false}}
