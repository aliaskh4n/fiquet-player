{"version":3,"track_id":78,"audio_sha256":"e3961f3449933f7d343e7d7333a24d531f53dd7e1e439415170417b291114bd3","duration":83.52,"origin":"original_lyrics","status":"ready","lines":[{"start":2.81,"end":8.07,"text":"Соседа сланцы протёрлись о бетон","source_line":0},{"start":8.07,"end":13.77,"text":"Хочу подраться, да никого кругом","source_line":1},{"start":13.77,"end":19.479999542236328,"text":"На ржавых дверцах кружки от сигарет","source_line":2},{"start":19.77,"end":24.91,"text":"Помедли, трезвость, не торопись, рассвет","source_line":3},{"start":24.91,"end":33.49,"text":"Свети, свети же, Луна, хоть зритель и один","source_line":4},{"start":33.49,"end":39.01,"text":"И перспектива одна — открытый магазин","source_line":5},{"start":39.01,"end":44.599998474121094,"text":"Я вышел из дома в чужом пальто","source_line":6},{"start":44.96,"end":50.01,"text":"Район незнакомый, район не тот","source_line":7},{"start":50.01,"end":55.560001373291016,"text":"Тут все молчаливы, тут все в тоске","source_line":8},{"start":55.71,"end":60.63999938964844,"text":"Закончилось пиво в ночном ларьке","source_line":9},{"start":61.18,"end":66.39,"text":"Вон в подворотне прохожий тоже пьян","source_line":10},{"start":66.39,"end":72.08,"text":"Глазеют окна и знают то, что я","source_line":11},{"start":72.08,"end":77.12,"text":"Веду дорогой совсем не в магазин","source_line":12},{"start":77.12,"end":82.65,"text":"А у меня секретов много, а слушатель один","source_line":13}],"verification":{"source_text_checked":true,"word_agreement":0.817,"matched_words":67,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.596},"song":"Ночной ларёк","artist":"Монеточка","source_url":"https://lrclib.net/api/get/35451524","source_sha256":"f7af1f69286a66dd430cfb24617b663d77bc99dd3064e0265cd26cb8abaac709"}
