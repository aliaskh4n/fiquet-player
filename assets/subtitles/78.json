{"version":2,"track_id":78,"audio_sha256":"e3961f3449933f7d343e7d7333a24d531f53dd7e1e439415170417b291114bd3","duration":83.52,"origin":"original_lyrics","status":"ready","lines":[{"start":2.86,"end":8.12,"text":"Соседа сланцы протёрлись о бетон","source_line":0},{"start":8.12,"end":13.82,"text":"Хочу подраться, да никого кругом","source_line":1},{"start":13.82,"end":19.48,"text":"На ржавых дверцах кружки от сигарет","source_line":2},{"start":19.82,"end":24.96,"text":"Помедли, трезвость, не торопись, рассвет","source_line":3},{"start":33.54,"end":39.06,"text":"И перспектива одна — открытый магазин","source_line":5},{"start":39.06,"end":44.6,"text":"Я вышел из дома в чужом пальто","source_line":6},{"start":50.06,"end":55.56,"text":"Тут все молчаливы, тут все в тоске","source_line":8},{"start":55.76,"end":60.64,"text":"Закончилось пиво в ночном ларьке","source_line":9},{"start":61.54,"end":66.44,"text":"Вон в подворотне прохожий тоже пьян","source_line":10},{"start":66.44,"end":72.18,"text":"Глазеют окна и знают то, что я","source_line":11},{"start":72.88,"end":77.22,"text":"Веду дорогой совсем не в магазин","source_line":12},{"start":77.42,"end":80.9,"text":"А у меня секретов много, а слушатель один","source_line":13}],"verification":{"source_text_checked":true,"word_agreement":0.817,"matched_words":67,"timing":"cached_word_anchors"},"song":"Ночной ларёк","artist":"Монеточка","source_url":"https://lrclib.net/api/get/35451524","source_sha256":"f7af1f69286a66dd430cfb24617b663d77bc99dd3064e0265cd26cb8abaac709"}
