{"version":1,"track_id":78,"audio_sha256":"e3961f3449933f7d343e7d7333a24d531f53dd7e1e439415170417b291114bd3","duration":83.52,"language":"russian","status":"ready","lines":[{"start":0,"end":1.48,"text":"Ночной ларек, кавер."},{"start":8.12,"end":13.82,"text":"Хочу потрястся, Да никого кругом."},{"start":13.82,"end":19.48,"text":"На ржавых дверцах Кружки от сигарет По медли"},{"start":22.78,"end":24.96,"text":"трезво. Не торопись рассвет, Сиди здесь, держи, Сидим"},{"start":33.54,"end":34.36,"text":"и украсить этот день."},{"start":34.36,"end":41.54,"text":"И перспектива, Магнит и магазин, Я ушел из"},{"start":41.54,"end":43.28,"text":"дома, В чужом быту."},{"start":48.72,"end":50.78,"text":"Район незнакомый, Район не тот, Тут всем мочили,"},{"start":52.5,"end":55.56,"text":"Тут все в тоске."},{"start":58.1,"end":61.54,"text":"Закончилась пива В ночном барке, Вот по двору"},{"start":63.5,"end":66.44,"text":"идет Прохожий тоже пьян."},{"start":68.8,"end":72.18,"text":"Он заняток, знай, И знаю то, что я"},{"start":72.18,"end":77.22,"text":"Иду дорогой Совсем не в магазин."},{"start":77.42,"end":82.54,"text":"У меня секретов много, А слушатель один."}],"verification":{"independent_review":true,"word_agreement":0.571,"review_model":"gpt-4o-transcribe","unanchored_words":39,"needs_chunk_review":false}}
