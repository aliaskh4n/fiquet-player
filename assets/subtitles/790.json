{"version":1,"track_id":790,"audio_sha256":"254db345b171e2eb832bf6262a76968e0af419ddfadb6588c28a5521c6187f63","duration":50.01,"language":"russian","status":"ready","lines":[{"start":0.76,"end":4.52,"text":"Всем привет! Сегодня я буду показывать все мои"},{"start":4.52,"end":4.94,"text":"украшения."},{"start":6.14,"end":8.28,"text":"Мадонна, хочешь передать привет?"},{"start":10.08,"end":11.5,"text":"Привет-привет. Лиза, давай."},{"start":13.92,"end":14.88,"text":"Ну, короче. Ой."},{"start":15.48,"end":18.18,"text":"Ой. Ладно. Мои украшения сейчас."},{"start":18.5,"end":19.26,"text":"Это такое кольцо."},{"start":20.22,"end":20.86,"text":"Вот такие два."},{"start":21.86,"end":25.06,"text":"Потом у меня есть ещё казахское украшение, потому"},{"start":25.06,"end":27.94,"text":"что я патриот, и я люблю казахское украшение"},{"start":27.94,"end":31.06,"text":"сейчас. У меня есть такая звёздочка, и..."},{"start":31.06,"end":32.26,"text":"В общем, у меня сегодня новое украшение."},{"start":32.6,"end":34.28,"text":"Вы можете не шептаться."},{"start":35.68,"end":37.1,"text":"Это китайцы. Не мы."},{"start":38.06,"end":41.16,"text":"Окей. Потом у меня есть такой браслетик от"},{"start":41.16,"end":43.02,"text":"Pandora. По-моему, всё."},{"start":43.84,"end":44.38,"text":"Кольцо покажи."},{"start":45.96,"end":46.6,"text":"Я уже показала."},{"start":46.78,"end":48.32,"text":"Кольцо покажи. Вот."}],"verification":{"independent_review":false,"word_agreement":0.977,"needs_chunk_review":false}}
