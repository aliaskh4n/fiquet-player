{"version":1,"track_id":235,"audio_sha256":"1c1b560dcc860361a475523f3fb3def5d7cf484c212d77824155653e67f74750","duration":57.27,"language":"russian","status":"ready","lines":[{"start":0,"end":0.68,"text":"Это до,"},{"start":1.54,"end":1.8,"text":"после."},{"start":2.78,"end":4.56,"text":"Мне кажется, я буду кринжевать со всего, что"},{"start":4.56,"end":5.14,"text":"я костила."},{"start":6.22,"end":7.84,"text":"В общем, рассказываю, что было."},{"start":11.12,"end":14.0,"text":"Я надела каблуки, просто бешеные вот такие вот,"},{"start":14.0,"end":15.96,"text":"ну потому что Марла, у неё по сути"},{"start":15.96,"end":16.54,"text":"каблуки."},{"start":18.36,"end":19.82,"text":"Меня дотаскивали домой."},{"start":20.8,"end":22.96,"text":"Это ужасно, у меня очень сильно болят ноги,"},{"start":23.02,"end":24.84,"text":"я пообещала себе, что больше не буду носить"},{"start":24.84,"end":26.56,"text":"каблуки. Это первое."},{"start":26.56,"end":31.14,"text":"Второе, к нам начал, ну не то что"},{"start":31.14,"end":31.84,"text":"подкатывать,"},{"start":32.64,"end":36.1,"text":"приставать чел и предлагать кокос."},{"start":36.24,"end":39.44,"text":"Ну вы поняли, какой кокос, то есть нехороший"},{"start":39.44,"end":40.72,"text":"кокос, вот."},{"start":41.68,"end":44.64,"text":"И меня ещё часто спрашивают, кого я косплею."},{"start":44.96,"end":45.6,"text":"Что ещё было?"},{"start":47.04,"end":48.3,"text":"Похвалили мой костюм."},{"start":51.5,"end":53.74,"text":"Сейчас расскажу кое-что, нам, короче, женщина, три кул"},{"start":53.74,"end":55.64,"text":"три есть, когда ты просишь конфетки, нам женщина"},{"start":55.64,"end":56.96,"text":"просто дала сахар."}],"verification":{"independent_review":false,"word_agreement":0.991,"needs_chunk_review":false}}
