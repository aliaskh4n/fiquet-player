{"version":1,"track_id":71,"audio_sha256":"b381aff53af225c3a81bb376c0624f407cf6c2e2f2f337118b28261b30a95acd","duration":19.42,"language":"russian","status":"ready","lines":[{"start":0,"end":4.7,"text":"Я хотела себя попробовать в дизайне и сделала"},{"start":4.7,"end":8.36,"text":"вот это. Почему в инверсе так ужасно выглядит?"},{"start":9.0,"end":9.56,"text":"Типа вот такое."},{"start":10.16,"end":11.9,"text":"Я бы это носила, но я забыла учесть,"},{"start":12.16,"end":14.44,"text":"что должны быть рукава, а рукавов нету."},{"start":14.46,"end":16.0,"text":"Я не знаю, что делать мне с рукавами."},{"start":18.14,"end":18.76,"text":"Вообще, капец."}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
