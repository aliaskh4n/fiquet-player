{"version":1,"track_id":76,"audio_sha256":"03a3fac287c152091896ef3cd9bd2fcd3cfa9f83d2bb517e1129f7eedbc52390","duration":89.78,"language":"russian","status":"ready","lines":[{"start":0,"end":2.4,"text":"Вы часто мне пишите, что засыпаете под моим"},{"start":3.84,"end":4.86,"text":"кавером, а вот я вам свою, потому что"},{"start":4.86,"end":6.9,"text":"я засыпала, мне бабушка пела, когда я была"},{"start":6.9,"end":8.44,"text":"маленькая. Песня «Ночь светла»."},{"start":8.44,"end":9.6,"text":"Старенькая песня очень."},{"start":10.46,"end":13.78,"text":"Ночь светла, над рекой"},{"start":14.96,"end":25.44,"text":"ярко светит луна, и блестит серебро голубая волна."},{"start":25.44,"end":34.1,"text":"Темный лес стал тише, и в зарубе хребет"},{"start":34.1,"end":41.6,"text":"звонких песен своих не поет соловей."},{"start":41.6,"end":49.38,"text":"Под луной расцвели голубые цветы,"},{"start":50.46,"end":57.28,"text":"они в сердце мое пробуждают мечты."},{"start":57.98,"end":61.56,"text":"К тебе в грезах лечу,"},{"start":62.34,"end":65.64,"text":"твое имя шепчу."},{"start":65.64,"end":72.0,"text":"В эту ночь о тебе не друг все"},{"start":74.66,"end":77.14,"text":"прощен, не друг нежный друг."},{"start":77.72,"end":83.78,"text":"Я, как прежде, любя, в эту ночь при"},{"start":86.2,"end":88.52,"text":"луне вспоминаю тебя."}],"verification":{"independent_review":true,"word_agreement":0.77,"review_model":"gpt-4o-transcribe","unanchored_words":23,"needs_chunk_review":false}}
