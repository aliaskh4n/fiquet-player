{"version":1,"track_id":407,"audio_sha256":"9155596ce453bdfd8a257321d27e5f7ac44e4070df81dd8b2839581cbf5339d9","duration":59.67,"language":"russian","status":"ready","lines":[{"start":0,"end":1.88,"text":"Меня никто не просил, но давайте обзор на"},{"start":1.88,"end":3.2,"text":"все мои очки, которые есть."},{"start":3.3,"end":4.9,"text":"Первые, самые первые, которые я заказала."},{"start":5.54,"end":7.36,"text":"Они вот такие вот."},{"start":7.54,"end":9.7,"text":"Я не знаю, куда их вообще носить, но,"},{"start":10.1,"end":12.06,"text":"по-моему, вот на концерты какие-то, да, вот, чтобы"},{"start":12.06,"end":13.16,"text":"тусы, тусы, тусы."},{"start":13.16,"end":14.86,"text":"Розовые очки, в буквальном смысле."},{"start":16.5,"end":17.2,"text":"Вот такие первые."},{"start":18.5,"end":20.8,"text":"Вторые я купила тоже, у меня был какой-то,"},{"start":21.9,"end":23.7,"text":"не знаю, какая-то тяга к разноцветным очкам."},{"start":24.16,"end":26.56,"text":"Вот такие, я их носила прошлым летом постоянно."},{"start":28.72,"end":31.4,"text":"Кстати, в зеленом я очень красиво даже выгляжу."},{"start":32.58,"end":33.24,"text":"Окей."},{"start":34.38,"end":34.62,"text":"Вот."},{"start":35.82,"end":36.16,"text":"Потом."},{"start":37.76,"end":39.87,"text":"Самые мои любимые, ненаглядные, но..."},{"start":40.44,"end":42.0,"text":"Я не уверена, мне кажется, они немножко делают"},{"start":42.0,"end":43.76,"text":"мое лицо детским таким."},{"start":44.9,"end":45.22,"text":"Вот такое."},{"start":48.64,"end":49.38,"text":"Фифти на фифти."},{"start":50.12,"end":52.84,"text":"И я сошила такие с кинотеатра, черные."},{"start":56.86,"end":57.26,"text":"Йоу."},{"start":58.44,"end":59.36,"text":"И теперь вот эти."}],"verification":{"independent_review":false,"word_agreement":0.966,"needs_chunk_review":false}}
