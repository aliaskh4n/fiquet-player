{"version":1,"track_id":801,"audio_sha256":"07b58dfcb674f7f81724923db248810fee0d72e195cb3b60905805e252886bf6","duration":21.77,"language":"russian","status":"ready","lines":[{"start":0,"end":3.02,"text":"Я, кстати, не знаю, вот я сейчас проведу"},{"start":3.02,"end":4.64,"text":"опрос, потому что это важно."},{"start":4.86,"end":7.04,"text":"Я заметила, у всех вообще разный ритм канала,"},{"start":7.18,"end":9.1,"text":"то есть я тогда загружаю постоянно, каждый день"},{"start":9.56,"end":12.34,"text":"какую-то инфу, а некоторые, типа, загружают раз в"},{"start":12.34,"end":14.86,"text":"неделю и тоже, ну, вам комфортно, я не"},{"start":14.86,"end":17.42,"text":"слишком вас гуляю информацией."},{"start":17.54,"end":18.82,"text":"Ну просто у меня много в жизни происходит"},{"start":18.82,"end":19.16,"text":"пока,"},{"start":20.16,"end":21.2,"text":"поэтому скидываю."}],"verification":{"independent_review":false,"word_agreement":0.983,"needs_chunk_review":false}}
