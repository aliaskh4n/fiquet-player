{"version":1,"track_id":951,"audio_sha256":"c79f1d7dfa401d3dc48a355f315969ca374f8ced7aeb9160ebdcb2d284d15c74","duration":58.95,"language":"russian","status":"ready","lines":[{"start":0,"end":2.14,"text":"Так, это быстрый разбор, потому что, по-моему, кто-то..."},{"start":3.26,"end":4.54,"text":"кто-то просил бы, помню."},{"start":5.98,"end":8.3,"text":"Так, давай вот так вот."},{"start":8.46,"end":10.7,"text":"Капа на третье, аккорды G,"},{"start":11.62,"end":14.24,"text":"затем D, затем E, затем C."},{"start":15.28,"end":20.74,"text":"Зажимаем G, дёргаем шестую, затем вниз-вверх-вверх-вниз, то"},{"start":20.74,"end":21.46,"text":"есть дважды."},{"start":25.08,"end":30.1,"text":"Затем дажемаем D, дёргаем пятую, вниз-вверх-вверх-вниз, пята,"},{"start":32.1,"end":33.62,"text":"вниз-вверх-вверх-вниз. Затем E, опять дёргаю пятую."},{"start":35.58,"end":35.96,"text":"Вниз-вверх-вверх-вниз пята, вниз-вверх-вверх-вниз."},{"start":37.6,"end":39.6,"text":"Затем C. И опять пята, пятая, вниз-вверх-вверх-вниз."}],"verification":{"independent_review":false,"word_agreement":0.85,"needs_chunk_review":false}}
