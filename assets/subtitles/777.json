{"version":1,"track_id":777,"audio_sha256":"581a507477b76b7c99dd7139c8c70c79f92d38be3f4ecc3f443d76b369d8f5f4","duration":13.87,"language":"russian","status":"ready","lines":[{"start":0,"end":2.6,"text":"Ребята, смотрите, что мне подписчик скинул."},{"start":3.22,"end":4.16,"text":"Это так трогательно."},{"start":5.0,"end":6.0,"text":"Я буквально сейчас заплачу."},{"start":6.2,"end":8.1,"text":"Для меня, во-первых, это видео, первое, очень многое"},{"start":8.1,"end":9.46,"text":"значит. Это то, что так склеили."},{"start":10.76,"end":11.86,"text":"Ну вот, просто решили поделиться."},{"start":12.56,"end":13.6,"text":"Сейчас, кстати, разбор запишу."}],"verification":{"independent_review":false,"word_agreement":0.972,"needs_chunk_review":false}}
