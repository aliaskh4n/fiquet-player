{"version":3,"track_id":160,"audio_sha256":"1cd44fb2a354ad82d27e6b02b4136c1d7cb6d066e476832dc4cc4f80cb5c00bf","duration":92.74000000000001,"origin":"original_lyrics","status":"ready","lines":[{"start":1.4,"end":5.13,"text":"Хлопья летят наверх","source_line":20},{"start":5.13,"end":8.479999542236328,"text":"Всюду магия и свет","source_line":21},{"start":8.86,"end":12.86,"text":"Ты чё тут одна? Привет","source_line":22},{"start":12.86,"end":16.77,"text":"Пойдём на парад планет","source_line":23},{"start":16.77,"end":20.49,"text":"Я дам тебе тёплый шарф","source_line":24},{"start":20.76,"end":24.29,"text":"Там в космосе холода","source_line":25},{"start":24.29,"end":28.13,"text":"И мы встречаем рассвет","source_line":26},{"start":28.31,"end":33.36000061035156,"text":"Укутавшись в облака","source_line":27},{"start":37.28,"end":54.01,"text":"Новая эра любви, новая жизнь. Выбери ты","source_line":28},{"start":54.01,"end":59.56,"text":"Что-то родное до боли, но мы не знакомы","source_line":29},{"start":59.56,"end":64.07,"text":"Хочу целовать тебя снова и снова","source_line":30},{"start":64.07,"end":71.35,"text":"Эти уютные дни. Падают хлопья, и с ними мы","source_line":31},{"start":72.02,"end":75.83,"text":"Медленно тают, как наш поцелуй","source_line":32},{"start":75.83,"end":80.37999725341797,"text":"Медленно тают все наши мечты","source_line":33},{"start":82.05,"end":87.27,"text":"Хлопья летят наверх","source_line":35}],"verification":{"source_text_checked":true,"word_agreement":0.836,"matched_words":61,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.41},"song":"FEDUK","artist":"Хлопья летят наверх","source_url":"https://lrclib.net/api/get/14645313","source_sha256":"200e55a1b6fcfed21247f3c4ff0424312ddef0e91564d42ced7844b6928e5cc8"}
