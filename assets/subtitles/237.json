{"version":2,"track_id":237,"audio_sha256":"0b3ce0459c33c43ac41e0b754a4dbf5bbddf2c8e7c8112b617011bf99163a51b","duration":127.02,"origin":"original_lyrics","status":"ready","lines":[{"start":12.5,"end":14.78,"text":"Падал мокрый снег","source_line":0},{"start":14.82,"end":18.24,"text":"Между тем и новостей","source_line":1},{"start":18.72,"end":21.76,"text":"А я отдала тебе","source_line":2},{"start":21.76,"end":23.24,"text":"Свое сердце","source_line":3},{"start":23.24,"end":25.56,"text":"Среди серых стен","source_line":4},{"start":26.08,"end":28.08,"text":"А ты наискосок","source_line":5},{"start":28.08,"end":31.92,"text":"Свои чувства - на замок","source_line":6},{"start":32.44,"end":34.96,"text":"А хотелось как у всех","source_line":7},{"start":39.62,"end":40.32,"text":"Снег","source_line":11},{"start":40.32,"end":43.58,"text":"У тебя нет пути назад","source_line":12},{"start":44.84,"end":47.18,"text":"Растает все, что ты сказал","source_line":13},{"start":47.18,"end":50.14,"text":"Меня кусают слезы","source_line":14},{"start":50.14,"end":53.94,"text":"Я приду сегодня поздно","source_line":15},{"start":53.94,"end":57.78,"text":"Но пока рука в моей руке","source_line":16},{"start":57.78,"end":61.64,"text":"Ты назовешь меня никем","source_line":17},{"start":64.76,"end":65.32,"text":"Долго","source_line":19},{"start":68.24,"end":68.56,"text":"Снег","source_line":21},{"start":68.56,"end":70.2,"text":"В мои глаза","source_line":22},{"start":70.2,"end":73.88,"text":"Не могу, хочу назад","source_line":23},{"start":73.88,"end":77.4,"text":"Пальцы тянутся в ночи","source_line":24},{"start":77.4,"end":79.2,"text":"Город плачет","source_line":25},{"start":80.04,"end":82.22,"text":"Город дышит и молчит","source_line":26},{"start":82.22,"end":83.4,"text":"Наедине","source_line":27},{"start":83.94,"end":87.72,"text":"Слышу мысли обо мне","source_line":28},{"start":89.18,"end":91.08,"text":"А хотелось как у всех","source_line":29},{"start":95.94,"end":96.54,"text":"Снег,","source_line":33},{"start":96.54,"end":99.76,"text":"У тебя нет пути назад","source_line":34},{"start":101.12,"end":103.54,"text":"Растает все, что ты сказал","source_line":35},{"start":103.54,"end":106.72,"text":"Меня кусают слезы,","source_line":36},{"start":106.72,"end":110.18,"text":"Я приду сегодня поздно","source_line":37},{"start":110.18,"end":114.32,"text":"Но пока рука в моей руке","source_line":38},{"start":114.32,"end":117.74,"text":"Ты назовешь меня никем","source_line":39},{"start":118.1,"end":121.2,"text":"Зачем скучаю очень","source_line":40},{"start":121.2,"end":121.86,"text":"Долго","source_line":41}],"verification":{"source_text_checked":true,"word_agreement":0.783,"matched_words":112,"timing":"cached_word_anchors"},"song":"Снег","artist":"fiquet","source_url":"https://lrclib.net/api/get/34250048","source_sha256":"a8174df8ab573c143ad669ed21961209599afde2de10c77e6c1e1a62d089f9e8"}
