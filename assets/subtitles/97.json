{"version":1,"track_id":97,"audio_sha256":"c821babd2929d295ecc4c0af8ab8fb34cf1c019f83c520a782d094bf0a9167d9","duration":66.34,"language":"russian","status":"ready","lines":[{"start":0,"end":1.42,"text":"Так, всё."},{"start":30.36,"end":33.88,"text":"Порванные струны мне ведь руки поздно ночью, А"},{"start":33.88,"end":36.62,"text":"я так пью гитару, что не выдержит, а"},{"start":36.62,"end":39.44,"text":"точно. Ты же знаешь, я тебя люблю, но"},{"start":39.44,"end":43.42,"text":"ненарочно. И мне так сложно, любить тебя так"},{"start":43.42,"end":47.74,"text":"сложно. Её всё напрочитано, бери живую ножу, И"},{"start":47.74,"end":50.74,"text":"будешь напрочитанным долго, как только можно."},{"start":56.2,"end":56.6,"text":"На-на-на-на-на-на-на-на-на-на-на-на. Ти-ти-ни-ни-ни, любить"},{"start":56.6,"end":57.52,"text":"тебя так сложно."},{"start":64.88,"end":66.28,"text":"Редактор субтитров А.Сёмкин"}],"verification":{"independent_review":false,"word_agreement":0.947,"needs_chunk_review":false}}
