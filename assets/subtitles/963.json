{"version":1,"track_id":963,"audio_sha256":"95fd5ebb96d37341bdd10fd49a0db6b9a4585ff063ee237eb2a9499fef695ece","duration":31.75,"language":"russian","status":"ready","lines":[{"start":0,"end":2.14,"text":"Итак, хотела бы у всех спросить очень важную,"},{"start":2.32,"end":3.86,"text":"интересующую меня вещь."},{"start":4.04,"end":5.96,"text":"На 100 000 подписчиков…"},{"start":5.96,"end":6.52,"text":"Блин, я так…"},{"start":6.52,"end":9.2,"text":"Ну короче, ладно, ещё не наступило, поэтому радоваться"},{"start":9.2,"end":9.98,"text":"буду, когда будет."},{"start":10.2,"end":10.7,"text":"Короче, не суть."},{"start":11.42,"end":13.66,"text":"Я, скорее всего, сделаю какой-то конкурс, и, возможно,"},{"start":13.78,"end":15.1,"text":"отправлю победителю посылочку,"},{"start":15.96,"end":17.72,"text":"вот соберу лично, что вы хотели в ней"},{"start":17.72,"end":19.84,"text":"увидеть. Допустим, вы победитель, да?"},{"start":19.84,"end":21.5,"text":"Что бы вы хотели увидеть в этой посылке"},{"start":21.5,"end":21.86,"text":"от меня?"},{"start":23.46,"end":27.62,"text":"Там, может, открыточку, может, не знаю, сладости с"},{"start":27.62,"end":29.96,"text":"Англии, тут вкусные сладости есть, вот."},{"start":30.08,"end":31.12,"text":"Напишите свои идеи, пожалуйста."}],"verification":{"independent_review":false,"word_agreement":0.988,"needs_chunk_review":false}}
