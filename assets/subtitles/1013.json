{"version":1,"track_id":1013,"audio_sha256":"8dc4d6d96411caaf44a588d8b5dae02bca0d295539487adde3bf5815fc38910e","duration":22.84,"language":"russian","status":"ready","lines":[{"start":0,"end":1.14,"text":"Короче, мне дико грустно."},{"start":1.26,"end":3.72,"text":"Я сейчас эту песню..."},{"start":10.92,"end":12.68,"text":"Короче, я её одела просто так, что у"},{"start":12.68,"end":14.34,"text":"меня «кх» вот это звучало, как будто я"},{"start":14.34,"end":16.2,"text":"нейтив казахский спикер, как будто я на казахском"},{"start":16.2,"end":18.44,"text":"так говорю, что просто всем вот так вот."},{"start":19.1,"end":22.42,"text":"Я сделала просто идеально и попутала аккорды!"}],"verification":{"independent_review":false,"word_agreement":1.0,"needs_chunk_review":false}}
