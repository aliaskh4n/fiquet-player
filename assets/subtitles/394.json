{"version":1,"track_id":394,"audio_sha256":"e70b671f56fecbdb9468f81de71795155a26d34fffacfedeb2c74d55d36f9e74","duration":39.82,"language":"russian","status":"ready","lines":[{"start":0,"end":2.86,"text":"Давайте рум-тур такой небольшой."},{"start":3.9,"end":6.04,"text":"Вот я разобралась, как я включила."},{"start":6.44,"end":7.98,"text":"Окна тоже разобралась, как закрыла."},{"start":8.82,"end":10.84,"text":"Там мои сокучники сидят."},{"start":11.6,"end":13.56,"text":"Вот мой стол рабочий."},{"start":15.5,"end":17.32,"text":"Гитарка, моя кровать такая."},{"start":17.68,"end":19.1,"text":"Вот тут, я не знаю, можно ли мне"},{"start":19.1,"end":19.88,"text":"показывать её вещи."},{"start":20.46,"end":23.24,"text":"Но вот тут кровать моей соседки получается."},{"start":23.34,"end":24.9,"text":"И там на видео можно услышать, как она"},{"start":24.9,"end":26.14,"text":"чихает и так далее."},{"start":27.18,"end":29.62,"text":"Она очень милая, она не просит того, что"},{"start":29.62,"end":30.14,"text":"я записываю."},{"start":33.22,"end":34.62,"text":"Вроде всё хорошо."},{"start":36.08,"end":37.84,"text":"Только вот это вот что."}],"verification":{"independent_review":false,"word_agreement":0.987,"needs_chunk_review":false}}
