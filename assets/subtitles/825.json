{"version":2,"track_id":825,"audio_sha256":"d2507a28985c0aebf8432aa68c5d6e61b023cd42492b1a8bb884377150bea310","duration":47.8,"origin":"original_lyrics","status":"ready","lines":[{"start":0.0,"end":2.58,"text":"Моя нежная шея не любит верёвки","source_line":0},{"start":2.62,"end":4.2,"text":"Поэтому знаю, что выйду в окно","source_line":1},{"start":9.86,"end":11.82,"text":"И кто-то расскажет тебе о любви","source_line":5},{"start":14.64,"end":16.88,"text":"Я плакала кровью, твоими словами","source_line":8},{"start":16.88,"end":18.72,"text":"Когда станет жалко — захочешь поближе","source_line":9},{"start":20.64,"end":23.1,"text":"Я всё равно слишком тебя ненавижу","source_line":11},{"start":24.28,"end":26.26,"text":"Я всё равно слишком тебя ненавижу","source_line":12},{"start":28.22,"end":29.34,"text":"Я всё равно слишком","source_line":15},{"start":31.02,"end":31.92,"text":"Забей, это всего лишь эмоции","source_line":16},{"start":32.12,"end":33.48,"text":"Это бессмысленный максимализм","source_line":17},{"start":33.48,"end":34.84,"text":"Я точно не знаю проблемы серьёзнее","source_line":18},{"start":35.46,"end":36.96,"text":"Чем когда мой Инстаграмчик завис","source_line":19},{"start":36.96,"end":38.9,"text":"Ты не знаешь меня, я другая, я хуже","source_line":20},{"start":39.28,"end":40.28,"text":"И зря в мою детскую душу полез","source_line":21}],"verification":{"source_text_checked":true,"word_agreement":0.681,"matched_words":81,"timing":"cached_word_anchors"},"song":"Ветер пахнет цветами","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/18329342","source_sha256":"7f070095a4dbd09027c59ed16ba958c7e6c069379c572183d9476f6abe455716"}
