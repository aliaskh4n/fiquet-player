{"version":2,"track_id":93,"audio_sha256":"a2e0d75f75a668ef330122bd5637cfc8802b9215cf6a51c9bd1bf49f63ac7808","duration":60.97,"origin":"original_lyrics","status":"ready","lines":[{"start":0.58,"end":1.88,"text":"Моя нежная шея не любит верёвки","source_line":0},{"start":1.9,"end":3.68,"text":"Поэтому знаю, что выйду в окно","source_line":1},{"start":14.78,"end":17.12,"text":"Я плакала кровью, твоими словами","source_line":8},{"start":20.96,"end":23.7,"text":"Я всё равно слишком тебя ненавижу","source_line":11},{"start":24.6,"end":26.7,"text":"Я всё равно слишком тебя ненавижу","source_line":12},{"start":28.62,"end":29.82,"text":"Я всё равно слишком","source_line":15},{"start":31.48,"end":32.76,"text":"Забей, это всего лишь эмоции","source_line":16},{"start":32.78,"end":34.42,"text":"Это бессмысленный максимализм","source_line":17},{"start":34.42,"end":35.8,"text":"Я точно не знаю проблемы серьёзнее","source_line":18},{"start":36.6,"end":38.02,"text":"Чем когда мой Инстаграмчик завис","source_line":19},{"start":38.02,"end":40.08,"text":"Ты не знаешь меня, я другая, я хуже","source_line":20},{"start":40.08,"end":41.82,"text":"И зря в мою детскую душу полез","source_line":21},{"start":42.62,"end":43.96,"text":"Да, я пою эти милые песенки","source_line":22},{"start":44.0,"end":45.34,"text":"Их полюбил даже внутренний бес","source_line":23}],"verification":{"source_text_checked":true,"word_agreement":0.775,"matched_words":79,"timing":"cached_word_anchors"},"song":"Ветер пахнет цветами","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/18329342","source_sha256":"7f070095a4dbd09027c59ed16ba958c7e6c069379c572183d9476f6abe455716"}
