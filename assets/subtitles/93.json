{"version":3,"track_id":93,"audio_sha256":"a2e0d75f75a668ef330122bd5637cfc8802b9215cf6a51c9bd1bf49f63ac7808","duration":60.97,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":1.8,"text":"Моя нежная шея не любит верёвки","source_line":0},{"start":1.8,"end":3.7,"text":"Поэтому знаю, что выйду в окно","source_line":1},{"start":3.7,"end":5.56,"text":"Поверхность изнеженных воздухом лёгких","source_line":2},{"start":5.56,"end":7.4,"text":"Шипами цветов прорастает давно","source_line":3},{"start":7.4,"end":9.48,"text":"Пусть радуга в небе раскинет все краски","source_line":4},{"start":9.48,"end":12.539999961853027,"text":"И кто-то расскажет тебе о любви","source_line":5},{"start":12.59,"end":14.73,"text":"Мне шепчет погода: \"Умри\"","source_line":7},{"start":14.73,"end":17.08,"text":"Я плакала кровью, твоими словами","source_line":8},{"start":17.08,"end":18.98,"text":"Когда станет жалко — захочешь поближе","source_line":9},{"start":18.98,"end":20.88,"text":"Хоть спейся и сдохни в соседней канаве","source_line":10},{"start":20.88,"end":22.88,"text":"Я всё равно слишком тебя ненавижу","source_line":11},{"start":22.88,"end":24.9,"text":"Я всё равно слишком тебя ненавижу","source_line":12},{"start":24.9,"end":26.68,"text":"Я всё равно слишком тебя ненавижу","source_line":13},{"start":26.68,"end":28.54,"text":"Хоть спейся и сдохни в соседней канаве","source_line":14},{"start":28.54,"end":29.91,"text":"Я всё равно слишком","source_line":15},{"start":30.18,"end":32.7,"text":"Забей, это всего лишь эмоции","source_line":16},{"start":32.7,"end":34.37,"text":"Это бессмысленный максимализм","source_line":17},{"start":34.37,"end":36.32,"text":"Я точно не знаю проблемы серьёзнее","source_line":18},{"start":36.32,"end":37.94,"text":"Чем когда мой Инстаграмчик завис","source_line":19},{"start":37.94,"end":40.04,"text":"Ты не знаешь меня, я другая, я хуже","source_line":20},{"start":40.04,"end":41.93,"text":"И зря в мою детскую душу полез","source_line":21},{"start":42.04,"end":43.94,"text":"Да, я пою эти милые песенки","source_line":22},{"start":43.94,"end":60.89,"text":"Их полюбил даже внутренний бес","source_line":23}],"verification":{"source_text_checked":true,"word_agreement":0.775,"matched_words":79,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.492},"song":"Ветер пахнет цветами","artist":"алёна швец.","source_url":"https://lrclib.net/api/get/18329342","source_sha256":"7f070095a4dbd09027c59ed16ba958c7e6c069379c572183d9476f6abe455716"}
