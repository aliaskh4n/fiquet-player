{"version":3,"track_id":720,"audio_sha256":"f8a6a64f59153fbf9415b795feb99aeca09530e6dbc8c1c9622f361f8a245222","duration":62.43,"origin":"original_lyrics","status":"ready","lines":[{"start":0,"end":4.02,"text":"Её утро, как обычно - в 22 часа","source_line":5},{"start":4.02,"end":7.940000057220459,"text":"Запрыгнуть в лабутены и успеть накраситься","source_line":6},{"start":8.3,"end":11.63,"text":"И закрыв глаза, улыбается","source_line":7},{"start":11.63,"end":15.71,"text":"Она живёт, как-будто каждый вечер - пятница","source_line":8},{"start":15.71,"end":19.95,"text":"Одной улыбкой разбивает сердце, но она","source_line":9},{"start":19.95,"end":24.079999923706055,"text":"Просто любит засыпать и танцевать одна","source_line":10},{"start":24.4,"end":27.61,"text":"И закрыв глаза, улыбается","source_line":11},{"start":27.61,"end":31.62,"text":"Все смотрят на неё, и ей это нравится","source_line":12},{"start":31.62,"end":35.51,"text":"Она сумасшедшая, но она моя -","source_line":13},{"start":35.51,"end":40.18,"text":"Танцует до утра, поёт: ша-ла-ла-ла-ла","source_line":14},{"start":40.18,"end":43.92,"text":"Сумасшедшая, но она моя -","source_line":15},{"start":43.92,"end":49.47,"text":"Танцует до утра; поёт: ша-ла-ла-ла-ла","source_line":16},{"start":52.9,"end":61.69,"text":"Ша-ла-ла-ла! Ша-ла-ла-ла!","source_line":17}],"verification":{"source_text_checked":true,"word_agreement":0.81,"matched_words":64,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.282},"song":"#Сумасшедшая","artist":"Алексей Воробьёв","source_url":"https://lrclib.net/api/get/4937987","source_sha256":"85b190914d9d2070362ba31a1b019796b5b072543a2fe653951b0bf819ed90f3"}
