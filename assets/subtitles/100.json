{"version":3,"track_id":100,"audio_sha256":"e97c64c1619cac3753827a216f567c9afe55fff7d63cc6ac6ae8f8f2e7d81d2f","duration":68.5,"origin":"original_lyrics","status":"ready","lines":[{"start":9.9,"end":11.59,"text":"Мы рисовали в подъезде","source_line":27},{"start":11.68,"end":13.56,"text":"То ли пентаграмму, то ли твою маму","source_line":28},{"start":13.56,"end":14.74,"text":"Что это за черный тип","source_line":29},{"start":14.74,"end":15.66,"text":"Рядом с тобой, чувак?","source_line":30},{"start":15.66,"end":18.11,"text":"Мэнчик, не парься - это Барак Обама","source_line":31},{"start":18.66,"end":23.68,"text":"Где мои деньги?! Где мои деньги","source_line":39},{"start":23.68,"end":26.55,"text":"Грёбаный сукин сын Oliver Sykes?!","source_line":40},{"start":26.65,"end":27.83,"text":"Дома закончился крэк","source_line":41},{"start":27.83,"end":29.73,"text":"Я пойду прогуляюсь","source_line":42},{"start":30.54,"end":37.31,"text":"Слышишь, подружка","source_line":52},{"start":40.12,"end":43.32,"text":"Прокатимся может?","source_line":53},{"start":43.32,"end":45.32,"text":"Лада шестерка","source_line":54},{"start":45.32,"end":50.47999954223633,"text":"Кстати, твой парень тоже","source_line":55},{"start":51.38,"end":58.31,"text":"Он такой скучный, просто зануда","source_line":56},{"start":59.23,"end":67.89,"text":"А ты просто чудо, гладкая кожа","source_line":57}],"verification":{"source_text_checked":true,"timing":"acoustic_source_alignment","acoustic_alignment":true,"alignment_model":"MMS-300M forced aligner","alignment_score":0.363},"song":"Ханнамонтана","artist":"Пошлая Молли","source_url":"https://lrclib.net/api/get/34329413","source_sha256":"257e2d36b2f96a557488a817d4c6b8581f49f676c0d269eae135d557609de33d"}
